 190+ 44D6              ; Device information gathering
 191+ 44D6              ;
 192+ 44D6              ;Input:   A = Device index, 1 to 7
 193+ 44D6              ;         B = Information to return:
 194+ 44D6              ;             0: Basic information
 195+ 44D6              ;             1: Manufacturer name string
 196+ 44D6              ;             2: Device name string
 197+ 44D6              ;             3: Serial number string
 198+ 44D6              ;         HL = Pointer to a buffer in RAM
 199+ 44D6              ;Output:  A = Error code:
 200+ 44D6              ;             0: Ok
 201+ 44D6              ;             1: Device not available or invalid device index
 202+ 44D6              ;             2: Information not available, or invalid information index
 203+ 44D6              DEV_INFO_ROMDISK:
 204+ 44D6 78           	ld a, b
 205+ 44D7 FE 00        	cp 0
 206+ 44D9 28 0F        	jr z,_DEV_INFO_ROMDISK_BASIC
 207+ 44DB FE 01        	cp 1
 208+ 44DD 28 12        	jr z,_DEV_INFO_ROMDISK_MANUFACTURER
 209+ 44DF FE 02        	cp 2
 210+ 44E1 28 1B        	jr z,_DEV_INFO_ROMDISK_DEVICE_NAME
 211+ 44E3 FE 03        	cp 3
 212+ 44E5 28 24        	jr z,_DEV_INFO_ROMDISK_SERIAL
 213+ 44E7              	; else
 214+ 44E7 3E 02        	ld a, 2
 215+ 44E9 C9               ret
 216+ 44EA
