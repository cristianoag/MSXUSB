 218+ 44EA 36 01        	ld (hl),1
 219+ 44EC 23           	inc hl
 220+ 44ED 36 00        	ld (hl),0
 221+ 44EF AF           	xor a
 222+ 44F0 C9           	ret
 223+ 44F1
