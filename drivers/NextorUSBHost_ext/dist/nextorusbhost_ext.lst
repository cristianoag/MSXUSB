 405+ 4C28 28 0B            jr  z,NOEXP1
 406+ 4C2A              EXP1:
 407+ 4C2A 23               inc  hl
 408+ 4C2B 23               inc  hl
 409+ 4C2C 23               inc  hl
 410+ 4C2D 23               inc  hl
 411+ 4C2E 7E               ld  a,(hl)
 412+ 4C2F E6 0C            and  00001100b
 413+ 4C31 B1               or  c
 414+ 4C32 F6 80            or  80h
 415+ 4C34 4F               ld  c,a
 416+ 4C35              NOEXP1:
 417+ 4C35 79               ld  a,c
 418+ 4C36 E1 D1 C1         pop hl,de,bc
 419+ 4C39 C9               ret
