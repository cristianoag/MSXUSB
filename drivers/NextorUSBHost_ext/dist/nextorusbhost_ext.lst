  22+ 4412 E5               push hl ; + points to FLASH_READ
  23+ 4413 EB               ex de, hl
  24+ 4414 21 58 44         ld hl, FLASH_READ_START
  25+ 4417 01 14 00         ld bc, FLASH_READ_END-FLASH_READ_START
  26+ 441A ED B0            ldir
  27+ 441C                  ; check contents of flash sector 0
  28+ 441C 11 00 C0         ld de, 0c000h
  29+ 441F 21 00 40         ld hl, 4000h
  30+ 4422 01 02 00         ld bc, 2
  31+ 4425 3A FF 40         ld a, (CUR_BANK)
  32+ 4428 08               ex af,af'
  33+ 4429 3E 08            ld a, DISK_START_BANK
  34+ 442B DD E1            pop ix ; - points to FLASH_READ
  35+ 442D FD 21 36 44      ld iy, _FLASH_INIT_NEXT
  36+ 4431 FD E5            push iy ; return address
  37+ 4433 F3               di
  38+ 4434 DD E9            jp (ix)
  39+ 4436                  ; update status in WRKAREA to indicate IF we have flash disk
  40+ 4436              _FLASH_INIT_NEXT:
  41+ 4436 FB               ei
  42+ 4437 DD E1        	pop ix
  43+ 4439              	; starting with EBh FEh?
  44+ 4439 3A 00 C0         ld a, (0c000h)
  45+ 443C FE EB        	cp 0EBh
  46+ 443E 20 16        	jr nz,_FLASH_INIT_NOK
  47+ 4440 3A 01 C0         ld a, (0c001h)
  48+ 4443 FE FE        	cp 0FEh
  49+ 4445 20 0F        	jr nz,_FLASH_INIT_NOK
  50+ 4447              _FLASH_INIT_OK:
  51+ 4447 DD 7E 00         ld a,(ix+WRKAREA.STATUS)
  52+ 444A CB FF            set 7,a
  53+ 444C DD 77 00         ld (ix+WRKAREA.STATUS),a
  54+ 444F 21 85 46         ld hl, TXT_FLASHDISK_OK
  55+ 4452 CD 13 47         call PRINT
  56+ 4455 C9               ret
  57+ 4456              _FLASH_INIT_NOK:
