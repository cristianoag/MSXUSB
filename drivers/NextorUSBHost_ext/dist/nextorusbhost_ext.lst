 107+ 50A1 23               inc  hl
 108+ 50A2 23               inc  hl
 109+ 50A3 23               inc  hl
 110+ 50A4 23               inc  hl
 111+ 50A5 7E               ld  a,(hl)
 112+ 50A6 E6 0C            and  00001100b
 113+ 50A8 B1               or  c
 114+ 50A9 F6 80            or  80h
 115+ 50AB 4F               ld  c,a
 116+ 50AC              _NOEXP1_:
 117+ 50AC 79               ld  a,c
 118+ 50AD E1 D1 C1         pop hl,de,bc
