 923+ 48D2              ; -----------------------------------------------------------------------------
 924+ 48D2              ; HW_DATA_IN_TRANSFER: Perform a USB data IN transfer
 925+ 48D2              ; -----------------------------------------------------------------------------
 926+ 48D2              ; Input:  HL = Address of a buffer for the received data
 927+ 48D2              ;         BC = Data length
 928+ 48D2              ;         A  = Device address
 929+ 48D2              ;         D  = Maximum packet size for the endpoint
 930+ 48D2              ;         E  = Endpoint number
 931+ 48D2              ;         Cy = Current state of the toggle bit
 932+ 48D2              ; Output: A  = USB error code or success when all okay
 933+ 48D2              ;         BC = Amount of data actually received (only if no error)
 934+ 48D2              ;         Cy = New state of the toggle bit (even on error)
 935+ 48D2
 936+ 48D2              HW_DATA_IN_TRANSFER:
 937+ 48D2 CD B6 48         call CH_SET_TARGET_DEVICE_ADDRESS
 938+ 48D5
 939+ 48D5              ; This entry point is used when target device address is already set
 940+ 48D5              CH_DATA_IN_TRANSFER:
 941+ 48D5 3E 00            ld a,0  ;No XOR because that would damage flags
 942+ 48D7 1F               rra     ;Toggle to bit 7 of A
 943+ 48D8 DD 21 00 00      ld ix,0 ;IX = Received so far count
 944+ 48DC D5               push de
 945+ 48DD FD E1            pop iy  ;IY = EP max size + EP number
 946+ 48DF
 947+ 48DF              _CH_DATA_IN_LOOP:
 948+ 48DF F5               push af ;Toggle in bit 7
 949+ 48E0 C5               push bc ;Remaining length
 950+ 48E1
 951+ 48E1 FD 5D            ld e,iyl
 952+ 48E3 06 09            ld b,CH_PID_IN
 953+ 48E5 CD BF 48         call CH_ISSUE_TOKEN
 954+ 48E8
 955+ 48E8 CD F2 47         call CH_WAIT_INT_AND_GET_RESULT
 956+ 48EB FE 14            cp CH_USB_INT_SUCCESS
 957+ 48ED 20 27            jr nz,_CH_DATA_IN_ERR   ;DONE if error
 958+ 48EF
 959+ 48EF CD DD 47         call CH_READ_DATA
 960+ 48F2 06 00            ld b,0
 961+ 48F4 DD 09            add ix,bc   ;Update received so far count
 962+ 48F6              _CH_DATA_IN_NO_MORE_DATA:
 963+ 48F6 D1               pop de
 964+ 48F7 F1               pop af
 965+ 48F8 EE 80            xor 80h     ;Update toggle
 966+ 48FA F5               push af
 967+ 48FB D5               push de
 968+ 48FC
 969+ 48FC 79               ld a,c
 970+ 48FD B7               or a
 971+ 48FE 28 12            jr z,_CH_DATA_IN_DONE    ;DONE if no data received
 972+ 4900
 973+ 4900 E3               ex (sp),hl  ;Now HL = Remaining data length
 974+ 4901 B7               or a
 975+ 4902 ED 42            sbc hl,bc   ;Now HL = Updated remaning data length
 976+ 4904 7C               ld a,h
 977+ 4905 B5               or l
 978+ 4906 E3               ex (sp),hl  ;Remaining data length is back on the stack
 979+ 4907 28 09            jr z,_CH_DATA_IN_DONE    ;DONE if no data remaining
 980+ 4909
 981+ 4909 79               ld a,c
 982+ 490A FD BC            cp iyh
 983+ 490C 38 04            jr c,_CH_DATA_IN_DONE    ;DONE if transferred less than the EP size
 984+ 490E
 985+ 490E C1               pop bc
 986+ 490F F1               pop af  ;We need this to pass the next toggle to CH_ISSUE_TOKEN
 987+ 4910
 988+ 4910 18 CD            jr _CH_DATA_IN_LOOP
 989+ 4912
 990+ 4912              ;Input: A=Error code (if ERR), in stack: remaining length, new toggle
 991+ 4912              _CH_DATA_IN_DONE:
 992+ 4912 3E 14            ld a, CH_USB_INT_SUCCESS
 993+ 4914 18 00            jr _CH_DATA_IN_NEXT
 994+ 4916              _CH_DATA_IN_ERR:
 995+ 4916
 996+ 4916              _CH_DATA_IN_NEXT:
 997+ 4916 57               ld d,a
 998+ 4917 C1               pop bc
 999+ 4918 F1               pop af
1000+ 4919 17               rla ;Toggle back to Cy
1001+ 491A 7A               ld a,d
1002+ 491B DD E5            push ix
1003+ 491D C1               pop bc
1004+ 491E C9               ret
1005+ 491F
1006+ 491F              ; -----------------------------------------------------------------------------
1007+ 491F              ; HW_DATA_OUT_TRANSFER: Perform a USB data OUT transfer
1008+ 491F              ; -----------------------------------------------------------------------------
1009+ 491F              ; Input:  HL = Address of a buffer for the data to be sent
1010+ 491F              ;         BC = Data length
1011+ 491F              ;         A  = Device address
1012+ 491F              ;         D  = Maximum packet size for the endpoint
1013+ 491F              ;         E  = Endpoint number
1014+ 491F              ;         Cy = Current state of the toggle bit
1015+ 491F              ; Output: A contains 00h when okay or CH376 error code
1016+ 491F              ;         Cy = New state of the toggle bit (even on error)
1017+ 491F
1018+ 491F              HW_DATA_OUT_TRANSFER:
1019+ 491F CD B6 48         call CH_SET_TARGET_DEVICE_ADDRESS
1020+ 4922
1021+ 4922              ; This entry point is used when target device address is already set
1022+ 4922              CH_DATA_OUT_TRANSFER:
1023+ 4922 F5               push af
1024+ 4923 78               ld a, b
1025+ 4924 B1               or c
1026+ 4925 20 03            jr nz, CH_DATA_OUT_TRANSFER_CHECK_FINISHED
1027+ 4927 F1               pop af
1028+ 4928 AF               xor a
1029+ 4929 C9               ret
1030+ 492A              CH_DATA_OUT_TRANSFER_CHECK_FINISHED:
1031+ 492A F1               pop af
1032+ 492B
1033+ 492B 3E 00            ld a,0  ;No XOR because that would damage flags
1034+ 492D 1F               rra     ;Toggle to bit 6 of A
1035+ 492E 1F               rra
1036+ 492F D5               push de
1037+ 4930 FD E1            pop iy  ;IY = EP size + EP number
1038+ 4932
1039+ 4932              _CH_DATA_OUT_LOOP:
1040+ 4932 F5               push af ;Toggle in bit 6
1041+ 4933 C5               push bc ;Remaining length
1042+ 4934
1043+ 4934 78               ld a,b
1044+ 4935 B7               or a
1045+ 4936 FD 7C            ld a,iyh
1046+ 4938 20 07            jr nz,_CH_DATA_OUT_DO
1047+ 493A 79               ld a,c
1048+ 493B FD BC            cp iyh
1049+ 493D 38 02            jr c,_CH_DATA_OUT_DO
1050+ 493F FD 7C            ld a,iyh
1051+ 4941
1052+ 4941              _CH_DATA_OUT_DO:
1053+ 4941                  ;Here, A = Length of the next transfer: min(remaining length, EP size)
1054+ 4941
1055+ 4941 E3               ex (sp),hl
1056+ 4942 5F               ld e,a
1057+ 4943 16 00            ld d,0
1058+ 4945 B7               or a
1059+ 4946 ED 52            sbc hl,de
1060+ 4948 E3               ex (sp),hl     ;Updated remaining data length to the stack
1061+ 4949
1062+ 4949 47               ld b,a
1063+ 494A CD CF 47         call CH_WRITE_DATA
1064+ 494D
1065+ 494D C1               pop bc
1066+ 494E F1               pop af  ;Retrieve toggle
1067+ 494F F5               push af
1068+ 4950 C5               push bc
1069+ 4951
1070+ 4951 FD 5D            ld e,iyl
1071+ 4953 06 01            ld b,CH_PID_OUT
1072+ 4955 CD BF 48         call CH_ISSUE_TOKEN
1073+ 4958
1074+ 4958 CD F2 47         call CH_WAIT_INT_AND_GET_RESULT
1075+ 495B FE 14            cp CH_USB_INT_SUCCESS
1076+ 495D 20 0C            jr nz,_CH_DATA_OUT_ERROR   ;DONE if error
1077+ 495F
1078+ 495F C1               pop bc
1079+ 4960 F1               pop af
1080+ 4961 EE 40            xor 40h     ;Update toggle
1081+ 4963 F5               push af
1082+ 4964
1083+ 4964 78               ld a,b
1084+ 4965 B1               or c
1085+ 4966 28 04            jr z,_CH_DATA_OUT_DONE  ;DONE if no more data to transfer
1086+ 4968
1087+ 4968 F1               pop af  ;We need this to pass the next toggle to CH_ISSUE_TOKEN
1088+ 4969
1089+ 4969 18 C7            jr _CH_DATA_OUT_LOOP
1090+ 496B
1091+ 496B              ;Input: A=Error code, in stack: remaining length, new toggle
1092+ 496B              _CH_DATA_OUT_ERROR:
1093+ 496B C1               pop bc
1094+ 496C              _CH_DATA_OUT_DONE:
1095+ 496C 57               ld d,a
1096+ 496D F1               pop af
1097+ 496E 17               rla ;Toggle back to Cy
1098+ 496F 17               rla
1099+ 4970 7A               ld a,d ; A contains zero when okay or CH376 error code
1100+ 4971 C9               ret
1101+ 4972
1102+ 4972              ; -----------------------------------------------------------------------------
1103+ 4972              ; HW_CONTROL_TRANSFER: Perform a USB control transfer on endpoint 0
1104+ 4972              ;
1105+ 4972              ; The size and direction of the transfer are taken from the contents
1106+ 4972              ; of the setup packet.
1107+ 4972              ; -----------------------------------------------------------------------------
1108+ 4972              ; Input:  HL = Address of a 8 byte buffer with the setup packet
1109+ 4972              ;         DE = Address of the input or output data buffer
1110+ 4972              ;         A  = Device address
1111+ 4972              ;         B  = Maximum packet size for endpoint 0
1112+ 4972              ; Output: A  = USB error code
1113+ 4972              ;         BC = Amount of data actually transferred (if IN transfer and no error)
1114+ 4972
1115+ 4972              HW_CONTROL_TRANSFER:
1116+ 4972 CD B6 48         call CH_SET_TARGET_DEVICE_ADDRESS
1117+ 4975
1118+ 4975 F5               push af
1119+ 4976 E5               push hl
1120+ 4977 C5               push bc
1121+ 4978 D5               push de
1122+ 4979
1123+ 4979                  ; SETUP STAGE
1124+ 4979                  ; -----------
1125+ 4979 06 08            ld b,8
1126+ 497B CD CF 47         call CH_WRITE_DATA  ;Write SETUP data packet
1127+ 497E
1128+ 497E AF               xor a    ;Toggle bit = 0
1129+ 497F 1E 00            ld e,0
1130+ 4981 06 0D            ld b,CH_PID_SETUP
1131+ 4983 CD BF 48         call CH_ISSUE_TOKEN
1132+ 4986
1133+ 4986 CD F2 47         call CH_WAIT_INT_AND_GET_RESULT
1134+ 4989 FE 14            cp CH_USB_INT_SUCCESS
1135+ 498B C2 1D 4A         jp nz, _HW_CONTROL_TRANSFER_ERROR
1136+ 498E
1137+ 498E E1               pop hl  ;HL = Data address (was DE)
1138+ 498F D1               pop de  ;D  = Endpoint size (was B)
1139+ 4990 DD E1            pop ix  ;IX = Address of setup packet (was HL)
1140+ 4992 F1               pop af  ;A  = Device address
1141+ 4993 DD 4E 06         ld c,(ix+6)
1142+ 4996 DD 46 07         ld b,(ix+7) ;BC = Data length
1143+ 4999 1E 00            ld e,0      ;E  = Endpoint number
1144+ 499B 37               scf         ;Use toggle = 1
1145+ 499C F5               push af ; device address
1146+ 499D D5               push de ; endpoint size in D
1147+ 499E E5               push hl ; data address
1148+ 499F DD E5            push ix ; packet address
1149+ 49A1
1150+ 49A1                  ; check if IN or OUT transaction
1151+ 49A1 DD CB 00 7E      bit 7,(ix)
1152+ 49A5 20 02            jr nz,_CH_CONTROL_DATA_IN_TRANSFER
1153+ 49A7 18 09            jr CH_CONTROL_DATA_OUT_TRANSFER
1154+ 49A9
1155+ 49A9                  ; DATA IN STAGE
1156+ 49A9                  ; -------------
1157+ 49A9              _CH_CONTROL_DATA_IN_TRANSFER:
1158+ 49A9 CD D5 48         call CH_DATA_IN_TRANSFER
1159+ 49AC FE 14            cp CH_USB_INT_SUCCESS
1160+ 49AE 28 34            jr z,_CH_CONTROL_STATUS_TRANSFER
1161+ 49B0 18 06            jr _CH_CONTROL_HANDLE_ERROR
1162+ 49B2
1163+ 49B2                  ; DATA OUT STAGE
1164+ 49B2                  ; -------------
1165+ 49B2              CH_CONTROL_DATA_OUT_TRANSFER:
1166+ 49B2 CD 22 49         call CH_DATA_OUT_TRANSFER
1167+ 49B5                  ; check return code of OUT transfer
1168+ 49B5 A7               and a
1169+ 49B6 28 2C            jr z,_CH_CONTROL_STATUS_TRANSFER
1170+ 49B8
