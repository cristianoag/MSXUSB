 346+ 4BD6              ; FN_JUMP_TABLE: return the configured jumptable in WRKAREA
 347+ 4BD6              ; Input: HL - location where we want to have the jumptable
 348+ 4BD6              ; Output: (none)
 349+ 4BD6              ;
 350+ 4BD6              ; Example jumptable
 351+ 4BD6              ; call NXT_DIRECT ; 3 bytes - call to switching code
 352+ 4BD6              ; DB 1            ; 1 byte  - ROM slot number
 353+ 4BD6              ; DB 7            ; 1 byte  - ROM segment
 354+ 4BD6              ; DW FN_CHECK     ; 2 bytes - address to call
 355+ 4BD6              ; ret             ; 1 byte
 356+ 4BD6              ;                 ; =============
 357+ 4BD6              ;                 ; 8 bytes total per entry
 358+ 4BD6              FN_JUMP_TABLE:
 359+ 4BD6 DD E5 D5 C5      push ix, de, bc, af
 359+ 4BDA F5
 360+ 4BDB E5               push hl ; pointer to jumptable
 361+ 4BDC EB               ex hl,de
 362+ 4BDD 21 46 4A         ld hl, JUMP_TABLE_START
 363+ 4BE0 01 40 00         ld bc, JUMP_TABLE_END-JUMP_TABLE_START
 364+ 4BE3 ED B0            ldir
 365+ 4BE5                  ; get pointer to NXT_DIRECT
 366+ 4BE5 01 9B 01         ld bc, WRKAREA.NXT_DIRECT
 367+ 4BE8 CD 84 42     	call WRKAREAPTR
 368+ 4BEB DD E5 E1         ld hl, ix
 369+ 4BEE DD E1            pop ix ; pointer to jumptable
 370+ 4BF0                  ; get current bank
 371+ 4BF0 3A FF 40         ld a, (CUR_BANK)
 372+ 4BF3 47               ld b, a
 373+ 4BF4                  ; get current slot-id
 374+ 4BF4 CD 13 4C         call GETSLT1
 375+ 4BF7                  ; increment
 376+ 4BF7 0E 08            ld c, NR_JUMP_ENTRIES
 377+ 4BF9 11 08 00         ld de, 8
 378+ 4BFC              _FN_JUMP_TABLE_NEXT_ENTRY:
 379+ 4BFC DD 75 01 DD      ld (ix+JN_0-JUMP_TABLE_START+1),hl
 379+ 4C00 74 02
 380+ 4C02 DD 77 03         ld (ix+JN_0-JUMP_TABLE_START+3),a
 381+ 4C05 DD 70 04         ld (ix+JN_0-JUMP_TABLE_START+4),b
 382+ 4C08 DD 19            add ix, de
 383+ 4C0A 0D               dec c
 384+ 4C0B 20 EF            jr nz, _FN_JUMP_TABLE_NEXT_ENTRY
 385+ 4C0D                  ;
 386+ 4C0D F1 C1 D1 DD      pop af, bc, de, ix
 386+ 4C11 E1
 387+ 4C12 C9               ret
