  61  4100              ;-----------------------------------------------------------------------------
  62  4100              ;
  63  4100              ; Routines and information available on kernel page 0
  64  4100              ;
  65  4100
  66  4100              ;* Get in A the current slot for page 1. Corrupts F.
  67  4100              ;  Must be called by using CALBNK to bank 0:
  68  4100              ;    xor a
  69  4100              ;    ld ix,GSLOT1
  70  4100              ;    call CALBNK
  71  4100              GSLOT1	equ	402Dh
  72  4100
  73  4100
  74  4100              ;* This routine reads a byte from another bank.
  75  4100              ;  Must be called by using CALBNK to the desired bank,
  76  4100              ;  passing the address to be read in HL:
  77  4100              ;    ld a,<bank number>
  78  4100              ;    ld hl,<byte address>
  79  4100              ;    ld ix,RDBANK
  80  4100              ;    call CALBNK
  81  4100              RDBANK	equ	403Ch
  82  4100
  83  4100
  84  4100              ;* This routine temporarily switches kernel main bank
  85  4100              ;  (usually bank 0, but will be 3 when running in MSX-DOS 1 mode),
  86  4100              ;  then invokes the routine whose address is at (CODE_ADD).
  87  4100              ;  It is necessary to use this routine to invoke CALBAS
  88  4100              ;  (so that kernel bank is correct in case of BASIC error)
  89  4100              ;  and to invoke DOS functions via F37Dh hook.
  90  4100              ;
  91  4100              ;  Input:  Address of code to invoke in (CODE_ADD).
  92  4100              ;          AF, BC, DE, HL, IX, IY passed to the called routine.
  93  4100              ;  Output: AF, BC, DE, HL, IX, IY returned from the called routine.
  94  4100              CALLB0	equ	403Fh
  95  4100
  96  4100
  97  4100              ;* Call a routine in another bank.
  98  4100              ;  Must be used if the driver spawns across more than one bank.
  99  4100              ;
 100  4100              ;  Input:  A = bank number
 101  4100              ;          IX = routine address
 102  4100              ;          AF' = AF for the routine
 103  4100              ;          HL' = Ix for the routine
 104  4100              ;          BC, DE, HL, IY = input for the routine
 105  4100              ;  Output: AF, BC, DE, HL, IX, IY returned from the called routine.
 106  4100              CALBNK	equ	4042h
 107  4100
 108  4100              ;* Get in IX the address of the SLTWRK entry for the slot passed in A,
 109  4100              ;  which will in turn contain a pointer to the allocated page 3
 110  4100              ;  work area for that slot (0 if no work area was allocated).
 111  4100              ;  If A=0, then it uses the slot currently switched in page 1.
 112  4100              ;  Returns A=current slot for page 1, if A=0 was passed.
 113  4100              ;  Corrupts F.
 114  4100              ;  Must be called by using CALBNK to bank 0:
 115  4100              ;    ld a,<slot number> (xor a for current page 1 slot)
 116  4100              ;    ex af,af'
 117  4100              ;    xor a
 118  4100              ;    ld ix,GWORK
 119  4100              ;    call CALBNK
 120  4100              GWORK	equ	4045h
 121  4100
 122  4100
 123  4100              ;* This address contains one byte that tells how many banks
 124  4100              ;  form the Nextor kernel (or alternatively, the first bank
 125  4100              ;  number of the driver).
 126  4100              K_SIZE	equ	40FEh
 127  4100
 128  4100
 129  4100              ;* This address contains one byte with the current bank number.
 130  4100              CUR_BANK	equ	40FFh
 131  4100
