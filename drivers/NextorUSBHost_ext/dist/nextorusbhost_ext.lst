 133+ 4AA9 CD 7B 4B     	call HW_GET_DESCRIPTORS
 134+ 4AAC 30 0F        	jr nc, _CONTINUE_DESCRIPTORS
 135+ 4AAE                  ; descriptors not read, return zero to indicate error
