  79+ 5080 F1               pop af
  80+ 5081 CD 24 00         call ENASLT
  81+ 5084 FB               ei
  82+ 5085                  ;
  83+ 5085 D9               exx       ; load registers
  84+ 5086 08               ex af,af' ; load A + Flags
  85+ 5087 33               inc sp ; go back to previous stack entry, saves a RET in the jumptable
  86+ 5088 33               inc sp
  87+ 5089 C9               ret
