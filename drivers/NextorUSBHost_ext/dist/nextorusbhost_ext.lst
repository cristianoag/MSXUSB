 281+ 451D              	; #1
 282+ 451D 23           	inc hl
 283+ 451E 36 00        	ld (hl),00h
 284+ 4520 23           	inc hl
 285+ 4521 36 02        	ld (hl),02h ; 512 byte sector
 286+ 4523              	; #3
 287+ 4523 23           	inc hl
 288+ 4524 36 00        	ld (hl),00h
 289+ 4526 23           	inc hl
 290+ 4527 36 00        	ld (hl),00h
 291+ 4529 23           	inc hl
 292+ 452A 36 00        	ld (hl),00h
 293+ 452C 23           	inc hl
 294+ 452D 36 00        	ld (hl),00h
 295+ 452F              	; #7
 296+ 452F 23           	inc hl
 297+ 4530 36 02        	ld (hl),00000010b ; non-removable + read only + no floppy
 298+ 4532              	; #8
 299+ 4532 23           	inc hl
 300+ 4533 36 00        	ld (hl), 0
 301+ 4535 23           	inc hl
 302+ 4536 36 00        	ld (hl), 0 ; cylinders/tracks
 303+ 4538              	; #10
 304+ 4538 23           	inc hl
 305+ 4539 36 00        	ld (hl), 0 ; heads
 306+ 453B              	; #11
 307+ 453B 23           	inc hl
 308+ 453C 36 00        	ld (hl), 0 ; sectors per track
 309+ 453E
 310+ 453E 3E 00        	ld a, 0
 311+ 4540 C9           	ret
