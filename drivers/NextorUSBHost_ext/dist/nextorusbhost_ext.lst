 172  4130              ;-----------------------------------------------------------------------------
 173  4130              ;
 174  4130              ; Jump table for the driver public routines
 175  4130              ;
 176  4130
 177  4130              	; These routines are mandatory for all drivers
 178  4130                      ; (but probably you need to implement only DRV_INIT)
 179  4130 C3 6C 41     	jp	DRV_TIMI
 180  4133 C3 B8 42     	jp	DRV_VERSION
 181  4136 C3 6D 41     	jp	DRV_INIT
 182  4139 C3 BF 42     	jp	DRV_BASSTAT
 183  413C C3 C1 42     	jp	DRV_BASDEV
 184  413F C3 B8 4F         jp  DO_EXTBIO 	;DRV_EXTBIO
 185  4142 C3 0A 50         jp  UNAPI_ENTRY ;DRV_DIRECT0
 186  4145 C3 C4 42         jp  DRV_DIRECT1
 187  4148 C3 C4 42         jp  DRV_DIRECT2
 188  414B C3 C4 42         jp  DRV_DIRECT3
 189  414E C3 C4 42         jp  DRV_DIRECT4
 190  4151 C3 9B 42     	jp	DRV_CONFIG
 191  4154 00 00 00...  	ds	12
 192  4160
 193  4160              	; These routines are mandatory for device-based drivers
 194  4160 C3 D4 42     	jp	DEV_RW
 195  4163 C3 1D 43     	jp	DEV_INFO
 196  4166 C3 89 43     	jp	DEV_STATUS
 197  4169 C3 C3 43     	jp	LUN_INFO
 198  416C
 199  416C              ;=====
 200  416C              ;=====  END of data that must be at fixed addresses
 201  416C              ;=====
 202  416C
 203  416C              ;-----------------------------------------------------------------------------
 204  416C              ;
 205  416C              ; Timer interrupt routine, it will be called on each timer interrupt
 206  416C              ; (at 50 or 60Hz), but only if DRV_INIT returns Cy=1 on its first execution.
 207  416C
 208  416C              DRV_TIMI:
 209  416C C9           	ret
 210  416D
 211  416D              ;-----------------------------------------------------------------------------
 212  416D              ;
 213  416D              ; Driver initialization routine, it is called twice:
 214  416D              ;
 215  416D              ; 1) First execution, for information gathering.
 216  416D              ;    Input:
 217  416D              ;      A = 0
 218  416D              ;      B = number of available drives
 219  416D              ;      HL = maximum size of allocatable work area in page 3
 220  416D              ;      C: bit 5 set if user is requesting reduced drive count
 221  416D              ;         (by pressing the 5 key)
 222  416D              ;    Output:
 223  416D              ;      A = number of required drives (for drive-based driver only)
 224  416D              ;      HL = size of required work area in page 3
 225  416D              ;      Cy = 1 if DRV_TIMI must be hooked to the timer interrupt, 0 otherwise
 226  416D              ;
 227  416D              ; 2) Second execution, for work area and hardware initialization.
 228  416D              ;    Input:
 229  416D              ;      A = 1
 230  416D              ;      B = number of allocated drives for this controller
 231  416D              ;      C: bit 5 set if user is requesting reduced drive count
 232  416D              ;         (by pressing the 5 key)
 233  416D              ;
 234  416D              ;    The work area address can be obtained by using GWORK.
 235  416D              ;
 236  416D              ;    If first execution requests more work area than available,
 237  416D              ;    second execution will not be done and DRV_TIMI will not be hooked
 238  416D              ;    to the timer interrupt.
 239  416D              ;
 240  416D              ;    If first execution requests more drives than available,
 241  416D              ;    as many drives as possible will be allocated, and the initialization
 242  416D              ;    procedure will continue the normal way
 243  416D              ;    (for drive-based drivers only. Device-based drivers always
 244  416D              ;     get two allocated drives.)
 245  416D
 246  416D              DRV_INIT:
 247  416D 21 EE 01     	ld	hl,WRKAREA	; size of work area
 248  4170 B7           	or	a			; Clear Cy, no interrupts needed
 249  4171 C8           	ret	z			; first call
 250  4172
 251  4172              	; second call
 252  4172 CD 6B 42     	call	MY_GWORK
 253  4175 CD 8A 42     	call	INIWORK		; Initialize the work-area
 254  4178
 255  4178              	IFDEF __MISTERSPI
 256  4178 ~            	; DEBUG
 257  4178 ~            	ld a, 1
 258  4178 ~            	out 2fh, a
 259  4178 ~            	; DEBUG
 260  4178              	ENDIF
 261  4178
 262  4178              	; initialize CH376s
 263  4178              	; ============================================
 264  4178              	; print welcome message
 265  4178 21 41 45         ld hl, TXT_START
 266  417B CD 13 47         call PRINT
 267  417E
 268  417E              	; enable the low-level MSXUSB driver
 269  417E              	;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
 270  417E CD 3A 4C     	call USBHOST_INIT
 271  4181
 272  4181              	; enable the flash rom driver
 273  4181 CD 09 44     	call FLASH_INIT
 274  4184
 275  4184              	; reset CH376s
 276  4184 CD 5E 47         call CH_RESET
 277  4187              	; wait ~100ms
 278  4187 01 06 00     	ld bc, WAIT_ONE_SECOND/10
 279  418A CD 5B 4B     	call WAIT
 280  418D
 281  418D              	IFDEF __MISTERSPI
 282  418D ~            	; make MISO the INT line
 283  418D ~            	call CH_SET_SD0_INT
 284  418D              	ENDIF
 285  418D
 286  418D              	; check if CH376s in the cartridge slot
 287  418D CD 88 47         call CH_HW_TEST
 288  4190 30 07            jr nc, _HW_TEST_OKAY
 289  4192 21 C7 45         ld hl, TXT_NOT_FOUND
 290  4195 CD 13 47         call PRINT
 291  4198 C9               ret
 292  4199
 293  4199              _HW_TEST_OKAY:
 294  4199 DD 7E 00     	ld a,(ix+WRKAREA.STATUS)
 295  419C CB C7            set 0,a
 296  419E DD 77 00         ld (ix+WRKAREA.STATUS),a
 297  41A1 21 9B 45        	ld hl, TXT_FOUND
 298  41A4 CD 13 47         call PRINT
 299  41A7
 300  41A7              	; check and display CH376s IC/firmware version
 301  41A7 21 B5 45     	ld hl, TXT_IC_VERSION
 302  41AA CD 13 47     	call PRINT
 303  41AD CD 63 47     	call CH_IC_VERSION
 304  41B0 C6 30        	add a, '0'
 305  41B2 CD A2 00     	call CHPUT
 306  41B5 21 E2 45     	ld hl, TXT_NEWLINE
 307  41B8 CD 13 47     	call PRINT
 308  41BB
 309  41BB              	; reset USB bus and device
 310  41BB CD 33 4B         call USB_HOST_BUS_RESET
 311  41BE
 312  41BE              	; enumerate and initialise USB devices
 313  41BE DD E5        	push ix
 314  41C0 CD 92 4A     	call FN_CONNECT
 315  41C3 DD E1        	pop ix
 316  41C5 B7           	or a
 317  41C6 C2 D6 41     	jp nz, _USB_MODE_OKAY
 318  41C9 21 FC 45         ld hl, TXT_DEVICE_CHECK_NOK
 319  41CC CD 13 47         call PRINT
 320  41CF 01 78 00     	ld bc, WAIT_ONE_SECOND*2
 321  41D2 CD 5B 4B     	call WAIT
 322  41D5 C9               ret
 323  41D6              _USB_MODE_OKAY:
 324  41D6 F5           	push af
 325  41D7 3E 2B        	ld a, "+"
 326  41D9 CD A2 00     	call CHPUT
 327  41DC F1           	pop af
 328  41DD F5           	push af
 329  41DE C6 30        	add 0x30
 330  41E0 CD A2 00     	call CHPUT
 331  41E3 F1           	pop af
 332  41E4 DD 7E 00     	ld a,(ix+WRKAREA.STATUS)
 333  41E7 CB CF            set 1,a
 334  41E9 DD 77 00         ld (ix+WRKAREA.STATUS),a
 335  41EC 21 E5 45         ld hl, TXT_DEVICE_CHECK_OK
 336  41EF CD 13 47         call PRINT
 337  41F2 DD 7E 0A     	ld a, (ix+WRKAREA.STORAGE_DEVICE_INFO.DEVICE_ADDRESS)
 338  41F5 A7           	and a
 339  41F6 20 07        	jr nz, _FOUND_
 340  41F8 21 17 46         ld hl, TXT_STORAGE_CHECK_NOK
 341  41FB CD 13 47         call PRINT
 342  41FE C9               ret
 343  41FF              _FOUND_:
 344  41FF 21 29 46     	ld hl, TXT_STORAGE_CHECK_OK
 345  4202 CD 13 47         call PRINT
 346  4205              	; start communicating with SCSI device
 347  4205 CD F8 52     	call SCSI_MAX_LUNS
 348  4208 D8           	ret c
 349  4209 CD 38 53     	call SCSI_INIT
 350  420C CD C0 51     	call SCSI_INQUIRY
 351  420F 30 07        	jr nc, _INQUIRY_OKAY
 352  4211 21 41 46     	ld hl, TXT_INQUIRY_NOK
 353  4214 CD 13 47     	call PRINT
 354  4217 C9           	ret
 355  4218              _INQUIRY_OKAY:
 356  4218 DD E5        	push ix
 357  421A              	;
 358  421A 21 3D 46     	ld hl, TXT_INQUIRY_OK
 359  421D CD 13 47     	call PRINT
 360  4220 01 50 00     	ld bc, WRKAREA.SCSI_DEVICE_INFO.VENDORID
 361  4223 CD 84 42     	call WRKAREAPTR
 362  4226 DD E5 E1     	ld hl, ix
 363  4229 CD 13 47     	call PRINT
 364  422C 21 3D 46     	ld hl, TXT_INQUIRY_OK
 365  422F CD 13 47     	call PRINT
 366  4232 01 59 00     	ld bc, WRKAREA.SCSI_DEVICE_INFO.PRODUCTID
 367  4235 CD 84 42     	call WRKAREAPTR
 368  4238 DD E5 E1     	ld hl, ix
 369  423B CD 13 47     	call PRINT
 370  423E              	;
 371  423E DD E1        	pop ix
 372  4240 DD 7E 00     	ld a,(ix+WRKAREA.STATUS)
 373  4243 CB D7            set 2,a
 374  4245 DD 77 00         ld (ix+WRKAREA.STATUS),a
 375  4248
 376  4248 21 56 46     	ld hl, TXT_TEST_START
 377  424B CD 13 47     	call PRINT
 378  424E              _SCSI_TEST_AGAIN:
 379  424E CD 2A 52     	call SCSI_TEST
 380  4251 30 05        	jr nc, _SCSI_TEST_OKAY
 381  4253 CD 46 52     	call SCSI_REQUEST_SENSE
 382  4256 18 F6        	jr _SCSI_TEST_AGAIN
 383  4258              _SCSI_TEST_OKAY:
 384  4258 21 70 46     	ld hl, TXT_TEST_OK
 385  425B CD 13 47     	call PRINT
 386  425E              	; return status disk present but changed
 387  425E DD 7E 00     	ld a,(ix+WRKAREA.STATUS)
 388  4261 CB DF            set 3,a
 389  4263 CB E7        	set 4,a
 390  4265 CB EF        	set 5,a
 391  4267 DD 77 00         ld (ix+WRKAREA.STATUS),a
 392  426A C9           	ret
 393  426B              ;-----------------------------------------------------------------------------
 394  426B              ;
 395  426B              ; Obtain the work area address for the driver or the device
 396  426B              ; Input: (none)
 397  426B              ; Output: IX=Pointer to the selected work area
 398  426B
 399  426B              MY_GWORK:
 400  426B F5           	push	af
 401  426C AF           	xor	a
 402  426D 08           	EX	AF,AF'
 403  426E AF           	XOR	A
 404  426F DD 21 45 40  	LD	IX,GWORK
 405  4273 CD 42 40     	call CALBNK
 406  4276 F1           	pop	af
 407  4277 D5           	push de
 408  4278 DD 5E 00     	ld	e,(ix)			; de=Pointer to the WorkAREA in RAM
 409  427B DD 56 01     	ld	d,(ix+1)
 410  427E DD 62 DD 6B  	ld	ix, de
 411  4282 D1           	pop	de
 412  4283 C9           	ret
 413  4284
 414  4284              ;-----------------------------------------------------------------------------
 415  4284              ;
 416  4284              ; Obtain the work area address for the driver or the device
 417  4284              ; Input: BC = delta in WKRAREA
 418  4284              ; Output: IX=Pointer to the selected work area
 419  4284
 420  4284              WRKAREAPTR:
 421  4284 CD 6B 42     	call MY_GWORK
 422  4287 DD 09        	add ix, bc
 423  4289 C9           	ret
 424  428A
 425  428A
 426  428A              ; ------------------------------------------------
 427  428A              ; Initialize the Work-area
 428  428A              ; ------------------------------------------------
 429  428A              INIWORK:
 430  428A              	; Clear the WorkArea
 431  428A DD E5 E1     	ld hl, ix
 432  428D 54 5D        	ld de, hl
 433  428F 13           	inc de
 434  4290 01 ED 01     	ld bc,WRKAREA-1 ; size of wrkarea
 435  4293 AF           	xor	a
 436  4294 77           	ld	(hl),a
 437  4295 ED B0        	ldir
 438  4297
 439  4297              	; copy NXT_DIRECT to Work-area
 440  4297 CD 49 50     	call NXT_DIRECT_WRKAREA
 441  429A C9           	ret
 442  429B
 443  429B              ;-----------------------------------------------------------------------------
 444  429B              ;
 445  429B              ; Get driver configuration
 446  429B              ; (bit 2 of driver flags must be set if this routine is implemented)
 447  429B              ;
 448  429B              ; Input:
 449  429B              ;   A = Configuration index
 450  429B              ;   BC, DE, HL = Depends on the configuration
 451  429B              ;
 452  429B              ; Output:
 453  429B              ;   A = 0: Ok
 454  429B              ;       1: Configuration not available for the supplied index
 455  429B              ;   BC, DE, HL = Depends on the configuration
 456  429B              DRV_CONFIG:
 457  429B CD 6B 42     	call MY_GWORK
 458  429E 3D           	dec a
 459  429F 20 11        	jr nz, _DEFAULT_CONFIG
 460  42A1              ; * Get number of drives at boot time (for device-based drivers only):
 461  42A1              ;   Input:
 462  42A1              ;     A = 1
 463  42A1              ;     B = 0 for DOS 2 mode, 1 for DOS 1 mode
 464  42A1              ;     C: bit 5 set if user is requesting reduced drive count
 465  42A1              ;        (by pressing the 5 key)
 466  42A1              ;   Output:
 467  42A1              ;     B = number of drives
 468  42A1              _NR_DRIVES_AT_BOOT_TIME:
 469  42A1 DD 7E 00     	ld a,(ix+WRKAREA.STATUS)
 470  42A4 06 00        	ld b, 0
 471  42A6 CB 7F        	bit 7,a ; ROMDRIVE
 472  42A8 28 01        	jr z, _CHECK_USB
 473  42AA 04           	inc b
 474  42AB              _CHECK_USB:
 475  42AB CB 5F        	bit 3,a ; USB DRIVE INITIALIZED
 476  42AD 28 01        	jr z, _CHECK_COMPLETE
 477  42AF 04           	inc b
 478  42B0              _CHECK_COMPLETE:
 479  42B0 AF           	xor a
 480  42B1 C9           	ret
 481  42B2
 482  42B2              ; * Get default configuration for drive
 483  42B2              ;   Input:
 484  42B2              ;     A = 2
 485  42B2              ;     B = 0 for DOS 2 mode, 1 for DOS 1 mode
 486  42B2              ;     C = Relative drive number at boot time
 487  42B2              ;   Output:
 488  42B2              ;     B = Device index
 489  42B2              ;     C = LUN index
 490  42B2              _DEFAULT_CONFIG:
 491  42B2 41           	ld b, c
 492  42B3 04           	inc b
 493  42B4 0E 01        	ld c, 1
 494  42B6 AF           	xor a
 495  42B7 C9           	ret
 496  42B8
 497  42B8              ;-----------------------------------------------------------------------------
 498  42B8              ;
 499  42B8              ; Obtain driver version
 500  42B8              ;
 501  42B8              ; Input:  -
 502  42B8              ; Output: A = Main version number
 503  42B8              ;         B = Secondary version number
 504  42B8              ;         C = Revision number
 505  42B8
 506  42B8              DRV_VERSION:
 507  42B8 3E 00        	ld	a,VER_MAIN
 508  42BA 06 06        	ld	b,VER_SEC
 509  42BC 0E 00        	ld	c,VER_REV
 510  42BE C9           	ret
 511  42BF
 512  42BF
 513  42BF              ;-----------------------------------------------------------------------------
 514  42BF              ;
 515  42BF              ; BASIC expanded statement ("CALL") handler.
 516  42BF              ; Works the expected way, except that if invoking CALBAS is needed,
 517  42BF              ; it must be done via the CALLB0 routine in kernel page 0.
 518  42BF
 519  42BF              DRV_BASSTAT:
 520  42BF 37           	scf
 521  42C0 C9           	ret
 522  42C1
 523  42C1              ;-----------------------------------------------------------------------------
 524  42C1              ;
 525  42C1              ; BASIC expanded device handler.
 526  42C1              ; Works the expected way, except that if invoking CALBAS is needed,
 527  42C1              ; it must be done via the CALLB0 routine in kernel page 0.
 528  42C1
 529  42C1              DRV_BASDEV:
 530  42C1 37           	scf
 531  42C2 C9           	ret
 532  42C3
 533  42C3
 534  42C3              ;-----------------------------------------------------------------------------
 535  42C3              ;
 536  42C3              ; Extended BIOS hook.
 537  42C3              ; Works the expected way, except that it must return
 538  42C3              ; D'=1 if the old hook must be called, D'=0 otherwise.
 539  42C3              ; It is entered with D'=1.
 540  42C3
 541  42C3              DRV_EXTBIO:
 542  42C3 C9           	ret
 543  42C4
 544  42C4
 545  42C4              ;-----------------------------------------------------------------------------
 546  42C4              ;
 547  42C4              ; Direct calls entry points.
 548  42C4              ; Calls to addresses 7850h, 7853h, 7856h, 7859h and 785Ch
 549  42C4              ; in kernel banks 0 and 3 will be redirected
 550  42C4              ; to DIRECT0/1/2/3/4 respectively.
 551  42C4              ; Receives all register data from the caller except IX and AF'.
 552  42C4
 553  42C4              ;DRV_DIRECT0:
 554  42C4              DRV_DIRECT1:
 555  42C4              DRV_DIRECT2:
 556  42C4              DRV_DIRECT3:
 557  42C4              DRV_DIRECT4:
 558  42C4 C9           	ret
 559  42C5
 560  42C5              ;=====
 561  42C5              ;=====  BEGIN of DEVICE-BASED specific routines
 562  42C5              ;=====
 563  42C5
 564  42C5              CAPS_FLASH:
 565  42C5                  ; CAPS FLASH
 566  42C5 DB AA        	in a, (0xaa)
 567  42C7 CB 77            bit 6,a
 568  42C9 28 04            jr z, _CAPS_FLASH_ON
 569  42CB CB B7        	res 6,a
 570  42CD 18 02            jr _CAPS_FLASH
 571  42CF              _CAPS_FLASH_ON:
 572  42CF CB F7            set 6,a
 573  42D1              _CAPS_FLASH:
 574  42D1 D3 AA        	out (0xaa),a
 575  42D3 C9               ret
 576  42D4
 577  42D4              ;-----------------------------------------------------------------------------
 578  42D4              ;
 579  42D4              ; Read or write logical sectors from/to a logical unit
 580  42D4              ;
 581  42D4              ;Input:    Cy=0 to read, 1 to write
 582  42D4              ;          A = Device number, 1 to 7
 583  42D4              ;          B = Number of sectors to read or write
 584  42D4              ;          C = Logical unit number, 1 to 7
 585  42D4              ;          HL = Source or destination memory address for the transfer
 586  42D4              ;          DE = Address where the 4 byte sector number is stored.
 587  42D4              ;Output:   A = Error code (the same codes of MSX-DOS are used):
 588  42D4              ;              0: Ok
 589  42D4              ;              _IDEVL: Invalid device or LUN
 590  42D4              ;              _NRDY: Not ready
 591  42D4              ;              _DISK: General unknown disk error
 592  42D4              ;              _DATA: CRC error when reading
 593  42D4              ;              _RNF: Sector not found
 594  42D4              ;              _UFORM: Unformatted disk
 595  42D4              ;              _WPROT: Write protected media, or read-only logical unit
 596  42D4              ;              _WRERR: Write error
 597  42D4              ;              _NCOMP: Incompatible disk.
 598  42D4              ;              _SEEK: Seek error.
 599  42D4              ;         B = Number of sectors actually read (in case of error only)
 600  42D4              DEV_RW:
 601  42D4 F5           	push af ; preserve A + flags
 602  42D5 79           	ld a, c
 603  42D6 FE 01        	cp 1 ; lun 1 only
 604  42D8 28 06        	jr z, _DEV_RW_CHECK_DRIVE
 605  42DA 3E B5        	ld a, _IDEVL
 606  42DC 06 00        	ld b, 0
 607  42DE F1           	pop af
 608  42DF C9           	ret
 609  42E0
 610  42E0              _DEV_RW_CHECK_DRIVE:
 611  42E0 F1           	pop af ; restore A
 612  42E1 F5           	push af ; preserve flags
 613  42E2 FE 01        	cp 1 ; drive A:
 614  42E4 28 0A        	jr z, _DEV_RW_DRIVE_A
 615  42E6 FE 02        	cp 2 ; drive
 616  42E8 28 11        	jr z, _DEV_RW_DRIVE_B
 617  42EA              	;
 618  42EA 3E B5        	ld a, _IDEVL
 619  42EC 06 00        	ld b, 0
 620  42EE F1           	pop af
 621  42EF C9           	ret
 622  42F0
 623  42F0              _DEV_RW_DRIVE_A:
 624  42F0 CD 6B 42     	call MY_GWORK
 625  42F3 DD 4E 00     	ld c,(ix+WRKAREA.STATUS)
 626  42F6 CB 79        	bit 7,c
 627  42F8 C2 6C 44     	jp nz, DEV_RW_ROMDISK ; Drive A is ROM disk
 628  42FB              	;jr DEV_RW_SCSI ; Drive A is USB Storage
 629  42FB
 630  42FB              _DEV_RW_DRIVE_B: ; Drive B is always USB storage
 631  42FB              DEV_RW_SCSI:
 632  42FB CD C5 42     	call CAPS_FLASH
 633  42FE F1           	pop af
 634  42FF 38 07        	jr c, _DEV_WRITE
 635  4301 CD 62 52     	call SCSI_READ
 636  4304 38 0F        	jr c, _DEV_RW_ERR
 637  4306 18 05        	jr _DEV_RW_NEXT_4
 638  4308              _DEV_WRITE
 639  4308 CD AA 52     	call SCSI_WRITE
 640  430B 38 08        	jr c, _DEV_RW_ERR
 641  430D              _DEV_RW_NEXT_4:
 642  430D              	; CAPS OFF
 643  430D DB AA        	in a, 0xaa
 644  430F CB F7        	set 6,a
 645  4311 D3 AA        	out 0xaa,a
 646  4313              	;
 647  4313 AF           	xor a ; success
 648  4314 C9           	ret
 649  4315              _DEV_RW_ERR
 650  4315 CD C5 42     	call CAPS_FLASH
 651  4318 3E F9        	ld a, _RNF
 652  431A 06 00        	ld b, 0
 653  431C C9           	ret
 654  431D
 655  431D
 656  431D              ;-----------------------------------------------------------------------------
 657  431D              ;
 658  431D              ; Device information gathering
 659  431D              ;
 660  431D              ;Input:   A = Device index, 1 to 7
 661  431D              ;         B = Information to return:
 662  431D              ;             0: Basic information
 663  431D              ;             1: Manufacturer name string
 664  431D              ;             2: Device name string
 665  431D              ;             3: Serial number string
 666  431D              ;         HL = Pointer to a buffer in RAM
 667  431D              ;Output:  A = Error code:
 668  431D              ;             0: Ok
 669  431D              ;             1: Device not available or invalid device index
 670  431D              ;             2: Information not available, or invalid information index
 671  431D              ;         When basic information is requested,
 672  431D              ;         buffer filled with the following information:
 673  431D              ;
 674  431D              ;+0 (1): Number of logical units, from 1 to 7. 1 if the device has no logical
 675  431D              ;        units (which is functionally equivalent to having only one).
 676  431D              ;+1 (1): Device flags, always zero in Beta 2.
 677  431D              ;
 678  431D              ; The strings must be printable ASCII string (ASCII codes 32 to 126),
 679  431D              ; left justified and padded with spaces. All the strings are optional,
 680  431D              ; if not available, an error must be returned.
 681  431D              ; If a string is provided by the device in binary format, it must be reported
 682  431D              ; as an hexadecimal, upper-cased string, preceded by the prefix "0x".
 683  431D              ; The maximum length for a string is 64 characters;
 684  431D              ; if the string is actually longer, the leftmost 64 characters
 685  431D              ; should be provided.
 686  431D              ;
 687  431D              ; In the case of the serial number string, the same rules for the strings
 688  431D              ; apply, except that it must be provided right-justified,
 689  431D              ; and if it is too long, the rightmost characters must be
 690  431D              ; provided, not the leftmost.
 691  431D
 692  431D              DEV_INFO:
 693  431D FE 01        	cp 1 ; drive A:
 694  431F 28 06        	jr z, _DEV_INFO_DRIVE_A
 695  4321 FE 02        	cp 2 ; drive
 696  4323 28 0D        	jr z, _DEV_INFO_DRIVE_B
 697  4325 20 5F        	jr nz, _DEV_INFO_NOT_INSERTED
 698  4327              _DEV_INFO_DRIVE_A:
 699  4327 CD 6B 42     	call MY_GWORK
 700  432A DD 7E 00     	ld a,(ix+WRKAREA.STATUS)
 701  432D CB 7F        	bit 7,a
 702  432F C2 D6 44     	jp nz, DEV_INFO_ROMDISK ; Drive A is ROM disk
 703  4332              	;jr DEV_INFO_SCSI ; Drive A is  USB storage
 704  4332              _DEV_INFO_DRIVE_B ; Drive B is always USB storage
 705  4332              DEV_INFO_SCSI:
 706  4332 4F           	ld c, a
 707  4333 78           	ld a, b
 708  4334 FE 00        	cp 0
 709  4336 28 0E        	jr z,_DEV_INFO_BASIC
 710  4338 FE 01        	cp 1
 711  433A 28 11        	jr z,_DEV_INFO_MANUFACTURER
 712  433C FE 02        	cp 2
 713  433E 28 20        	jr z,_DEV_INFO_DEVICE_NAME
 714  4340 FE 03        	cp 3
 715  4342 28 2F        	jr z,_DEV_INFO_SERIAL
 716  4344              	; else
 717  4344 18 40        	jr _DEV_INFO_NOT_INSERTED
 718  4346
 719  4346              _DEV_INFO_BASIC:
 720  4346 36 01        	ld (hl),1
 721  4348 23           	inc hl
 722  4349 36 00        	ld (hl),0
 723  434B AF           	xor a
 724  434C C9           	ret
 725  434D
 726  434D              _DEV_INFO_MANUFACTURER:
 727  434D 54 5D        	ld de, hl
 728  434F 01 50 00     	ld bc, WRKAREA.SCSI_DEVICE_INFO.VENDORID
 729  4352 CD 84 42     	call WRKAREAPTR
 730  4355 DD E5 E1     	ld hl,ix
 731  4358 01 08 00     	ld bc, 8
 732  435B ED B0        	ldir
 733  435D AF           	xor a
 734  435E 12           	ld (de),a
 735  435F C9           	ret
 736  4360
 737  4360              _DEV_INFO_DEVICE_NAME:
 738  4360 54 5D        	ld de, hl
 739  4362 01 59 00     	ld bc, WRKAREA.SCSI_DEVICE_INFO.PRODUCTID
 740  4365 CD 84 42     	call WRKAREAPTR
 741  4368 DD E5 E1     	ld hl,ix
 742  436B 01 10 00     	ld bc, 16
 743  436E ED B0        	ldir
 744  4370 AF           	xor a
 745  4371 12           	ld (de),a
 746  4372 C9           	ret
 747  4373
 748  4373              _DEV_INFO_SERIAL:
 749  4373 54 5D        	ld de, hl
 750  4375 01 6A 00     	ld bc, WRKAREA.SCSI_DEVICE_INFO.PRODUCTREV
 751  4378 CD 84 42     	call WRKAREAPTR
 752  437B DD E5 E1     	ld hl,ix
 753  437E 01 04 00     	ld bc, 4
 754  4381 ED B0        	ldir
 755  4383 AF           	xor a
 756  4384 12           	ld (de),a
 757  4385 C9           	ret
 758  4386
 759  4386              _DEV_INFO_NOT_INSERTED:
 760  4386 3E 01        	ld	a,1
 761  4388 C9           	ret
 762  4389
 763  4389
 764  4389              ;-----------------------------------------------------------------------------
 765  4389              ;
 766  4389              ; Obtain device status
 767  4389              ;
 768  4389              ;Input:   A = Device index, 1 to 7
 769  4389              ;         B = Logical unit number, 1 to 7
 770  4389              ;             0 to return the status of the device itself.
 771  4389              ;Output:  A = Status for the specified logical unit,
 772  4389              ;             or for the whole device if 0 was specified:
 773  4389              ;                0: The device or logical unit is not available, or the
 774  4389              ;                   device or logical unit number supplied is invalid.
 775  4389              ;                1: The device or logical unit is available and has not
 776  4389              ;                   changed since the last status request.
 777  4389              ;                2: The device or logical unit is available and has changed
 778  4389              ;                   since the last status request
 779  4389              ;                   (for devices, the device has been unplugged and a
 780  4389              ;                    different device has been plugged which has been
 781  4389              ;                    assigned the same device index; for logical units,
 782  4389              ;                    the media has been changed).
 783  4389              ;                3: The device or logical unit is available, but it is not
 784  4389              ;                   possible to determine whether it has been changed
 785  4389              ;                   or not since the last status request.
 786  4389              ;
 787  4389              ; Devices not supporting hot-plugging must always return status value 1.
 788  4389              ; Non removable logical units may return values 0 and 1.
 789  4389              ;
 790  4389              ; The returned status is always relative to the previous invokation of
 791  4389              ; DEV_STATUS itself. Please read the Driver Developer Guide for more info.
 792  4389
 793  4389              DEV_STATUS:
 794  4389              	; check LUN
 795  4389 F5           	push af
 796  438A 78           	ld a, b
 797  438B FE 01        	cp 1
 798  438D 20 0B        	jr nz, _DEV_STATUS_NO_EXIST
 799  438F F1           	pop af
 800  4390              	; check drive
 801  4390 FE 01        	cp 1 ; drive A:
 802  4392 28 09        	jr z, _DEV_STATUS_DRIVE_A
 803  4394 FE 02        	cp 2 ; drive
 804  4396 28 10        	jr z, _DEV_STATUS_DRIVE_B
 805  4398 18 01        	jr _DEV_STATUS_NO_EXIST2
 806  439A              _DEV_STATUS_NO_EXIST:
 807  439A F1           	pop af
 808  439B              _DEV_STATUS_NO_EXIST2:
 809  439B AF           	xor	a ; not available
 810  439C C9           	ret
 811  439D
 812  439D              _DEV_STATUS_DRIVE_A:
 813  439D CD 6B 42     	call MY_GWORK
 814  43A0 DD 7E 00     	ld a,(ix+WRKAREA.STATUS)
 815  43A3 CB 7F        	bit 7,a
 816  43A5 C2 18 45     	jp nz, DEV_STATUS_ROMDISK ; Drive A is ROM disk
 817  43A8              	;jr DEV_STATUS_SCSI ; Drive A is USB storage
 818  43A8              DEV_STATUS_SCSI:
 819  43A8              _DEV_STATUS_DRIVE_B: ; Drive B is always USB storage
 820  43A8 CD 6B 42     	call	MY_GWORK
 821  43AB              	; bit 0 = CH376s present,
 822  43AB              	; bit 1 = initialised,
 823  43AB              	; bit 2 = USB device present,
 824  43AB              	; bit 3 = USB device mounted,
 825  43AB              	; bit 4 = virtual DSK inserted,
 826  43AB              	; bit 5 = DSK changed
 827  43AB DD 7E 00     	ld a, (ix+WRKAREA.STATUS)
 828  43AE              	; DSK present?
 829  43AE CB 67        	bit 4,a
 830  43B0 28 0F        	jr z, _DEV_STATUS_ERR
 831  43B2              	; changed?
 832  43B2 CB 6F        	bit 5,a
 833  43B4 28 08        	jr z, _DEV_STATUS_NO_CHANGE
 834  43B6 CB AF        	res 5,a
 835  43B8 DD 77 00     	ld (ix+WRKAREA.STATUS),a
 836  43BB 3E 02        	ld a, 2 ; available, changed
 837  43BD C9           	ret
 838  43BE
 839  43BE              _DEV_STATUS_NO_CHANGE:
 840  43BE 3E 01        	ld a, 1 ; available, no change
 841  43C0 C9           	ret
 842  43C1
 843  43C1              _DEV_STATUS_ERR:
 844  43C1 AF           	xor	a ; not available
 845  43C2 C9           	ret
 846  43C3
 847  43C3              ;-----------------------------------------------------------------------------
 848  43C3              ;
 849  43C3              ; Obtain logical unit information
 850  43C3              ;
 851  43C3              ;Input:   A  = Device index, 1 to 7
 852  43C3              ;         B  = Logical unit number, 1 to 7
 853  43C3              ;         HL = Pointer to buffer in RAM.
 854  43C3              ;Output:  A = 0: Ok, buffer filled with information.
 855  43C3              ;             1: Error, device or logical unit not available,
 856  43C3              ;                or device index or logical unit number invalid.
 857  43C3              ;         On success, buffer filled with the following information:
 858  43C3              ;
 859  43C3              ;+0 (1): Medium type:
 860  43C3              ;        0: Block device
 861  43C3              ;        1: CD or DVD reader or recorder
 862  43C3              ;        2-254: Unused. Additional codes may be defined in the future.
 863  43C3              ;        255: Other
 864  43C3              ;+1 (2): Sector size, 0 if this information does not apply or is
 865  43C3              ;        not available.
 866  43C3              ;+3 (4): Total number of available sectors.
 867  43C3              ;        0 if this information does not apply or is not available.
 868  43C3              ;+7 (1): Flags:
 869  43C3              ;        bit 0: 1 if the medium is removable.
 870  43C3              ;        bit 1: 1 if the medium is read only. A medium that can dinamically
 871  43C3              ;               be write protected or write enabled is not considered
 872  43C3              ;               to be read-only.
 873  43C3              ;        bit 2: 1 if the LUN is a floppy disk drive.
 874  43C3              ;+8 (2): Number of cylinders
 875  43C3              ;+10 (1): Number of heads
 876  43C3              ;+11 (1): Number of sectors per track
 877  43C3              ;
 878  43C3              ; Number of cylinders, heads and sectors apply to hard disks only.
 879  43C3              ; For other types of device, these fields must be zero.
 880  43C3
 881  43C3              LUN_INFO:
 882  43C3              	; check LUN
 883  43C3 F5           	push af
 884  43C4 78           	ld a, b
 885  43C5 FE 01        	cp 1
 886  43C7 20 0B        	jr nz, _LUN_INFO_NO_EXIST
 887  43C9 F1           	pop af
 888  43CA              	; check Drive
 889  43CA FE 01        	cp 1 ; drive A:
 890  43CC 28 0A        	jr z, _LUN_INFO_DRIVE_A
 891  43CE FE 02        	cp 2 ; drive
 892  43D0 28 11        	jr z, _LUN_INFO_DRIVE_B
 893  43D2 18 01        	jr _LUN_INFO_NO_EXIST2
 894  43D4              _LUN_INFO_NO_EXIST:
 895  43D4 F1           	pop af
 896  43D5              _LUN_INFO_NO_EXIST2:
 897  43D5 3E 01        	ld	a,1
 898  43D7 C9           	ret
 899  43D8
 900  43D8              _LUN_INFO_DRIVE_A:
 901  43D8 CD 6B 42     	call MY_GWORK
 902  43DB DD 7E 00     	ld a,(ix+WRKAREA.STATUS)
 903  43DE CB 7F        	bit 7,a
 904  43E0 C2 1B 45     	jp nz, LUN_INFO_ROMDISK ; Drive A is ROM disk
 905  43E3              	;jr LUN_INFO_SCSI ; Drive A is USB storage
 906  43E3              LUN_INFO_SCSI:
 907  43E3              _LUN_INFO_DRIVE_B:
 908  43E3              	; #0
 909  43E3 36 00        	ld (hl),0 ; block device
 910  43E5              	; #1
 911  43E5 23           	inc hl
 912  43E6 36 00        	ld (hl),00h
 913  43E8 23           	inc hl
 914  43E9 36 02        	ld (hl),02h ; 512 byte sector
 915  43EB              	; #3
 916  43EB 23           	inc hl
 917  43EC 36 00        	ld (hl),00h
 918  43EE 23           	inc hl
 919  43EF 36 00        	ld (hl),00h
 920  43F1 23           	inc hl
 921  43F2 36 00        	ld (hl),00h
 922  43F4 23           	inc hl
 923  43F5 36 00        	ld (hl),00h
 924  43F7              	; #7
 925  43F7 23           	inc hl
 926  43F8 36 01        	ld (hl),00000001b ; removable + non-read only + no floppy
 927  43FA              	; #8
 928  43FA 23           	inc hl
 929  43FB 36 00        	ld (hl), 0
 930  43FD 23           	inc hl
 931  43FE 36 00        	ld (hl), 0 ; cylinders/tracks
 932  4400              	; #10
 933  4400 23           	inc hl
 934  4401 36 00        	ld (hl), 0 ; heads
 935  4403              	; #11
 936  4403 23           	inc hl
 937  4404 36 00        	ld (hl), 0 ; sectors per track
 938  4406
 939  4406 3E 00        	ld a, 0
 940  4408 C9           	ret
 941  4409
 942  4409
 943  4409              ;=====
 944  4409              ;=====  END of DEVICE-BASED specific routines
 945  4409              ;=====
