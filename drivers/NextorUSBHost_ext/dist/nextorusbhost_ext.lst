  34+ 505F              ; Example jumptable
  35+ 505F              ;    call NXT_DIRECT ; 3 bytes - call to switching code
  36+ 505F              ;    DB 1            ; 1 byte  - ROM slot number
  37+ 505F              ;    DB 7            ; 1 byte  - ROM segment
  38+ 505F              ;    DW FN_CHECK     ; 2 bytes - address to call
  39+ 505F                                   ; =============
  40+ 505F                                   ; 7 bytes total per entry
  41+ 505F
  42+ 505F              NXT_DIRECT_START:
  43+ 505F D9               exx         ; save registers
  44+ 5060 08               ex af,af'   ; save flags
  45+ 5061                  ; get all the parameters following our instruction pointed by stack
  46+ 5061 E3               ex (sp),hl
  47+ 5062 46               ld b, (hl)
  48+ 5063 23               inc hl
  49+ 5064 4E               ld c, (hl)
  50+ 5065 23               inc hl
  51+ 5066 5E               ld e, (hl)
  52+ 5067 23               inc hl
  53+ 5068 56               ld d, (hl)
  54+ 5069 E3               ex (sp),hl
