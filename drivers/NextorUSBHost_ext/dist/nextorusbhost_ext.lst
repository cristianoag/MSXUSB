  61+ 4458              FLASH_READ_START
  62+ 4458              ; FLASH_READ - read a number of bytes from flash location
  63+ 4458              ; Input: HL - source address
  64+ 4458              ;        DE - destination address
  65+ 4458              ;        BC - amount of bytes
  66+ 4458              ;        A = bank number
  67+ 4458              ;        A' = bank number to switch back to after done
  68+ 4458              FLASH_READ:
  69+ 4458                  IFNDEF __ROOKIEDRIVE
  70+ 4458 07               rlca ; bank number multiplied times 2 to select right 8k segment
  71+ 4459                  ENDIF
  72+ 4459 32 00 50         ld	(BANK_SWITCH_ADDR),a
  73+ 445C                  IFNDEF __ROOKIEDRIVE
  74+ 445C 3C               inc	a ; plus 1
  75+ 445D 32 00 70     	ld	(BANK_SWITCH_ADDR2),a
  76+ 4460                  ENDIF
  77+ 4460 ED B0        	ldir
  78+ 4462 08           	ex af,af'
  79+ 4463                  IFNDEF __ROOKIEDRIVE
  80+ 4463 07               rlca ; bank number multiplied times 2 to select right 8k segment
