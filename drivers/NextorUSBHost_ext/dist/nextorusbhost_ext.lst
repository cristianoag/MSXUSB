  16+ 4409              FLASH_INIT:
  17+ 4409 DD E5            push ix
  18+ 440B                  ; copy flash read code to WRKAREA
  19+ 440B DD E5 E1         ld hl, ix
  20+ 440E 01 87 01         ld bc, WRKAREA.FLASH_READ
