  90+ 446C              ;-----------------------------------------------------------------------------
  91+ 446C              ;
  92+ 446C              ; Read or write logical sectors from/to a logical unit
  93+ 446C              ;
  94+ 446C              ;Input:    Flags on stack: Cy=0 to read, 1 to write
  95+ 446C              ;          B = Number of sectors to read or write
  96+ 446C              ;          HL = Source or destination memory address for the transfer
  97+ 446C              ;          DE = Address where the 4 byte sector number is stored.
  98+ 446C              ;Output:   A = Error code (the same codes of MSX-DOS are used):
  99+ 446C              ;              0: Ok
 100+ 446C              ;              _IDEVL: Invalid device or LUN
 101+ 446C              ;              _NRDY: Not ready
 102+ 446C              ;              _DISK: General unknown disk error
 103+ 446C              ;              _DATA: CRC error when reading
 104+ 446C              ;              _RNF: Sector not found
 105+ 446C              ;              _UFORM: Unformatted disk
 106+ 446C              ;              _WPROT: Write protected media, or read-only logical unit
 107+ 446C              ;              _WRERR: Write error
 108+ 446C              ;              _NCOMP: Incompatible disk.
 109+ 446C              ;              _SEEK: Seek error.
 110+ 446C              ;         B = Number of sectors actually read (in case of error only)
 111+ 446C              DEV_RW_ROMDISK:
 112+ 446C F1           	pop af
 113+ 446D 30 05        	jr nc,_DEV_R_ROMDISK
 114+ 446F 3E F8        	ld a, _WPROT ; not allowed to write to flash rom
 115+ 4471 06 00        	ld b, 0
 116+ 4473 C9           	ret
 117+ 4474
 118+ 4474              _DEV_R_ROMDISK:
 119+ 4474              	; CAPS ON
 120+ 4474 DB AA        	in a, 0xaa
 121+ 4476 CB B7        	res 6,a
 122+ 4478 D3 AA        	out 0xaa,a
 123+ 447A              	;
 124+ 447A
 125+ 447A              	; calculate banknr and memory position based on (DE)
 126+ 447A DD 62 DD 6B  	ld ix, de
 127+ 447E DD 5E 00     	ld e,(ix+0)
 128+ 4481 DD 56 01     	ld d,(ix+1)
 129+ 4484 D5           	push de
 130+ 4485              	; calculate banknr = sectornr / 32
 131+ 4485 CB 2A        	sra	d ;/2
 132+ 4487 CB 1B        	rr	e
 133+ 4489 CB 2A        	sra	d ;/4
 134+ 448B CB 1B        	rr	e
 135+ 448D CB 2A        	sra	d ;/8
 136+ 448F CB 1B        	rr	e
 137+ 4491 CB 2A        	sra	d ;/16
 138+ 4493 CB 1B        	rr	e
 139+ 4495 CB 2A        	sra	d ;/32
 140+ 4497 CB 1B        	rr	e
 141+ 4499 7B           	ld	a,e
 142+ 449A C6 08        	add	a, DISK_START_BANK
 143+ 449C 4F           	ld  c,a
 144+ 449D              	; calculate memory location = ((sector MOD 32)*512)+#4000
 145+ 449D D1           	pop de
 146+ 449E 7B           	ld	a,e
 147+ 449F E6 1F        	and	%11111
 148+ 44A1 87           	add	a,a
 149+ 44A2 C6 40        	add	a,0x40
 150+ 44A4 57           	ld	d,a
 151+ 44A5 1E 00        	ld	e,0
 152+ 44A7
 153+ 44A7              	; DE points to source and HL points to destination => reverse
 154+ 44A7 EB           	ex de, hl
 155+ 44A8
 156+ 44A8              	; setup call to FLASH_READ
 157+ 44A8 C5           	push bc
 158+ 44A9 01 87 01     	ld bc, WRKAREA.FLASH_READ
 159+ 44AC CD 84 42     	call WRKAREAPTR
 160+ 44AF C1           	pop bc
 161+ 44B0
 162+ 44B0              _DEV_R_ROMDISK_AGAIN:
 163+ 44B0 C5           	push bc
 164+ 44B1 3A FF 40     	ld a, (CUR_BANK)
 165+ 44B4 08               ex af,af'
 166+ 44B5 79           	ld a, c
 167+ 44B6 01 00 02         ld bc, 512
 168+ 44B9 FD 21 C2 44  	ld iy, _DEV_R_ROMDISK_NEXT
 169+ 44BD FD E5            push iy ; return address
 170+ 44BF F3           	di
 171+ 44C0 DD E9            jp (ix)
 172+ 44C2              _DEV_R_ROMDISK_NEXT:
 173+ 44C2 FB           	ei
 174+ 44C3 C1           	pop bc
 175+ 44C4 CB 7C        	bit	7,h	; need next bank ?
 176+ 44C6 28 04        	jr	z,_DEV_R_ROMDISK_NEXT2
 177+ 44C8 21 00 40     	ld	hl,#4000 ; YES
 178+ 44CB 0C           	inc	c
 179+ 44CC              _DEV_R_ROMDISK_NEXT2:
 180+ 44CC 10 E2        	djnz _DEV_R_ROMDISK_AGAIN
 181+ 44CE
 182+ 44CE              	; CAPS OFF
 183+ 44CE DB AA        	in a, 0xaa
 184+ 44D0 CB F7        	set 6,a
 185+ 44D2 D3 AA        	out 0xaa,a
 186+ 44D4              	;
 187+ 44D4 AF           	xor a ; success
 188+ 44D5 C9           	ret
