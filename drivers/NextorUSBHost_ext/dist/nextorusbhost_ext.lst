 864+ 4EBD              ; Parse the descriptor to see if a USB hub
 865+ 4EBD              ; is connected
 866+ 4EBD              ;
 867+ 4EBD              ; Input: (none), assumed that descriptor is loaded in WRKAREA.USB_DESCRIPTOR
