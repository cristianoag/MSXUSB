 104+ 4714 7E               ld a,(hl)
 105+ 4715 A7               and a
 106+ 4716 28 06            jr z, _PRINT_DONE
 107+ 4718 CD A2 00         call CHPUT
 108+ 471B 23               inc hl
 109+ 471C 18 F6            jr _PRINT_MORE
 110+ 471E              _PRINT_DONE:
 111+ 471E F1               pop af
 112+ 471F C9               ret
 113+ 4720
 114+ 4720              ; Set page 0 SlotId
 115+ 4720              ; Input: A - SlotId
 116+ 4720              ; Registers: AF, BC, DE, HL
 117+ 4720              ; Remarks: ISR must preserve page 0 SlotId and page 3 memory mapping. Function must be placed within address range [4000h, BFFFh]
 118+ 4720              BEEP equ 0c0h
 119+ 4720              SLTTBL equ 0FCC5h
 120+ 4720              CLS	equ	0Ch
 121+ 4720              setpg0:
 122+ 4720 4F           	ld c, a ; save
 123+ 4721              	; primary slot
 124+ 4721 E6 03        	and 3 ; get only primary slot
 125+ 4723 47           	ld b, a ; B = primary slot for page 0
 126+ 4724 DB A8        	in a, (0a8h)
 127+ 4726 E6 FC        	and 0fch ; clean page 0
 128+ 4728 B0           	or b
 129+ 4729 D3 A8        	out (0a8h), a
 130+ 472B              	; secondary slot
 131+ 472B 79           	ld a, c ; restore original SlotId value
 132+ 472C 07           	rlca ; check for expanded bit
 133+ 472D D0           	ret nc ; if not expanded return
 134+ 472E 0F           	rrca
 135+ 472F E6 0C        	and 00ch ; get only subslot
 136+ 4731 0F           	rrca ; put it for page 0
 137+ 4732 0F           	rrca
 138+ 4733 4F           	ld c, a ; C = secondary slot for page 0
 139+ 4734              	; set SLTTBL on HL
 140+ 4734 21 C5 FC     	ld hl, SLTTBL
 141+ 4737 16 00        	ld d, 0
 142+ 4739 58           	ld e, b ; add primary slot value to SLTTBL
 143+ 473A 19           	add hl, de ; HL = SLTTBL pointer
 144+ 473B              	; check if is the same already in SSSR
 145+ 473B 7E           	ld a, (hl) ; get SLTTBL
 146+ 473C 57           	ld d, a ; save
 147+ 473D E6 03        	and 3 ; get only page 0
 148+ 473F A9           	xor c ; compare if the same
 149+ 4740 C8           	ret z ; if xor = 0 then is the same, return
 150+ 4741              	; pre-compute new SSSR
 151+ 4741 7A           	ld a, d ; recover SLTTBL
 152+ 4742 E6 FC        	and 0fch ; clean page 0
 153+ 4744 B1           	or c ; set secondary slot for page 0
 154+ 4745 5F           	ld e, a ; E = new SSSR
 155+ 4746 78           	ld a, b ; recover primary slot
 156+ 4747 0F           	rrca ; set it for page 3
 157+ 4748 0F           	rrca
 158+ 4749 47           	ld b, a ; B = primary slot for page 3
 159+ 474A              	; change SSSR
 160+ 474A DB A8        	in a, (0a8h)
 161+ 474C 57           	ld d, a ; save original value
 162+ 474D E6 3F        	and 03fh ; clean page 3
 163+ 474F B0           	or b
 164+ 4750 F3           	di ; we are going to change page 3
 165+ 4751 D3 A8        	out (0a8h), a ; set page 3 for SSSR
 166+ 4753 7B           	ld a, e ; recover new SSSR
 167+ 4754 32 FF FF     	ld (0ffffh), a ; set new SSSR
 168+ 4757 7A           	ld a, d ; restore page 3
 169+ 4758 D3 A8        	out (0a8h), a
 170+ 475A              	; update SLTTBL
 171+ 475A 7B           	ld a, e ; recover new SSSR
 172+ 475B 77           	ld (hl), a ; save on its corresponding SLTTBL
 173+ 475C FB           	ei ; finished with page 3
 174+ 475D C9           	ret
