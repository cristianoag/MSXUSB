0451+  4FD2             
0452+  4FD2             
0453+  4FD2                 if 0
0454+  4FD2~            
0455+  4FD2~            ; -----------------------------------------------------------------------------
0456+  4FD2~            ; Get information about the disk currently in the drive
0457+  4FD2~            ; -----------------------------------------------------------------------------
0458+  4FD2~            ; Input:  A = 1 to retry "disk changed" error
0459+  4FD2~            ; Output: A = DSKIO error code (if Cy=1)
0460+  4FD2~            ;         Cy = 1 on error
0461+  4FD2~            ;         B = FFh if disk changed
0462+  4FD2~            ;              1 if disk unchanged
0463+  4FD2~            ;              (only if A=0 at input)
0464+  4FD2~            ;         C = bit 0: 1 if disk is already formatted
0465+  4FD2~            ;             bit 1: 0 if disk is 720k, 1 if disk is 1.44M
0466+  4FD2~            ;             (only if Cy=0 and B=1)
0467+  4FD2~            
0468+  4FD2~            _GET_DISK_INFO_STACK_SPACE: equ 12
0469+  4FD2~            
0470+  4FD2~            GET_DISK_INFO:
0471+  4FD2~            
0472+  4FD2~                if HW_IMPL_CONFIGURE_NAK_RETRY=1
0473+  4FD2~            
0474+  4FD2~                push af
0475+  4FD2~                scf
0476+  4FD2~                call HW_CONFIGURE_NAK_RETRY
0477+  4FD2~                pop af
0478+  4FD2~                call _GET_DISK_INFO
0479+  4FD2~                push af
0480+  4FD2~                or a
0481+  4FD2~                call HW_CONFIGURE_NAK_RETRY
0482+  4FD2~                pop af
0483+  4FD2~                ret
0484+  4FD2~            _GET_DISK_INFO:
0485+  4FD2~            
0486+  4FD2~                endif
0487+  4FD2~            
0488+  4FD2~                ld ix,-_GET_DISK_INFO_STACK_SPACE
0489+  4FD2~                add ix,sp
0490+  4FD2~                ld sp,ix
0491+  4FD2~            
0492+  4FD2~                push ix
0493+  4FD2~                pop de
0494+  4FD2~                ld hl,_UFI_READ_FORMAT_CAPACITIES_CMD
0495+  4FD2~                ld bc,12
0496+  4FD2~                or a
0497+  4FD2~                ld a,1
0498+  4FD2~                push ix
0499+  4FD2~                call USB_EXECUTE_CBI_WITH_RETRY
0500+  4FD2~                pop ix
0501+  4FD2~            
0502+  4FD2~                or a
0503+  4FD2~                ld a,12
0504+  4FD2~                scf
0505+  4FD2~                jr nz,_GET_DISK_INFO_END   ;Return "other error" on USB error
0506+  4FD2~            
0507+  4FD2~                ld a,d
0508+  4FD2~                or a
0509+  4FD2~                jr z,_GET_DISK_INFO_NO_ERR
0510+  4FD2~                cp 28h  ;"Disk changed" error
0511+  4FD2~                ld b,0FFh
0512+  4FD2~                jr z,_GET_DISK_INFO_OK
0513+  4FD2~                jr _GET_DISK_INFO_ASC_ERR
0514+  4FD2~            
0515+  4FD2~            _GET_DISK_INFO_NO_ERR:
0516+  4FD2~            
0517+  4FD2~                ;Useful information returned by the Read Format Capacities command:
0518+  4FD2~                ;+6: High byte of disk capacity in sectors:
0519+  4FD2~                ;    5h: 720K
0520+  4FD2~                ;    4h: 1.25M
0521+  4FD2~                ;    Bh: 1.44M 
0522+  4FD2~                ;+8: Disk format status:
0523+  4FD2~                ;    01b: unformatted
0524+  4FD2~                ;    10b: formatted
0525+  4FD2~                ;    11b: no disk in drive
0526+  4FD2~            
0527+  4FD2~                ld a,(ix+8)
0528+  4FD2~                and 11b
0529+  4FD2~                cp 3
0530+  4FD2~                ld a,2
0531+  4FD2~                scf
0532+  4FD2~                jr z,_GET_DISK_INFO_END     ;Return "not ready" if no disk present
0533+  4FD2~            
0534+  4FD2~                ld a,(ix+8)
0535+  4FD2~                and 1
0536+  4FD2~                xor 1
0537+  4FD2~                ld c,a  ;Now C = 0 for unformatted disk, 1 for formatted disk
0538+  4FD2~            
0539+  4FD2~                ld b,1  ;Disk not changed
0540+  4FD2~                ld a,(ix+6)
0541+  4FD2~                cp 05h
0542+  4FD2~                jr z,_GET_DISK_INFO_OK
0543+  4FD2~                set 1,c
0544+  4FD2~                cp 0Bh
0545+  4FD2~                jr z,_GET_DISK_INFO_OK
0546+  4FD2~            
0547+  4FD2~                ld c,10b    ;If the disk is 1.25M, report it as unformatted 1.44M
0548+  4FD2~                jr _GET_DISK_INFO_END
0549+  4FD2~            
0550+  4FD2~            _GET_DISK_INFO_ASC_ERR:
0551+  4FD2~                call ASC_TO_ERR
0552+  4FD2~                scf
0553+  4FD2~                jr _GET_DISK_INFO_END
0554+  4FD2~            _GET_DISK_INFO_OK:
0555+  4FD2~                xor a
0556+  4FD2~            _GET_DISK_INFO_END:
0557+  4FD2~                push af
0558+  4FD2~                pop hl
0559+  4FD2~                ld ix,_GET_DISK_INFO_STACK_SPACE
0560+  4FD2~                add ix,sp
0561+  4FD2~                ld sp,ix
0562+  4FD2~                push hl
0563+  4FD2~                pop af
0564+  4FD2~                ret
0565+  4FD2~            
0566+  4FD2~            _UFI_READ_FORMAT_CAPACITIES_CMD:
0567+  4FD2~                db 23h, 0, 0, 0, 0, 0, 0, 0, 12, 0, 0, 0
0568+  4FD2~            
0569+  4FD2                 endif
0058   4FD2                 include "bank1/work_area.asm"
0001+  4FD2             ; MSXUSB USB FDD BIOS
0002+  4FD2             ; Based on the Rookie Drive USB FDD BIOS created by Konamiman in 2018
0003+  4FD2             ; This version is adapted to work with the latest version of the MSXUSB project
0004+  4FD2             ;
0005+  4FD2             ; This file contains the work area handling cod.
0006+  4FD2             ; We use the 8 bytes available for our slot at SLTWRK.
0007+  4FD2             
0008+  4FD2             
0009+  4FD2             ; Work area definition when a FDD is connected:
0010+  4FD2             ;
0011+  4FD2             ; +0: Bulk OUT endpoint parameters
0012+  4FD2             ; +1: Bulk IN endpoint parameters
0013+  4FD2             ; +2: Interrupt IN endpoint parameters
0014+  4FD2             ; +3: Interface number for the ADSC setup packet
0015+  4FD2             ; +4: Bits 0-3: Last relative drive accessed
0016+  4FD2             ;     Bits 4-7: Misc flags
0017+  4FD2             ;               0: set if USB hub found
0018+  4FD2             ; +5: Last USB error (for CALL USBERROR)
0019+  4FD2             ; +6: Last ASC (for CALL USBERROR)
0020+  4FD2             ; +7: Last ASCQ (for CALL USBERROR)
0021+  4FD2             ;
0022+  4FD2             ; Endpoint parameters are:
0023+  4FD2             ;   bits 7 and 3-0: Endpoint number
0024+  4FD2             ;   bit 4: Toggle bit state
0025+  4FD2             ;   bits 6-5: Endpoint max packet size
0026+  4FD2             ;
0027+  4FD2             ; For +2 what 6-5 actually stores is the endpoint 0 max packet size,
0028+  4FD2             ; the max packet size of the interrupt IN endpoint is assumed to be 2.
0029+  4FD2             ;
0030+  4FD2             ; Max packet size is stored encoded as follows:
0031+  4FD2             ;  00 = 8 bytes
0032+  4FD2             ;  01 = 16 bytes
0033+  4FD2             ;  10 = 32 bytes
0034+  4FD2             ;  11 = 64 bytes
0035+  4FD2             ;
0036+  4FD2             ; Work area definition when a storage device is connected:
0037+  4FD2             ;
0038+  4FD2             ; +0: flags:
0039+  4FD2             ;     bit 7: set to 1, indicates a storage device is connected
0040+  4FD2             ;            (if a floppy is connected it'll be 0 since the byte holds
0041+  4FD2             ;             the OUT endpoint number)
0042+  4FD2             ;     bit 0: set to 1 if there's a file mounted
0043+  4FD2             ;     bit 1: set if mounted in read only mode
0044+  4FD2             ;     bit 2: set if file has changed
0045+  4FD2             ;     bit 3: set to enable CAPS lit on disk access
0046+  4FD2             ; +1: Current directory depth:
0047+  4FD2             ;     0: no directory currently open
0048+  4FD2             ;     1: root directory, etc
0049+  4FD2             ; 
0050+  4FD2             ; If no device is connected or the connected device is not a CBI FDD,
0051+  4FD2             ; or if some error occurred during USB hardware or device initialization,
0052+  4FD2             ; the work area contents is all zero 
0053+  4FD2             ; (the last relative drive accessed is always preserved)
0054+  4FD2             
0055+  4FD2             
0056+  4FD2             ; -----------------------------------------------------------------------------
0057+  4FD2             ; Store the size of an endpoint.
0058+  4FD2             ;
0059+  4FD2             ; Input: A = Size
0060+  4FD2             ;        B = work area byte (0-2)
0061+  4FD2             
0062+  4FD2             WK_SET_EP_SIZE:
0063+  4FD2 DD E5           push ix
0064+  4FD4 CD 55 51        call _WK_GET_POINTER
0065+  4FD7             
0066+  4FD7 0E 00           ld c,0
0067+  4FD9 FE 08           cp 8
0068+  4FDB 28 0B           jr z,_WK_SET_EP_SIZE_DO
0069+  4FDD 0C              inc c
0070+  4FDE FE 10           cp 16
0071+  4FE0 28 06           jr z,_WK_SET_EP_SIZE_DO
0072+  4FE2 0C              inc c
0073+  4FE3 FE 20           cp 32
0074+  4FE5 28 01           jr z,_WK_SET_EP_SIZE_DO
0075+  4FE7 0C              inc c
0076+  4FE8             
0077+  4FE8             _WK_SET_EP_SIZE_DO:
0078+  4FE8 CB 09           rrc c
0079+  4FEA CB 09           rrc c
0080+  4FEC CB 09           rrc c
0081+  4FEE 7E              ld a,(hl)
0082+  4FEF E6 9F           and 10011111b   ;Clear the old size (bits 6-5)
0083+  4FF1 B1              or c
0084+  4FF2 77              ld (hl),a
0085+  4FF3 DD E1           pop ix
0086+  4FF5 C9              ret
0087+  4FF6             
0088+  4FF6             
0089+  4FF6             ; -----------------------------------------------------------------------------
0090+  4FF6             ; Zero the entire work area except the last relative drive accessed
0091+  4FF6             
0092+  4FF6             WK_ZERO:
0093+  4FF6 DD E5           push ix
0094+  4FF8 CD 61 51        call _WK_GETWRK
0095+  4FFB DD 36 00 00     ld (ix),0
0096+  4FFF DD 36 01 00     ld (ix+1),0
0097+  5003 DD 36 02 00     ld (ix+2),0
0098+  5007 DD 36 03 00     ld (ix+3),0
0099+  500B DD 36 05 00     ld (ix+5),0
0100+  500F DD 36 06 00     ld (ix+6),0
0101+  5013 DD 36 07 00     ld (ix+7),0
0102+  5017 DD 7E 04        ld a,(ix+4)
0103+  501A E6 0F           and 0Fh
0104+  501C DD 77 04        ld (ix+4),a
0105+  501F DD E1           pop ix
0106+  5021 C9              ret
0107+  5022             
0108+  5022             
0109+  5022             ; -----------------------------------------------------------------------------
0110+  5022             ; Retrieve the stored size of an endpoint.
0111+  5022             ;
0112+  5022             ; Input:  B = work area byte (0-2)
0113+  5022             ; Output: B = size
0114+  5022             
0115+  5022             WK_GET_EP_SIZE:
0116+  5022 DD E5           push ix
0117+  5024 CD 55 51        call _WK_GET_POINTER
0118+  5027 DD E1           pop ix
0119+  5029 7E              ld a,(hl)
0120+  502A 07              rlca
0121+  502B 07              rlca
0122+  502C 07              rlca
0123+  502D E6 03           and 11b
0124+  502F             
0125+  502F 06 08           ld b,8
0126+  5031 B7              or a
0127+  5032 C8              ret z
0128+  5033 CB 20           sla b
0129+  5035 3D              dec a
0130+  5036 C8              ret z
0131+  5037 CB 20           sla b
0132+  5039 3D              dec a
0133+  503A C8              ret z
0134+  503B CB 20           sla b
0135+  503D             
0136+  503D C9              ret
0137+  503E             
0138+  503E             
0139+  503E             ; -----------------------------------------------------------------------------
0140+  503E             ; Check if the work area has content 
0141+  503E             ; (meaning that a proper device is initialized and ready to use)
0142+  503E             ;
0143+  503E             ; Output: Z and NC if work area is zeroed
0144+  503E             ;         NZ if work area has contents
0145+  503E             
0146+  503E             WK_HAS_CONTENTS:
0147+  503E DD E5           push ix
0148+  5040 CD 61 51        call _WK_GETWRK
0149+  5043 7E              ld a,(hl)
0150+  5044 B7              or a
0151+  5045 DD E1           pop ix
0152+  5047 C9              ret
0153+  5048             
0154+  5048             
0155+  5048             ; -----------------------------------------------------------------------------
0156+  5048             ; Store the number of an endpoint
0157+  5048             ;
0158+  5048             ; Input: A = endpoint number
0159+  5048             ;        B = work area byte (0-2)
0160+  5048             
0161+  5048             WK_SET_EP_NUMBER:
0162+  5048 DD E5           push ix
0163+  504A CD 55 51        call _WK_GET_POINTER
0164+  504D E6 8F           and 10001111b
0165+  504F 4F              ld c,a
0166+  5050 7E              ld a,(hl)
0167+  5051 E6 F0           and 11110000b
0168+  5053 B1              or c
0169+  5054 77              ld (hl),a
0170+  5055 DD E1           pop ix
0171+  5057 C9              ret
0172+  5058             
0173+  5058             
0174+  5058             ; -----------------------------------------------------------------------------
0175+  5058             ; Retrieve the stored number of an endpoint
0176+  5058             ;
0177+  5058             ; Input:  B = work area byte (0-2)
0178+  5058             ; Output: A = endpoint number
0179+  5058             
0180+  5058             WK_GET_EP_NUMBER:
0181+  5058 DD E5           push ix
0182+  505A CD 55 51        call _WK_GET_POINTER
0183+  505D 7E              ld a,(hl)
0184+  505E E6 8F           and 10001111b
0185+  5060 DD E1           pop ix
0186+  5062 C9              ret
0187+  5063             
0188+  5063             
0189+  5063             ; -----------------------------------------------------------------------------
0190+  5063             ; Store the toggle bit status for an endpoint
0191+  5063             ;
0192+  5063             ; Input: Cy = toggle bit status
0193+  5063             ;        B  = work area byte (0-2)
0194+  5063             
0195+  5063             WK_SET_TOGGLE_BIT:
0196+  5063 DD E5           push ix
0197+  5065 CD 55 51        call _WK_GET_POINTER
0198+  5068 38 05           jr c,_WK_SET_TOGGLE_BIT_1
0199+  506A CB A6           res 4,(hl)
0200+  506C DD E1           pop ix
0201+  506E C9              ret
0202+  506F             _WK_SET_TOGGLE_BIT_1:
0203+  506F CB E6           set 4,(hl)
0204+  5071 DD E1           pop ix
0205+  5073 C9              ret
0206+  5074             
0207+  5074             
0208+  5074             ; -----------------------------------------------------------------------------
0209+  5074             ; Retrieve the stored toggle bit status for an endpoint
0210+  5074             ;
0211+  5074             ; Input: B  = work area byte (0-2)
0212+  5074             ; Output: Cy = toggle bit status
0213+  5074             
0214+  5074             WK_GET_TOGGLE_BIT:
0215+  5074 DD E5           push ix
0216+  5076 CD 55 51        call _WK_GET_POINTER
0217+  5079 CB 66           bit 4,(hl)
0218+  507B DD E1           pop ix
0219+  507D 37              scf
0220+  507E C0              ret nz
0221+  507F 3F              ccf
0222+  5080 C9              ret
0223+  5081             
0224+  5081             
0225+  5081             ; -----------------------------------------------------------------------------
0226+  5081             ; Store the interface number for the ADSC command
0227+  5081             ;
0228+  5081             ; Input: A = interface number
0229+  5081             
0230+  5081             WK_SET_IFACE_NUMBER:
0231+  5081 DD E5           push ix
0232+  5083 F5              push af
0233+  5084 CD 61 51        call _WK_GETWRK
0234+  5087 F1              pop af
0235+  5088 DD 77 03        ld (ix+3),a
0236+  508B DD E1           pop ix
0237+  508D C9              ret
0238+  508E             
0239+  508E             
0240+  508E             ; -----------------------------------------------------------------------------
0241+  508E             ; Retrieve the stored interface number for the ADSC command
0242+  508E             ;
0243+  508E             ; Output: A = interface number
0244+  508E             
0245+  508E             WK_GET_IFACE_NUMBER:
0246+  508E DD E5           push ix
0247+  5090 CD 61 51        call _WK_GETWRK
0248+  5093 DD 7E 03        ld a,(ix+3)
0249+  5096 DD E1           pop ix
0250+  5098 C9              ret
0251+  5099             
0252+  5099             
0253+  5099             ; -----------------------------------------------------------------------------
0254+  5099             ; Store information about the last USB error
0255+  5099             ; Input: A = USB error
0256+  5099             ;        D = ASC
0257+  5099             ;        E = ASCQ
0258+  5099             
0259+  5099             WK_SET_ERROR:
0260+  5099 DD E5           push ix
0261+  509B F5              push af
0262+  509C D5              push de
0263+  509D CD 61 51        call _WK_GETWRK
0264+  50A0 D1              pop de
0265+  50A1 F1              pop af
0266+  50A2 DD 77 05        ld (ix+5),a
0267+  50A5 DD 72 06        ld (ix+6),d
0268+  50A8 DD 73 07        ld (ix+7),e
0269+  50AB DD E1           pop ix
0270+  50AD C9              ret
0271+  50AE             
0272+  50AE             
0273+  50AE             ; -----------------------------------------------------------------------------
0274+  50AE             ; Retrieve the stored information about the last USB error
0275+  50AE             ; Output: A = USB error
0276+  50AE             ;         D = ASC
0277+  50AE             ;         E = ASCQ
0278+  50AE             
0279+  50AE             WK_GET_ERROR:
0280+  50AE DD E5           push ix
0281+  50B0 CD 61 51        call _WK_GETWRK
0282+  50B3 DD 7E 05        ld a,(ix+5)
0283+  50B6 DD 56 06        ld d,(ix+6)
0284+  50B9 DD 5E 07        ld e,(ix+7)
0285+  50BC DD E1           pop ix
0286+  50BE C9              ret
0287+  50BF             
0288+  50BF             
0289+  50BF             ; -----------------------------------------------------------------------------
0290+  50BF             ; Store the last accessed relative drive
0291+  50BF             ;
0292+  50BF             ; Input: A = relative drive number
0293+  50BF             
0294+  50BF             WK_SET_LAST_REL_DRIVE:
0295+  50BF C5              push bc
0296+  50C0 DD E5           push ix
0297+  50C2 F5              push af
0298+  50C3 CD 61 51        call _WK_GETWRK
0299+  50C6 DD 7E 04        ld a,(ix+4)
0300+  50C9 E6 F0           and 11110000b
0301+  50CB C1              pop bc
0302+  50CC B0              or b
0303+  50CD DD 77 04        ld (ix+4),a
0304+  50D0 DD E1           pop ix
0305+  50D2 C1              pop bc
0306+  50D3 C9              ret
0307+  50D4             
0308+  50D4             
0309+  50D4             ; -----------------------------------------------------------------------------
0310+  50D4             ; Retrieve the stored last accessed relative drive
0311+  50D4             ;
0312+  50D4             ; Output: A = relative drive number
0313+  50D4             
0314+  50D4             WK_GET_LAST_REL_DRIVE:
