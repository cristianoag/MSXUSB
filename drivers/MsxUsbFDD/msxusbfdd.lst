0176+  6B26 CD B5 42        call HWF_CREATE_DIR
0177+  6B29 C1              pop bc
0178+  6B2A D1              pop de
0179+  6B2B E1              pop hl
0180+  6B2C B7              or a
0181+  6B2D C0              ret nz
0182+  6B2E             
0183+  6B2E 78              ld a,b
0184+  6B2F B7              or a
0185+  6B30 20 05           jr nz,_DSK_WRITE_CONFIG_FILE_GO
0186+  6B32             
0187+  6B32 CD D5 42        call HWF_DELETE_FILE
0188+  6B35 AF              xor a
0189+  6B36 C9              ret
0190+  6B37             
0191+  6B37             _DSK_WRITE_CONFIG_FILE_GO:
0192+  6B37 D5              push de
0193+  6B38 C5              push bc
0194+  6B39 CD A0 42        call HWF_CREATE_FILE
0195+  6B3C C1              pop bc
0196+  6B3D E1              pop hl
0197+  6B3E B7              or a
0198+  6B3F C0              ret nz
0199+  6B40             
0200+  6B40 48              ld c,b
0201+  6B41 06 00           ld b,0
0202+  6B43 CD E4 43        call HWF_WRITE_FILE
0203+  6B46             
0204+  6B46 F5              push af
0205+  6B47 CD CA 42        call HWF_CLOSE_FILE
0206+  6B4A F1              pop af
0207+  6B4B C9              ret
