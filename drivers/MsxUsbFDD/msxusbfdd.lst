0565+  6E98 E5              push hl
0566+  6E99             
0567+  6E99                 ;Set work area as "no file mounted" for now
0568+  6E99             
0569+  6E99 CD 1D 51        call WK_GET_STORAGE_DEV_FLAGS
0570+  6E9C E6 FE           and 0FEh
0571+  6E9E CD 30 51        call WK_SET_STORAGE_DEV_FLAGS
0572+  6EA1             
0573+  6EA1                 ;Get current dir from CURDIR, save in memory
0574+  6EA1             
0575+  6EA1 FD E5           push iy
0576+  6EA3 D1              pop de
0577+  6EA4 21 5A 6E        ld hl,DSK_CURDIR_S
0578+  6EA7 06 40           ld b,64
0579+  6EA9 CD 18 6D        call DSK_READ_MAIN_CONFIG_FILE
