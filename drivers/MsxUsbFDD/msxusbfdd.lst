0139+  5A52 C1              pop bc
0140+  5A53 B8              cp b
0141+  5A54 C5              push bc
0142+  5A55 28 0F           jr z,_CHECK_SAME_DRIVE_END
0143+  5A57             
0144+  5A57 78              ld a,b
0145+  5A58 CD BF 50        call WK_SET_LAST_REL_DRIVE
0146+  5A5B DD 21 5A 62     ld ix,PROMPT
0147+  5A5F FD 21 00 00     ld iy,ROM_BANK_0
0148+  5A63 CD D2 7F        call CALL_BANK
0149+  5A66             
0150+  5A66             _CHECK_SAME_DRIVE_END:
0151+  5A66 F1              pop af
0152+  5A67 C1              pop bc
0153+  5A68 D1              pop de
0154+  5A69 E1              pop hl
0155+  5A6A C9              ret
