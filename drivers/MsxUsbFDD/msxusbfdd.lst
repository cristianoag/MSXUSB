0001+  48F5             ; MSXUSB USB FDD BIOS
0002+  48F5             ; Based on the Rookie Drive USB FDD BIOS created by Konamiman in 2018
0003+  48F5             ; This version is adapted to work with the latest version of the MSXUSB project
0004+  48F5             ;
0005+  48F5             ; This file contains the implementation of the DSKIO, DSKCHG and GETDPB
0006+  48F5             ; driver routines.
0007+  48F5             
0008+  48F5             
0009+  48F5             ; Error codes used by DSKIO, DSKCHG and GETDPB:
0010+  48F5             ;
0011+  48F5             ; 0	write protect error
0012+  48F5             ; 2	not ready error
0013+  48F5             ; 4	data (crc) error
0014+  48F5             ; 6	seek error
0015+  48F5             ; 8	record not found error
0016+  48F5             ; 10 write fault error
0017+  48F5             ; 12 other error
0018+  48F5             
0019+  48F5             
0020+  48F5             ; -----------------------------------------------------------------------------
0021+  48F5             ; DSKIO
0022+  48F5             ; -----------------------------------------------------------------------------
0023+  48F5             ; Input: 	A	Drivenumber
0024+  48F5             ;		F	Cx reset for read
0025+  48F5             ;			Cx set for write
0026+  48F5             ; 		B	number of sectors
0027+  48F5             ; 		C	Media descriptor
0028+  48F5             ;		DE	logical sectornumber
0029+  48F5             ; 		HL	transferaddress
0030+  48F5             ; Output:	F	Cx set for error
0031+  48F5             ;			Cx reset for ok
0032+  48F5             ;		A	if error, errorcode
0033+  48F5             ;		B	total count of sectors read
0034+  48F5             ; Changed:	AF,BC,DE,HL,IX,IY may be affected
0035+  48F5             ; -----------------------------------------------------------------------------
0036+  48F5             
