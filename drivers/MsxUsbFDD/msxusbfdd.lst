0001+  5A4D             ; MSXUSB USB FDD BIOS
0002+  5A4D             ; Based on the Rookie Drive USB FDD BIOS created by Konamiman in 2018
0003+  5A4D             ; This version is adapted to work with the latest version of the MSXUSB project
0004+  5A4D             ;
0005+  5A4D             ; This file contains the code for the boot menu that displays
0006+  5A4D             ; a navigable list of disk image files (available only when a
0007+  5A4D             ; standard USB mass storage device is plugged in).
0008+  5A4D             
0009+  5A4D             BM_MAX_DIR_NAME_LENGTH: equ 64
0010+  5A4D             
0011+  5A4D             ; -----------------------------------------------------------------------------
0012+  5A4D             ; Boot menu entry point
0013+  5A4D             ; 
0014+  5A4D             ; The starting point is CURDIR, or if it isn't set, the main directory.
0015+  5A4D             ;
0016+  5A4D             ; Input:  A  = Where is this called from:
0017+  5A4D             ;              0: Computer boot
0018+  5A4D             ;              1: CALL USBMENU/SUBRESET
0019+  5A4D             ; Output: A = 0 if a file was actually mounted
0020+  5A4D             ;             1 if ESC or CTRL+STOP was pressed
0021+  5A4D             ;             2 if not enough memory to start the menu
0022+  5A4D             ;             3 if no storage device is present
0023+  5A4D             ;             4 if error setting initial directory (not when F5-ing)
0024+  5A4D             ; -----------------------------------------------------------------------------
0025+  5A4D             
0026+  5A4D             DO_BOOT_MENU:
0027+  5A4D             
0028+  5A4D                 ;Return with error if no storage device was found
0029+  5A4D             
0030+  5A4D F5              push af
0031+  5A4E CD 64 51        call USB_CHECK_DEV_CHANGE
0032+  5A51 E1              pop hl
0033+  5A52             
0034+  5A52 CD EE 50        call WK_GET_STORAGE_DEV_FLAGS
0035+  5A55 3E 03           ld a,3
0036+  5A57 C8              ret z
0037+  5A58             
0038+  5A58                 ;Return with error if we have less than 1.5K of free space
0039+  5A58             
0040+  5A58 E5              push hl
0041+  5A59 21 00 00        ld hl,0
0042+  5A5C 39              add hl,sp
0043+  5A5D ED 5B C6 F6     ld de,(STREND)
0044+  5A61 B7              or a
0045+  5A62 ED 52           sbc hl,de
0046+  5A64 7C              ld a,h
0047+  5A65 FE 06           cp 6
0048+  5A67 3E 02           ld a,2
0049+  5A69 D1              pop de
0050+  5A6A D8              ret c
0051+  5A6B             
0052+  5A6B 01 8F 03        ld bc,100+660+BM_VARS_LEN   ;Work stack space + space for one page of 0s + space for variables
0053+  5A6E B7              or a
0054+  5A6F ED 42           sbc hl,bc
0055+  5A71 E5              push hl
0056+  5A72 C1              pop bc
0057+  5A73 D5              push de
