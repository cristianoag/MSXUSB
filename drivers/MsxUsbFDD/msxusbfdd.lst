0001+  6CA6             ; MSXUSB USB FDD BIOS
0002+  6CA6             ; Based on the Rookie Drive USB FDD BIOS created by Konamiman in 2018
0003+  6CA6             ; This version is adapted to work with the latest version of the MSXUSB project
0004+  6CA6             ;
0005+  6CA6             ; This file contains the code for high-level management
0006+  6CA6             ; of disk image files, including creating and accessing
0007+  6CA6             ; configuration files when needed.
0008+  6CA6             
0009+  6CA6             
0010+  6CA6             ; -----------------------------------------------------------------------------
0011+  6CA6             ; DSK_OPEN_MAIN_DIR: Open the main directory
0012+  6CA6             ; -----------------------------------------------------------------------------
0013+  6CA6             ; Output: A = 0: Ok
0014+  6CA6             ;             1: Error
0015+  6CA6             ;         Z if ok, NZ if error
0016+  6CA6             ;         Cy = 0 if root directory was open, 1 if DSK_MAIN_DIR_S was open
0017+  6CA6             
0018+  6CA6             DSK_OPEN_MAIN_DIR:
0019+  6CA6 E5              push hl
0020+  6CA7 D5              push de
0021+  6CA8 C5              push bc
0022+  6CA9 CD B0 6C        call _DSK_OPEN_MAIN_DIR
0023+  6CAC C1              pop bc
0024+  6CAD D1              pop de
0025+  6CAE E1              pop hl
0026+  6CAF C9              ret
0027+  6CB0             _DSK_OPEN_MAIN_DIR:
0028+  6CB0 21 CC 6C        ld hl,DSK_ROOT_DIR_S
0029+  6CB3 CD 66 42        call HWF_OPEN_FILE_DIR
0030+  6CB6 C0              ret nz
0031+  6CB7             
0032+  6CB7 21 CE 6C        ld hl,DSK_MAIN_DIR_S
0033+  6CBA CD 66 42        call HWF_OPEN_FILE_DIR
0034+  6CBD 20 02           jr nz,_DSK_OPEN_MAIN_REOPEN_ROOT
0035+  6CBF 38 08           jr c,_DSK_OPEN_MAIN_WAS_MSX
0036+  6CC1             
0037+  6CC1             _DSK_OPEN_MAIN_REOPEN_ROOT:
0038+  6CC1 21 CC 6C        ld hl,DSK_ROOT_DIR_S
0039+  6CC4 CD 66 42        call HWF_OPEN_FILE_DIR
0040+  6CC7             _DSK_OPEN_MAIN_END:
0041+  6CC7 B7              or a    ;If error, set NZ; if ok, set Z and NC
0042+  6CC8 C9              ret
0043+  6CC9             
0044+  6CC9             _DSK_OPEN_MAIN_WAS_MSX:
0045+  6CC9 AF              xor a
0046+  6CCA 37              scf
0047+  6CCB C9              ret
0048+  6CCC             
0049+  6CCC             DSK_ROOT_DIR_S:
