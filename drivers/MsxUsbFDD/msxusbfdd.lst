0109+  462F CD 90 46        call PRINT_HEX
0110+  4632 21 9E 48        ld hl,DEVERR_NAKS_S
0111+  4635 CD 87 46        call PRINT
0112+  4638 3A 98 FD        ld a,(USB_INIT_NAK_COUNT+1)
0113+  463B CD 90 46        call PRINT_HEX
