0347+  40EC 06 00           ld b,0
0348+  40EE 1E 00           ld e,0
0349+  40F0 3E 40           ld a,40h    ;Toggle bit = 1
0350+  40F2 CD AE 41        call _CH_OUT_PACKET
0351+  40F5             
0352+  40F5 C1              pop bc
0353+  40F6 C9              ret
