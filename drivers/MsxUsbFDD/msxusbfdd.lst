0974+  4D1A~                jp CALSLT
0975+  4D1A~            
0976+  4D1A~            PRINTSPACE:
0977+  4D1A~                ld a," "
0978+  4D1A~            PRINTBIOS:
0979+  4D1A~                ld ix,CHPUT
0980+  4D1A~                jp CALBIOS
0981+  4D1A~            
0982+  4D1A~            PRINTHEXBIOS_HL:
0983+  4D1A~                ld a,h
0984+  4D1A~                call PRINTHEXBIOS
0985+  4D1A~                ld a,l
0986+  4D1A~            PRINTHEXBIOS:
0987+  4D1A~                push af
0988+  4D1A~            	call	_PRINTHEXBIOS1
0989+  4D1A~            	pop af
0990+  4D1A~            	jr	_PRINTHEXBIOS2
0991+  4D1A~            
0992+  4D1A~            _PRINTHEXBIOS1:	rra
0993+  4D1A~            	rra
0994+  4D1A~            	rra
0995+  4D1A~            	rra
0996+  4D1A~            _PRINTHEXBIOS2:	or	0F0h
0997+  4D1A~            	daa
0998+  4D1A~            	add	a,0A0h
0999+  4D1A~            	adc	a,40h
1000+  4D1A~            
1001+  4D1A~            	call PRINTBIOS
1002+  4D1A~            	ret
1003+  4D1A~            
1004+  4D1A                 endif
0057   4D1A                 include "bank1/choice_dskfmt.asm"    
0001+  4D1A             ; MSXUSB USB FDD BIOS
0002+  4D1A             ; Based on the Rookie Drive USB FDD BIOS created by Konamiman in 2018
0003+  4D1A             ; This version is adapted to work with the latest version of the MSXUSB project
0004+  4D1A             ;
0005+  4D1A             ; This file contains the implementation of the CHOICE and DSKFMT
0006+  4D1A             ; driver routines.
0007+  4D1A             
0008+  4D1A             
0009+  4D1A             ; Error codes used by DSKFMT:
0010+  4D1A             ;
0011+  4D1A             ; 0	write protect error
0012+  4D1A             ; 2	not ready error
0013+  4D1A             ; 4	data (crc) error
0014+  4D1A             ; 6	seek error
0015+  4D1A             ; 8	record not found error
0016+  4D1A             ; 10 write fault error
0017+  4D1A             ; 12 bad parameter
0018+  4D1A             ; 14 insufficient memory
0019+  4D1A             ; 16 other error
0020+  4D1A             
0021+  4D1A             
0022+  4D1A             ; -----------------------------------------------------------------------------
0023+  4D1A             ; CHOICE
0024+  4D1A             ; -----------------------------------------------------------------------------
0025+  4D1A             ; Input: 	None
0026+  4D1A             ; Output:	HL	pointer to choice string, 0 if no choice
0027+  4D1A             ; Changed:	AF,BC,DE,HL,IX,IY may be affected
0028+  4D1A             ; -----------------------------------------------------------------------------
0029+  4D1A             
0030+  4D1A             CHOICE_IMPL:
0031+  4D1A CD 1D 51        call WK_GET_STORAGE_DEV_FLAGS
0032+  4D1D 21 00 00        ld hl,0
0033+  4D20 C0              ret nz
0034+  4D21             
0035+  4D21 21 D9 74        ld hl,CHOICE_S
0036+  4D24 C9              ret
0037+  4D25             
0038+  4D25             
0039+  4D25             ; -----------------------------------------------------------------------------
0040+  4D25             ; DSKFMT
0041+  4D25             ; -----------------------------------------------------------------------------
0042+  4D25             ; Input: 	A	choicecode (1-9)
0043+  4D25             ;		D	drivenumber
0044+  4D25             ;		HL	begin of workarea
0045+  4D25             ;		BC	length of workarea
0046+  4D25             ; Output:	F	Cx set for error
0047+  4D25             ;			Cx reset for ok
0048+  4D25             ;		A	if error, errorcode
0049+  4D25             ; Changed:	AF,BC,DE,HL,IX,IY may be affected
0050+  4D25             ; -----------------------------------------------------------------------------
0051+  4D25             
0052+  4D25             DSKFMT_IMPL:
0053+  4D25 4F              ld c,a
0054+  4D26 7A              ld a,d
0055+  4D27 CD 47 5A        call CHECK_SAME_DRIVE
0056+  4D2A             
0057+  4D2A CD 1D 51        call WK_GET_STORAGE_DEV_FLAGS
0058+  4D2D 3E 10           ld a,16
0059+  4D2F 37              scf
0060+  4D30 C0              ret nz
0061+  4D31             
0062+  4D31 C5              push bc
0063+  4D32 CD 23 4C        call DSKCHG_IMPL    ;To eat a possible "not ready" error reported by
0064+  4D35 C1              pop bc              ;the device on disk change
0065+  4D36             
0066+  4D36 0D              dec c
0067+  4D37             
0068+  4D37                 ;Now C = bit 0: 0 for full format, 1 for quick format
0069+  4D37                 ;        bit 1: 0 for 720K, 1 for 1440K
0070+  4D37             
0071+  4D37 CB 19           rr c
0072+  4D39 38 09           jr c,_DSKFMT_QUICK
0073+  4D3B             
0074+  4D3B             _DSKFMT_FULL:
0075+  4D3B C5              push bc
0076+  4D3C CB 19           rr c
0077+  4D3E CD 58 4D        call PHYSICAL_FORMAT
0078+  4D41 C1              pop bc
0079+  4D42 38 0C           jr c,_DSKFMT_END_ERR
0080+  4D44             
0081+  4D44             _DSKFMT_QUICK:
0082+  4D44 CB 19           rr c
0083+  4D46 CD 46 4E        call LOGICAL_FORMAT
0084+  4D49 38 05           jr c,_DSKFMT_END_ERR
0085+  4D4B C9              ret
0086+  4D4C             
0087+  4D4C             _DSKFMT_BAD_PARAM:
0088+  4D4C 3E 0C           ld a,12
0089+  4D4E 37              scf
0090+  4D4F C9              ret
0091+  4D50             
0092+  4D50             _DSKFMT_END_ERR:
0093+  4D50 FE 0C           cp 12
0094+  4D52 20 02           jr nz,_DSKFMT_END_ERR2
0095+  4D54 3E 10           ld a,16
0096+  4D56             _DSKFMT_END_ERR2:
0097+  4D56 37              scf
0098+  4D57 C9              ret
0099+  4D58             
0100+  4D58             
0101+  4D58             ; ----------------------------------------------------------------------------
0102+  4D58             ; PHYSICAL_FORMAT
0103+  4D58             ; ----------------------------------------------------------------------------
0104+  4D58             ; Input:  Cy = 0 for 720K disk, 1 for 1.44M disk
0105+  4D58             ; Output: Cy = 0 if ok
0106+  4D58             ;         Cy = 1 and A=DSKFMT error code on error
0107+  4D58             
0108+  4D58             _PHYSICAL_FORMAT_STACK_SPACE: equ 12
0109+  4D58             _PHYSICAL_FORMAT_TRACKS_PER_SIDE_COUNT: equ 80
0110+  4D58             
0111+  4D58             PHYSICAL_FORMAT:
0112+  4D58                 if HW_IMPL_CONFIGURE_NAK_RETRY=1
0113+  4D58             
0114+  4D58 F5              push af
0115+  4D59 37              scf
0116+  4D5A CD 3D 44        call HW_CONFIGURE_NAK_RETRY
0117+  4D5D F1              pop af
0118+  4D5E CD 68 4D        call _PHYSICAL_FORMAT
0119+  4D61 F5              push af
0120+  4D62 B7              or a
0121+  4D63 CD 3D 44        call HW_CONFIGURE_NAK_RETRY
0122+  4D66 F1              pop af
0123+  4D67 C9              ret
0124+  4D68             _PHYSICAL_FORMAT:
0125+  4D68             
0126+  4D68                 endif
0127+  4D68             
0128+  4D68 21 FE 4D        ld hl,_UFI_FORMAT_UNIT_DATA_720K_SIDE_0
0129+  4D6B 30 03           jr nc,_PHYSICAL_FORMAT_2
0130+  4D6D 21 22 4E        ld hl,_UFI_FORMAT_UNIT_DATA_1440K_SIDE_0
0131+  4D70             _PHYSICAL_FORMAT_2:
0132+  4D70             
0133+  4D70 3E 06           ld a,6
0134+  4D72 CD 6B 5A        call DO_SNSMAT
0135+  4D75 E6 01           and 1
0136+  4D77 20 1C           jr nz,_PHYSICAL_FORMAT_DO_TRACK_BY_TRACK
0137+  4D79             
0138+  4D79                 ;Usually devices implement single track formatting only,
0139+  4D79                 ;so by default we'll format all the tracks one by one in a loop.
0140+  4D79                 ;However the single all tracks format command will be used
0141+  4D79                 ;if SHIFT is pressed (together with any other key)
0142+  4D79                 ;when the "Strike a key when ready" command is presented.
0143+  4D79             
0144+  4D79             _PHYSICAL_FORMAT_DO_ALL_TRACKS:
0145+  4D79 01 18 00        ld bc,24
0146+  4D7C 09              add hl,bc   ;Point to the _ALL_TRACKS command data
0147+  4D7D             
0148+  4D7D EB              ex de,hl
0149+  4D7E 21 F2 4D        ld hl,_UFI_FORMAT_UNIT_CMD
0150+  4D81 01 0C 00        ld bc,12
0151+  4D84 3E 01           ld a,1
0152+  4D86 37              scf
0153+  4D87 CD F2 56        call USB_EXECUTE_CBI_WITH_RETRY
0154+  4D8A             
0155+  4D8A B7              or a
0156+  4D8B 3E 0C           ld a,12
0157+  4D8D 37              scf
0158+  4D8E C0              ret nz
0159+  4D8F             
0160+  4D8F 7A              ld a,d  ;non-zero ASC?
0161+  4D90 B7              or a
0162+  4D91 C8              ret z
0163+  4D92             
0164+  4D92 C3 DA 59        jp ASC_TO_ERR
0165+  4D95             
0166+  4D95             _PHYSICAL_FORMAT_DO_TRACK_BY_TRACK:
0167+  4D95 DD 21 F4 FF     ld ix,-_PHYSICAL_FORMAT_STACK_SPACE
0168+  4D99 DD 39           add ix,sp
0169+  4D9B DD F9           ld sp,ix
0170+  4D9D             
0171+  4D9D E5              push hl
0172+  4D9E DD E5           push ix
0173+  4DA0 D1              pop de
0174+  4DA1 21 F2 4D        ld hl,_UFI_FORMAT_UNIT_CMD
0175+  4DA4 01 0C 00        ld bc,12
0176+  4DA7 ED B0           ldir
0177+  4DA9 E1              pop hl
0178+  4DAA             
0179+  4DAA E5              push hl
0180+  4DAB CD C5 4D        call _PHYSICAL_FORMAT_ONE_SIDE
0181+  4DAE E1              pop hl
0182+  4DAF 38 07           jr c,_PHYSICAL_FORMAT_END
0183+  4DB1 01 0C 00        ld bc,12
0184+  4DB4 09              add hl,bc   ;Switch to the _SIDE_1 command
0185+  4DB5 CD C5 4D        call _PHYSICAL_FORMAT_ONE_SIDE
0186+  4DB8             
0187+  4DB8             _PHYSICAL_FORMAT_END:
0188+  4DB8 F5              push af
0189+  4DB9 E1              pop hl
0190+  4DBA DD 21 0C 00     ld ix,_PHYSICAL_FORMAT_STACK_SPACE
0191+  4DBE DD 39           add ix,sp
0192+  4DC0 DD F9           ld sp,ix
0193+  4DC2 E5              push hl
0194+  4DC3 F1              pop af
0195+  4DC4 C9              ret
0196+  4DC5             
0197+  4DC5                 ;Format all the tracks on one side of the disk
0198+  4DC5                 ;Input: IX=Command, HL=Data
0199+  4DC5             
0200+  4DC5             _PHYSICAL_FORMAT_ONE_SIDE:
0201+  4DC5 06 00           ld b,0  ;Track number
0202+  4DC7             
0203+  4DC7             _PHYSICAL_FORMAT_TRACK_LOOP:
0204+  4DC7 DD 70 02        ld (ix+2),b
0205+  4DCA             
0206+  4DCA DD E5           push ix
0207+  4DCC E5              push hl
0208+  4DCD C5              push bc
0209+  4DCE             
0210+  4DCE EB              ex de,hl
0211+  4DCF DD E5           push ix
0212+  4DD1 E1              pop hl
0213+  4DD2 01 0C 00        ld bc,12
0214+  4DD5 3E 01           ld a,1
0215+  4DD7 37              scf
0216+  4DD8 CD F2 56        call USB_EXECUTE_CBI_WITH_RETRY
0217+  4DDB             
0218+  4DDB C1              pop bc
0219+  4DDC E1              pop hl
0220+  4DDD DD E1           pop ix
0221+  4DDF             
0222+  4DDF B7              or a
0223+  4DE0 3E 0C           ld a,12
0224+  4DE2 37              scf
0225+  4DE3 C0              ret nz
0226+  4DE4             
0227+  4DE4 7A              ld a,d  ;non-zero ASC?
0228+  4DE5 B7              or a
0229+  4DE6 28 03           jr z,_PHYSICAL_FORMAT_NEXT_TRACK
0230+  4DE8             
0231+  4DE8 C3 DA 59        jp ASC_TO_ERR
0232+  4DEB             
0233+  4DEB             _PHYSICAL_FORMAT_NEXT_TRACK:
0234+  4DEB 04              inc b
0235+  4DEC 78              ld a,b
0236+  4DED FE 50           cp _PHYSICAL_FORMAT_TRACKS_PER_SIDE_COUNT
0237+  4DEF 38 D6           jr c,_PHYSICAL_FORMAT_TRACK_LOOP
0238+  4DF1 C9              ret
0239+  4DF2             
0240+  4DF2             
0241+  4DF2             _UFI_FORMAT_UNIT_CMD:
0242+  4DF2                 db 4, 17h, 0, 0, 0, 0, 0, 0, 12, 0, 0, 0
0242+  4DF2 04170000000000000C000000
0243+  4DFE             
0244+  4DFE             _UFI_FORMAT_UNIT_DATA_720K_SIDE_0:
0245+  4DFE                 db 0, 0B0h, 0, 8, 0, 0, 05h, 0A0h, 0, 0, 2, 0
0245+  4DFE 00B00008000005A000000200
0246+  4E0A             _UFI_FORMAT_UNIT_DATA_720K_SIDE_1:
0247+  4E0A                 db 0, 0B1h, 0, 8, 0, 0, 05h, 0A0h, 0, 0, 2, 0
0247+  4E0A 00B10008000005A000000200
0248+  4E16             _UFI_FORMAT_UNIT_DATA_720K_ALL_TRACKS:
0249+  4E16                 db 0, 0A0h, 0, 8, 0, 0, 05h, 0A0h, 0, 0, 2, 0
0249+  4E16 00A00008000005A000000200
0250+  4E22             
0251+  4E22             _UFI_FORMAT_UNIT_DATA_1440K_SIDE_0:
0252+  4E22                 db 0, 0B0h, 0, 8, 0, 0, 0Bh, 040h, 0, 0, 2, 0
0252+  4E22 00B0000800000B4000000200
0253+  4E2E             _UFI_FORMAT_UNIT_DATA_1440K_SIDE_1:
0254+  4E2E                 db 0, 0B1h, 0, 8, 0, 0, 0Bh, 040h, 0, 0, 2, 0
0254+  4E2E 00B1000800000B4000000200
0255+  4E3A             _UFI_FORMAT_UNIT_DATA_1440K_ALL_TRACKS:
0256+  4E3A                 db 0, 0A0h, 0, 8, 0, 0, 0Bh, 040h, 0, 0, 2, 0    
0256+  4E3A 00A0000800000B4000000200
0257+  4E46             
0258+  4E46             
0259+  4E46             ; ----------------------------------------------------------------------------
0260+  4E46             ; LOGICAL_FORMAT
0261+  4E46             ;
0262+  4E46             ; Initializes boot sector, FAT and root directory of the disk.
0263+  4E46             ;
0264+  4E46             ; MSX-DOS 1 doesn't support the standard 1.44MB format because this format
0265+  4E46             ; uses 9 sectors per FAT, but DOS 1 loads the entire FAT in memory after
0266+  4E46             ; having allocated just 1.5K (worth 3 sectors) for it.
0267+  4E46             ; There isn't any validation so the computer just crashes.
0268+  4E46             ;
0269+  4E46             ; As a workaround for the above, this BIOS will apply a custom format
0270+  4E46             ; of 3 sectors/FAT and 4 sectors/cluster when a 1.44MB is formatted
0271+  4E46             ; in DOS 1 mode (I know, the driver shouldn't be aware of the DOS version
0272+  4E46             ; under which it exists, but this is not a perfect world); in DOS2 mode
0273+  4E46             ; the standard 9 sectors/FAT and 1 sector/cluster format will be applied.
0274+  4E46             ; ----------------------------------------------------------------------------
0275+  4E46             ; Input:  Cy = 0 for 720K disk
0276+  4E46             ;              1 for 1.44M disk
0277+  4E46             ; Output: Cy = 0 if ok
0278+  4E46             ;         Cy = 1 and A=DSKFMT error code on error
0279+  4E46             
0280+  4E46             LOGICAL_FORMAT:
0281+  4E46 21 AE 4F        ld hl,BOOT_PARAMETERS_720K
0282+  4E49 30 0C           jr nc,_LOGICAL_FORMAT_DO
0283+  4E4B 21 C6 4F        ld hl,BOOT_PARAMETERS_1440K_DOS1
0284+  4E4E 3A 13 F3        ld a,(DOSVER)   ;We shouldn't do this but :shrug:
0285+  4E51 B7              or a
0286+  4E52 28 03           jr z,_LOGICAL_FORMAT_DO
0287+  4E54 21 BA 4F        ld hl,BOOT_PARAMETERS_1440K
0288+  4E57             
0289+  4E57             _LOGICAL_FORMAT_DO:
0290+  4E57             
0291+  4E57                 ;>>> Step 1: write boot sector
0292+  4E57             
0293+  4E57 E5              push hl
0294+  4E58 CD F5 4E        call _LOGICAL_FORMAT_ZERO_SECBUF
0295+  4E5B 21 03 4F        ld hl,BOOT_SECTOR
0296+  4E5E ED 5B 4D F3     ld de,(SECBUF)
0297+  4E62 01 AB 00        ld bc,BOOT_SECTOR_END-BOOT_SECTOR
0298+  4E65 ED B0           ldir
0299+  4E67             
0300+  4E67 2A 4D F3        ld hl,(SECBUF)
0301+  4E6A 01 0D 00        ld bc,BOOT_DISK_PARAMETERS-BOOT_SECTOR
0302+  4E6D 09              add hl,bc
0303+  4E6E EB              ex de,hl    ;DE = Position of variable disk parameters in SECBUF
0304+  4E6F E1              pop hl
0305+  4E70 E5              push hl
0306+  4E71 01 0C 00        ld bc,BOOT_DISK_PARAMETERS_END-BOOT_DISK_PARAMETERS
0307+  4E74 ED B0           ldir
0308+  4E76             
0309+  4E76 11 00 00        ld de,0
0310+  4E79 06 01           ld b,1
0311+  4E7B CD D3 4E        call _LOGICAL_FORMAT_WR_SECTORS
0312+  4E7E DD E1           pop ix
0313+  4E80 D8              ret c
0314+  4E81             
0315+  4E81                 ;>>> Step 2: write first sector of both copies of FAT
0316+  4E81             
0317+  4E81 CD F5 4E        call _LOGICAL_FORMAT_ZERO_SECBUF
0318+  4E84             
0319+  4E84 2A 4D F3        ld hl,(SECBUF)
0320+  4E87 DD 7E 08        ld a,(ix+8) ;Media ID
0321+  4E8A 77              ld (hl),a
0322+  4E8B 23              inc hl
0323+  4E8C 3E FF           ld a,0FFh
0324+  4E8E 77              ld (hl),a
0325+  4E8F 23              inc hl
0326+  4E90 77              ld (hl),a   ;SECBUF contains now the initialized first FAT sector
0327+  4E91             
0328+  4E91 11 01 00        ld de,1
0329+  4E94 06 01           ld b,1
0330+  4E96 CD D3 4E        call _LOGICAL_FORMAT_WR_SECTORS  ;Write first sector of first FAT
0331+  4E99 D8              ret c
0332+  4E9A             
0333+  4E9A DD 5E 09        ld e,(ix+9) ;Sectors per FAT
0334+  4E9D 1C              inc e  ;DE = First sector of second FAT (skip boot sector + 1st FAT)
0335+  4E9E 16 00           ld d,0
0336+  4EA0 06 01           ld b,1
0337+  4EA2 CD D3 4E        call _LOGICAL_FORMAT_WR_SECTORS
0338+  4EA5 D8              ret c
0339+  4EA6             
0340+  4EA6                 ;>>> Step 3: clear the rest of the first FAT
0341+  4EA6             
0342+  4EA6 CD F5 4E        call _LOGICAL_FORMAT_ZERO_SECBUF
0343+  4EA9             
0344+  4EA9 DD 46 09        ld b,(ix+9) ;Sectors per FAT
0345+  4EAC 05              dec b   ;First sector is already initialized
0346+  4EAD 11 02 00        ld de,2 ;Skip boot sector + 1st sector of first FAT
0347+  4EB0 CD D3 4E        call _LOGICAL_FORMAT_WR_SECTORS
0348+  4EB3 D8              ret c
0349+  4EB4             
0350+  4EB4                 ;>>> Step 4: clear the rest of the second FAT and the root directory
0351+  4EB4             
0352+  4EB4 06 00           ld b,0
0353+  4EB6 DD 4E 04        ld c,(ix+4)   ;Root directory entries
0354+  4EB9 CB 39           srl c
0355+  4EBB CB 39           srl c
0356+  4EBD CB 39           srl c
0357+  4EBF CB 39           srl c   ;BC = sectors for the root directory
0358+  4EC1             
0359+  4EC1 26 00           ld h,0
0360+  4EC3 DD 6E 09        ld l,(ix+9) ;Sectors per FAT
0361+  4EC6 2B              dec hl  ;First sector is already initialized
0362+  4EC7 09              add hl,bc
0363+  4EC8 45              ld b,l  ;B = How many sectors to clear (second FAT except 1st sector + root directory)
0364+  4EC9             
0365+  4EC9 16 00           ld d,0
0366+  4ECB DD 5E 09        ld e,(ix+9)
0367+  4ECE 1C              inc e
0368+  4ECF 1C              inc e   ;DE = First sector to clear (skip 1st FAT + boot sector + 1st sector of second FAT)
0369+  4ED0             
0370+  4ED0 C3 D3 4E        jp _LOGICAL_FORMAT_WR_SECTORS
0371+  4ED3             
0372+  4ED3             
0373+  4ED3                 ;--- Write the contents of SECBUF repeatedly in a range of sectors
0374+  4ED3                 ;    Input: DE = first sector, B = how many sectors
0375+  4ED3             
0376+  4ED3             _LOGICAL_FORMAT_WR_SECTORS:
0377+  4ED3 DD E5           push ix
0378+  4ED5 D5              push de
0379+  4ED6 C5              push bc
0380+  4ED7 CD D4 50        call WK_GET_LAST_REL_DRIVE
0381+  4EDA C1              pop bc
0382+  4EDB D1              pop de
0383+  4EDC 67              ld h,a
0384+  4EDD             _LOGICAL_FORMAT_WR_SECTORS_LOOP:    
0385+  4EDD C5              push bc
0386+  4EDE D5              push de
0387+  4EDF E5              push hl
0388+  4EE0 7C              ld a,h
0389+  4EE1 2A 4D F3        ld hl,(SECBUF)
0390+  4EE4 06 01           ld b,1
0391+  4EE6 37              scf
0392+  4EE7 CD 24 49        call DSKIO_IMPL
0393+  4EEA E1              pop hl
0394+  4EEB D1              pop de
0395+  4EEC C1              pop bc
0396+  4EED 38 03           jr c,_LOGICAL_FORMAT_WR_SECTORS_LOOP_END
0397+  4EEF 13              inc de
0398+  4EF0 10 EB           djnz _LOGICAL_FORMAT_WR_SECTORS_LOOP
0399+  4EF2             _LOGICAL_FORMAT_WR_SECTORS_LOOP_END:
0400+  4EF2 DD E1           pop ix
0401+  4EF4 C9              ret
0402+  4EF5             
0403+  4EF5             _LOGICAL_FORMAT_ZERO_SECBUF:
0404+  4EF5 2A 4D F3        ld hl,(SECBUF)
0405+  4EF8 E5              push hl
0406+  4EF9 D1              pop de
0407+  4EFA 13              inc de
0408+  4EFB 36 00           ld (hl),0
