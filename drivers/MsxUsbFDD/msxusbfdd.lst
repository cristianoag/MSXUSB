0327+  50B2             
0328+  50B2             WK_SET_MISC_FLAGS:
0329+  50B2 C5              push bc
0330+  50B3 DD E5           push ix
0331+  50B5 07              rlca
0332+  50B6 07              rlca
0333+  50B7 07              rlca
0334+  50B8 07              rlca
0335+  50B9 E6 F0           and 11110000b
0336+  50BB F5              push af
0337+  50BC CD 32 51        call _WK_GETWRK
0338+  50BF DD 7E 04        ld a,(ix+4)
0339+  50C2 E6 0F           and 00001111b
0340+  50C4 C1              pop bc
0341+  50C5 B0              or b
0342+  50C6 DD 77 04        ld (ix+4),a
0343+  50C9 DD E1           pop ix
0344+  50CB C1              pop bc
0345+  50CC C9              ret
0346+  50CD             
0347+  50CD             
0348+  50CD             ; -----------------------------------------------------------------------------
0349+  50CD             ; Retrieve the misc flags
0350+  50CD             ;
0351+  50CD             ; Input: A = misc flags (in low nibble)
0352+  50CD             
0353+  50CD             WK_GET_MISC_FLAGS:
0354+  50CD DD E5           push ix
0355+  50CF CD 32 51        call _WK_GETWRK
0356+  50D2 DD 7E 04        ld a,(ix+4)
0357+  50D5 DD E1           pop ix
0358+  50D7 E6 F0           and 11110000b
0359+  50D9 C8              ret z
0360+  50DA 0F              rrca
0361+  50DB 0F              rrca
0362+  50DC 0F              rrca
0363+  50DD 0F              rrca
0364+  50DE C9              ret
0365+  50DF             
0366+  50DF             
0367+  50DF             ; -----------------------------------------------------------------------------
0368+  50DF             ; Initialize work area for a storage device
0369+  50DF             
0370+  50DF             WK_INIT_FOR_STORAGE_DEV:
0371+  50DF CD C7 4F        call WK_ZERO
0372+  50E2 CD 32 51        call _WK_GETWRK
0373+  50E5 DD 36 00 80     ld (ix),80h
0374+  50E9 DD 36 01 00     ld (ix+1),0
0375+  50ED C9              ret
0376+  50EE             
0377+  50EE             
0378+  50EE             ; -----------------------------------------------------------------------------
0379+  50EE             ; Retrieve the storage device flags
0380+  50EE             ;
0381+  50EE             ; Output: A = storage device flags byte
0382+  50EE             ;         NZ if a storage device is connected, Z otherwise
0383+  50EE             
0384+  50EE             WK_GET_STORAGE_DEV_FLAGS:
0385+  50EE E5              push hl
0386+  50EF D5              push de
0387+  50F0 C5              push bc
0388+  50F1 DD E5           push ix
0389+  50F3 CD 32 51        call _WK_GETWRK
0390+  50F6 DD 7E 00        ld a,(ix)
0391+  50F9 DD E1           pop ix
0392+  50FB C1              pop bc
0393+  50FC D1              pop de
0394+  50FD E1              pop hl
0395+  50FE CB 7F           bit 7,a
0396+  5100 C9              ret
0397+  5101             
0398+  5101             
0399+  5101             ; -----------------------------------------------------------------------------
0400+  5101             ; Set the storage device flags
0401+  5101             ;
0402+  5101             ; Input: A = storage device flags byte
0403+  5101             
0404+  5101             WK_SET_STORAGE_DEV_FLAGS:
0405+  5101 DD E5           push ix
0406+  5103 F5              push af
0407+  5104 CD 32 51        call _WK_GETWRK
0408+  5107 F1              pop af
0409+  5108 DD 77 00        ld (ix),a
0410+  510B DD E1           pop ix
0411+  510D C9              ret
0412+  510E             
0413+  510E             
0414+  510E             ; -----------------------------------------------------------------------------
0415+  510E             ; Retrieve the current directory depth for the storage device
0416+  510E             ;
0417+  510E             ; Output: A = current directory depth
0418+  510E             
0419+  510E             WK_GET_CUR_DIR_DEPTH:
0420+  510E DD E5           push ix
0421+  5110 CD 32 51        call _WK_GETWRK
0422+  5113 DD 7E 01        ld a,(ix+1)
0423+  5116 DD E1           pop ix
0424+  5118 C9              ret
0425+  5119             
0426+  5119             
0427+  5119             ; -----------------------------------------------------------------------------
0428+  5119             ; Set the current directory depth for the storage device
0429+  5119             ;
0430+  5119             ; Input: A = directory depth to set
0431+  5119             
0432+  5119             WK_SET_CUR_DIR_DEPTH:
0433+  5119 DD E5           push ix
0434+  511B F5              push af
0435+  511C CD 32 51        call _WK_GETWRK
0436+  511F F1              pop af
0437+  5120 DD 77 01        ld (ix+1),a
0438+  5123 DD E1           pop ix
0439+  5125 C9              ret
0440+  5126             
0441+  5126             
0442+  5126             ; -----------------------------------------------------------------------------
0443+  5126             ; Get the storage address for a given work area value
0444+  5126             ;
0445+  5126             ; Input: B = value index (0-7)
0446+  5126             ; Output: HL = storage address for that value in work area
0447+  5126             
0448+  5126             _WK_GET_POINTER:
0449+  5126 F5              push af
0450+  5127 C5              push bc
0451+  5128 CD 32 51        call _WK_GETWRK
0452+  512B C1              pop bc
0453+  512C 48              ld c,b
0454+  512D 06 00           ld b,0
0455+  512F 09              add hl,bc
0456+  5130 F1              pop af
0457+  5131 C9              ret
0458+  5132             
0459+  5132             
0460+  5132             ; -----------------------------------------------------------------------------
0461+  5132             ; Get the base address of work area for our slot
0462+  5132             ;
0463+  5132             ; This is the GETWRK routine copied from the kernel code with a small change:
0464+  5132             ; the address of the SLTWRK entry is returned directly, the original code
0465+  5132             ; assumes that at offset +2 there's a pointer for allocated space in page 3
0466+  5132             ; and returns this pointer.
0467+  5132             ;
0468+  5132             ; Output: HL = IX = pointer to 8 byte area for the slot in SLTWRK
0469+  5132             
0470+  5132             _WK_GETWRK:
0471+  5132 CD 3B 51    	call _WK_GETSLTWRK			; get my SLTWRK entry
0472+  5135 2B              dec hl
0473+  5136 2B              dec hl
0474+  5137 E5          	push hl
0475+  5138 DD E1       	pop	ix
0476+  513A C9          	ret
0477+  513B             
0478+  513B             ;	Subroutine	get my SLTWRK entry
0479+  513B             ;	Inputs		-
0480+  513B             ;	Outputs		HL = pointer to SLTWRK entry
0481+  513B             
0482+  513B             _WK_GETSLTWRK:
0483+  513B CD 55 51    	call _WK_GETEXPTBL			; get my primairy slot
0484+  513E 87          	add	a,a
0485+  513F 87          	add	a,a
0486+  5140 87          	add	a,a
0487+  5141 37          	scf
0488+  5142 8F          	adc	a,a			; primary slot*4 + 1
0489+  5143 4F          	ld c,a
0490+  5144 7E          	ld a,(hl)
0491+  5145 87          	add	a,a
0492+  5146 9F          	sbc	a,a
0493+  5147 E6 0C       	and	00CH			; 0 for non expanded, 0CH for expanded
0494+  5149 23          	inc	hl
0495+  514A 23          	inc	hl
0496+  514B 23          	inc	hl
0497+  514C 23          	inc	hl
0498+  514D A6          	and	(hl)
0499+  514E B1          	or c
0500+  514F 87          	add	a,a			; word entries
0501+  5150 21 09 FD    	ld hl,SLTWRK
