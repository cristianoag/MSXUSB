0060   581D                 include "bank1/diag_ep0.asm"
0001+  581D             ; MSXUSB USB FDD BIOS
0002+  581D             ; Based on the Rookie Drive USB FDD BIOS created by Konamiman in 2018
0003+  581D             ; This version is adapted to work with the latest version of the MSXUSB project
0004+  581D             ;
0005+  581D             ; This file contains endpoint 0 transfer experiments, used to find out
0006+  581D             ; why some devices (e.g. TEAC FD-05PUB, which has an endpoint 0 max packet size
0007+  581D             ; of 8 bytes) don't deliver the second packet of a control transfer data stage.
0008+  581D             ; They run when the device initialization fails when getting descriptors
0009+  581D             ; (only if EP0_DIAGNOSTICS=1), and print one result line per experiment:
0010+  581D             ;
0011+  581D             ; DD: First 8 bytes of the device descriptor, at address 0
0012+  581D             ; T0: GET_DESCRIPTOR(18): SETUP, IN DATA1, IN DATA0 (the normal sequence)
0013+  581D             ; T1: Same, but expecting DATA1 again in the second IN
0014+  581D             ; D5: Same as T0, with a 5ms delay before the second IN
0015+  581D             ; BI: CH376 built-in GET_DESCR for the device descriptor (B2: configuration descriptor)
0016+  581D             ; SC: SET_CONFIGURATION(1): SETUP, status IN
0017+  581D             ; AD: CBI ADSC with a 12 byte TEST UNIT READY command:
0018+  581D             ;     SETUP, OUT 8 bytes, OUT 4 bytes, status IN
0019+  581D             ;
0020+  581D             ; For each stage the raw CH376 status is printed, and for IN stages
0021+  581D             ; also the number of bytes received ("status/count"). 14 means success,
0022+  581D             ; 2A is NAK, 2E is STALL, 20 is timeout.
0023+  581D             
0024+  581D                 if EP0_DIAGNOSTICS = 1
0025+  581D             
0026+  581D             DIAG_EP0_BUF_SIZE: equ 72
0027+  581D             
0028+  581D             DIAG_EP0:
0029+  581D DD 21 B8 FF     ld ix,-DIAG_EP0_BUF_SIZE
0030+  5821 DD 39           add ix,sp
0031+  5823 DD F9           ld sp,ix
0032+  5825             
0033+  5825                 ;--- Enumerate the device again until SET_ADDRESS,
0034+  5825                 ;    it's the same sequence that USB_INIT_DEV follows
0035+  5825             
0036+  5825 CD 0A 42        call HW_BUS_RESET
0037+  5828 DD E5           push ix
0038+  582A DD E5           push ix
0039+  582C D1              pop de
0040+  582D 21 9B 55        ld hl,USB_CMD_GET_DEV_DESC_64
0041+  5830 AF              xor a
0042+  5831 06 40           ld b,64
0043+  5833 CD 7E 40        call HW_CONTROL_TRANSFER
0044+  5836 DD E1           pop ix
0045+  5838             
0046+  5838 21 B9 59        ld hl,DG_DD_S
0047+  583B CD A2 46        call PRINT
0048+  583E DD E5           push ix
0049+  5840 E1              pop hl
0050+  5841 06 08           ld b,8
0051+  5843             _DIAG_EP0_DD_LOOP:
0052+  5843 7E              ld a,(hl)
0053+  5844 CD AB 46        call PRINT_HEX
0054+  5847 3E 20           ld a,' '
0055+  5849 CD A2 00        call CHPUT
0056+  584C 23              inc hl
0057+  584D 10 F4           djnz _DIAG_EP0_DD_LOOP
0058+  584F 21 DD 47        ld hl,CRLF_S
0059+  5852 CD A2 46        call PRINT
0060+  5855             
0061+  5855 CD 0A 42        call HW_BUS_RESET
0062+  5858 DD E5           push ix
0063+  585A 21 BB 55        ld hl,USB_CMD_SET_ADDRESS
0064+  585D 11 00 00        ld de,0
0065+  5860 AF              xor a
0066+  5861 06 08           ld b,8
0067+  5863 CD 7E 40        call HW_CONTROL_TRANSFER
0068+  5866 DD E1           pop ix
0069+  5868 01 64 00        ld bc,100
0070+  586B CD 29 42        call CH_DELAY
0071+  586E             
0072+  586E 3E 3F           ld a,3Fh    ;Don't retry NAKs (retries are done by software, max 300ms)
0073+  5870 CD 46 44        call CH_SET_RETRY_VALUE
0074+  5873 3E 01           ld a,USB_DEVICE_ADDRESS
0075+  5875 CD F4 44        call CH_SET_TARGET_DEVICE_ADDRESS
0076+  5878             
0077+  5878                 ;--- Get device descriptor experiments
0078+  5878             
0079+  5878 21 BD 59        ld hl,DG_T0_S
0080+  587B AF              xor a
0081+  587C 0E 00           ld c,0
0082+  587E CD EC 58        call _DG_GET18
0083+  5881             
0084+  5881 21 C1 59        ld hl,DG_T1_S
0085+  5884 3E 80           ld a,80h
0086+  5886 0E 00           ld c,0
0087+  5888 CD EC 58        call _DG_GET18
0088+  588B             
0089+  588B 21 C5 59        ld hl,DG_D5_S
0090+  588E AF              xor a
0091+  588F 0E 32           ld c,50
0092+  5891 CD EC 58        call _DG_GET18
0093+  5894             
0094+  5894                 ;--- CH376 built-in commands
0095+  5894             
0096+  5894 21 C9 59        ld hl,DG_BI_S
0097+  5897 3E 01           ld a,1
0098+  5899 CD 67 59        call _DG_BUILTIN
0099+  589C 21 CD 59        ld hl,DG_B2_S
0100+  589F 3E 02           ld a,2
0101+  58A1 CD 67 59        call _DG_BUILTIN
0102+  58A4 21 DD 47        ld hl,CRLF_S
0103+  58A7 CD A2 46        call PRINT
0104+  58AA             
0105+  58AA                 ;--- SET_CONFIGURATION, then a CBI command
0106+  58AA             
