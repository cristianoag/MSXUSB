0059+  6CD2             ; DSK_READ_CONFIG_FILE: Read config file in current directory
0060+  6CD2             ;
0061+  6CD2             ; The file is read until B bytes have been read, the end of the file
0062+  6CD2             ; is reached, or a CR or LF character is found, whatever happens firts
0063+  6CD2             ; -----------------------------------------------------------------------------
0064+  6CD2             ; Input:  HL = File name
0065+  6CD2             ;         DE = Destination address
0066+  6CD2             ;         B  = Max amount of bytes to read
0067+  6CD2             ; Output: A  = 0: Ok
0068+  6CD2             ;              1: Other error
0069+  6CD2             ;              2: File not found
0070+  6CD2             ;         B  = Amount of bytes read if no error
0071+  6CD2             ;         DE = Pointer after last byte read
0072+  6CD2             
