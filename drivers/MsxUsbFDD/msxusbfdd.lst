0110+  58B3 CD 10 59        call _DG_SETUP
0111+  58B6 3E 80           ld a,80h
0112+  58B8 CD 22 59        call _DG_IN
0113+  58BB             
0114+  58BB 21 D5 59        ld hl,DG_AD_S
0115+  58BE CD A2 46        call PRINT
0116+  58C1 21 A9 59        ld hl,DG_CMD_ADSC
0117+  58C4 CD 10 59        call _DG_SETUP
0118+  58C7 3E 40           ld a,40h
0119+  58C9 06 08           ld b,8
0120+  58CB CD 4E 59        call _DG_OUT
0121+  58CE AF              xor a
0122+  58CF 06 04           ld b,4
0123+  58D1 CD 4E 59        call _DG_OUT
0124+  58D4 3E 80           ld a,80h
0125+  58D6 CD 22 59        call _DG_IN
0126+  58D9 21 DD 47        ld hl,CRLF_S
0127+  58DC CD A2 46        call PRINT
0128+  58DF             
0129+  58DF                 ;--- Done, restore the NAK retry mode
0130+  58DF             
