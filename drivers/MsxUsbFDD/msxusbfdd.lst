1504+  5793             
1505+  5793             _USB_EXE_CBI_DATA_OUT:
1506+  5793 CD 07 56        call USB_DATA_OUT_TRANSFER
1507+  5796             
1508+  5796 B7              or a
1509+  5797 28 03           jr z,_USB_EXE_CBI_STEP_3
1510+  5799 16 00           ld d,0
1511+  579B C9              ret
1512+  579C             
1513+  579C                 ;>>> STEP 3: Get status from INT endpoint
1514+  579C             
1515+  579C             _USB_EXE_CBI_STEP_3:
