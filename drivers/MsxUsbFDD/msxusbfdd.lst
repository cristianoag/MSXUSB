1366+  575E             
1367+  575E C1              pop bc
1368+  575F D1              pop de
1369+  5760 E1              pop hl
1370+  5761 FD E5           push iy
1371+  5763 F1              pop af
1372+  5764             
1373+  5764 DD E5           push ix
1374+  5766 CD A5 57        call _USB_EXECUTE_CBI_CORE
