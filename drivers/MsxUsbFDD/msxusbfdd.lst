0386+  511E D5              push de
0387+  511F C5              push bc
0388+  5120 DD E5           push ix
0389+  5122 CD 61 51        call _WK_GETWRK
0390+  5125 DD 7E 00        ld a,(ix)
0391+  5128 DD E1           pop ix
0392+  512A C1              pop bc
0393+  512B D1              pop de
0394+  512C E1              pop hl
0395+  512D CB 7F           bit 7,a
0396+  512F C9              ret
0397+  5130             
0398+  5130             
0399+  5130             ; -----------------------------------------------------------------------------
0400+  5130             ; Set the storage device flags
0401+  5130             ;
0402+  5130             ; Input: A = storage device flags byte
0403+  5130             
0404+  5130             WK_SET_STORAGE_DEV_FLAGS:
0405+  5130 DD E5           push ix
0406+  5132 F5              push af
0407+  5133 CD 61 51        call _WK_GETWRK
0408+  5136 F1              pop af
0409+  5137 DD 77 00        ld (ix),a
0410+  513A DD E1           pop ix
0411+  513C C9              ret
0412+  513D             
0413+  513D             
0414+  513D             ; -----------------------------------------------------------------------------
0415+  513D             ; Retrieve the current directory depth for the storage device
0416+  513D             ;
0417+  513D             ; Output: A = current directory depth
0418+  513D             
0419+  513D             WK_GET_CUR_DIR_DEPTH:
0420+  513D DD E5           push ix
0421+  513F CD 61 51        call _WK_GETWRK
0422+  5142 DD 7E 01        ld a,(ix+1)
0423+  5145 DD E1           pop ix
0424+  5147 C9              ret
0425+  5148             
0426+  5148             
0427+  5148             ; -----------------------------------------------------------------------------
0428+  5148             ; Set the current directory depth for the storage device
0429+  5148             ;
0430+  5148             ; Input: A = directory depth to set
0431+  5148             
0432+  5148             WK_SET_CUR_DIR_DEPTH:
0433+  5148 DD E5           push ix
0434+  514A F5              push af
0435+  514B CD 61 51        call _WK_GETWRK
0436+  514E F1              pop af
0437+  514F DD 77 01        ld (ix+1),a
0438+  5152 DD E1           pop ix
0439+  5154 C9              ret
0440+  5155             
0441+  5155             
0442+  5155             ; -----------------------------------------------------------------------------
0443+  5155             ; Get the storage address for a given work area value
0444+  5155             ;
0445+  5155             ; Input: B = value index (0-7)
0446+  5155             ; Output: HL = storage address for that value in work area
0447+  5155             
0448+  5155             _WK_GET_POINTER:
