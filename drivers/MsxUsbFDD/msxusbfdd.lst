0353+  6DBC             ; -----------------------------------------------------------------------------
0354+  6DBC             ; DSK_CHANGE_DIR_U: Change the current directory
0355+  6DBC             ;                   and update config files and work area
0356+  6DBC             ;
0357+  6DBC             ; This one is tricky. We can't update CURDIR until after we are sure that
0358+  6DBC             ; the directory change has been sucessful, but if we update a config file
0359+  6DBC             ; after setting our directory then it won't be set anymore! Also if we fail
0360+  6DBC             ; we should restore the previous directory.
0361+  6DBC             ;
0362+  6DBC             ; Thus we do it like this:
0363+  6DBC             ;
0364+  6DBC             ; 1. Read current content of CURDIR, save in memory
0365+  6DBC             ; 2. Set CURDIR contents to the directory we want to change to
0366+  6DBC             ; 3. Try to change to the directory, if successful, we're all set
0367+  6DBC             ; 4. On error changing the directory, set CURDIR to its previous contents
0368+  6DBC             ;    and change to it again
0369+  6DBC             ; -----------------------------------------------------------------------------
0370+  6DBC             ; Input:  HL = Directory path, "dir/dir2/dir3", no starting or ending "/"
0371+  6DBC             ;         A  = 0 for relative to current, 1 for absolute
0372+  6DBC             ; Output: A  = 0: Ok
0373+  6DBC             ;              1: Other error
0374+  6DBC             ;              2: Directory not found
0375+  6DBC             ;              3: It's a file, not a directory
0376+  6DBC             ;              4: Path is too long
0377+  6DBC             
0378+  6DBC             DSK_CHANGE_DIR_U:
0379+  6DBC FD E5           push iy
0380+  6DBE FD 21 BF FF     ld iy,-65
0381+  6DC2 FD 39           add iy,sp
0382+  6DC4 FD F9           ld sp,iy
0383+  6DC6 CD D4 6D        call _DSK_CHANGE_DIR_U
0384+  6DC9 FD 21 41 00     ld iy,65
0385+  6DCD FD 39           add iy,sp
0386+  6DCF FD F9           ld sp,iy
0387+  6DD1 FD E1           pop iy
0388+  6DD3 C9              ret
0389+  6DD4             
0390+  6DD4             _DSK_CHANGE_DIR_U:
0391+  6DD4 F5              push af
0392+  6DD5 E5              push hl
0393+  6DD6             
0394+  6DD6                 ;If setting absolute dir we can check its length now
0395+  6DD6             
0396+  6DD6 B7              or a
0397+  6DD7 28 0F           jr z,_DSK_CHANGE_DIR_U_LENGTH_OK
0398+  6DD9 E5              push hl
0399+  6DDA CD 31 65        call BM_STRLEN
