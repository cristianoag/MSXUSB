0503+  5155             
0504+  5155             ;	Subroutine	get my EXPTBL entry
0505+  5155             ;	Inputs		-
0506+  5155             ;	Outputs		HL = pointer to SLTWRK entry
0507+  5155             
0508+  5155             _WK_GETEXPTBL:
0509+  5155 CD 65 F3    	call 0F365h  ;read primary slotregister
0510+  5158 0F          	rrca
0511+  5159 0F          	rrca
