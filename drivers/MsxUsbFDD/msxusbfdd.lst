0001+  6A9B             ; MSXUSB USB FDD BIOS
0002+  6A9B             ; Based on the Rookie Drive USB FDD BIOS created by Konamiman in 2018
0003+  6A9B             ; This version is adapted to work with the latest version of the MSXUSB project
0004+  6A9B             ;
0005+  6A9B             ; This file contains the code for high-level management
0006+  6A9B             ; of disk image files, including creating and accessing
0007+  6A9B             ; configuration files when needed.
0008+  6A9B             
0009+  6A9B             
0010+  6A9B             ; -----------------------------------------------------------------------------
0011+  6A9B             ; DSK_OPEN_MAIN_DIR: Open the main directory
0012+  6A9B             ; -----------------------------------------------------------------------------
0013+  6A9B             ; Output: A = 0: Ok
0014+  6A9B             ;             1: Error
0015+  6A9B             ;         Z if ok, NZ if error
0016+  6A9B             ;         Cy = 0 if root directory was open, 1 if DSK_MAIN_DIR_S was open
0017+  6A9B             
0018+  6A9B             DSK_OPEN_MAIN_DIR:
0019+  6A9B E5              push hl
0020+  6A9C D5              push de
0021+  6A9D C5              push bc
0022+  6A9E CD A5 6A        call _DSK_OPEN_MAIN_DIR
0023+  6AA1 C1              pop bc
0024+  6AA2 D1              pop de
0025+  6AA3 E1              pop hl
0026+  6AA4 C9              ret
0027+  6AA5             _DSK_OPEN_MAIN_DIR:
0028+  6AA5 21 C1 6A        ld hl,DSK_ROOT_DIR_S
0029+  6AA8 CD 77 42        call HWF_OPEN_FILE_DIR
0030+  6AAB C0              ret nz
0031+  6AAC             
0032+  6AAC 21 C3 6A        ld hl,DSK_MAIN_DIR_S
0033+  6AAF CD 77 42        call HWF_OPEN_FILE_DIR
0034+  6AB2 20 02           jr nz,_DSK_OPEN_MAIN_REOPEN_ROOT
0035+  6AB4 38 08           jr c,_DSK_OPEN_MAIN_WAS_MSX
0036+  6AB6             
0037+  6AB6             _DSK_OPEN_MAIN_REOPEN_ROOT:
0038+  6AB6 21 C1 6A        ld hl,DSK_ROOT_DIR_S
0039+  6AB9 CD 77 42        call HWF_OPEN_FILE_DIR
0040+  6ABC             _DSK_OPEN_MAIN_END:
0041+  6ABC B7              or a    ;If error, set NZ; if ok, set Z and NC
0042+  6ABD C9              ret
0043+  6ABE             
0044+  6ABE             _DSK_OPEN_MAIN_WAS_MSX:
0045+  6ABE AF              xor a
0046+  6ABF 37              scf
0047+  6AC0 C9              ret
0048+  6AC1             
0049+  6AC1             DSK_ROOT_DIR_S:
0050+  6AC1 2F 00           db "/",0
0051+  6AC3             
0052+  6AC3             DSK_MAIN_DIR_S:
0053+  6AC3 4D 53 58        db "MSX"
0054+  6AC6             DSK_ZERO_S:
0055+  6AC6 00              db 0
