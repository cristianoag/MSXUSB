1529+  444E             ; HW_CONFIGURE_NAK_RETRY
1530+  444E             ; -----------------------------------------------------------------------------
1531+  444E             ; Input: Cy = 0 to retry for a limited time when the device returns NAK
1532+  444E             ;               (this is the default)
1533+  444E             ;             1 to retry indefinitely (or for a long time) 
1534+  444E             ;               when the device returns NAK 
1535+  444E             
1536+  444E             HW_CONFIGURE_NAK_RETRY:
1537+  444E 3E FF           ld a,0FFh
