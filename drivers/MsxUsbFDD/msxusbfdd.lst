0390+  411F             ; -----------------------------------------------------------------------------
0391+  411F             ; HW_DATA_IN_TRANSFER: Perform a USB data IN transfer
0392+  411F             ; -----------------------------------------------------------------------------
0393+  411F             ; Input:  HL = Address of a buffer for the received data
0394+  411F             ;         BC = Data length
0395+  411F             ;         A  = Device address
0396+  411F             ;         D  = Maximum packet size for the endpoint
0397+  411F             ;         E  = Endpoint number
0398+  411F             ;         Cy = Current state of the toggle bit
0399+  411F             ; Output: A  = USB error code
0400+  411F             ;         BC = Amount of data actually received (only if no error)
0401+  411F             ;         Cy = New state of the toggle bit (even on error)
0402+  411F             
0403+  411F             HW_DATA_IN_TRANSFER:
0404+  411F CD 05 45        call CH_SET_TARGET_DEVICE_ADDRESS
0405+  4122 CD 12 42        call _CH_NO_SW_NAK_RETRY
