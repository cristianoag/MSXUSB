0515+  5190             _WK_ADDHLA:
0516+  5190 4F          	ld c,a
0517+  5191 09          	add hl,bc
0518+  5192 C9          	ret    
0059   5193                 include "bank1/usb.asm"
0001+  5193             ; MSXUSB USB FDD BIOS
0002+  5193             ; Based on the Rookie Drive USB FDD BIOS created by Konamiman in 2018
0003+  5193             ; This version is adapted to work with the latest version of the MSXUSB project
0004+  5193             ;
0005+  5193             ; This file contains the "high level" (hardware independent)
0006+  5193             ; USB operation routines, including the ones related to the CBI protocol.
0007+  5193             ; It also contains the code that detects if the connected device is a proper FDD
0008+  5193             ; and initializes the work area accordingly.
0009+  5193             ;
0010+  5193             ; Connecting a FDD via a hub is allowed since v2.1, useful when the MSX itself
0011+  5193             ; can't provide enough power for it. A simplified approach to hub initializttion
0012+  5193             ; and handling is taken:
0013+  5193             ;
0014+  5193             ; - Number of ports isn't checked, max 7 ports are assumed. If powering a port results
0015+  5193             ;   in error, it is assumed that there are no more ports remaining.
0016+  5193             ; - No actual check is done for a device being a attached to a given port.
0017+  5193             ;   If resetting the port fails, it is assumed that there is no device in that port.
0018+  5193             ; - Ports are powered one by one until one is found having an attached device,
0019+  5193             ;   even if that device isn't an FDD.
0020+  5193             ; - The change notification endpoint isn't used. If trying to accessing the device 
0021+  5193             ;   (via hub or not) throws an error, a full reset and initialization is done again.
0022+  5193             
0023+  5193             
0024+  5193             USB_DEVICE_ADDRESS: equ 1
0025+  5193             HUB_DEVICE_ADDRESS: equ 2
0026+  5193             
0027+  5193             ;Scratch byte holding the current USB_INIT_DEV step, for error reporting
0028+  5193             ;(PROCNM is also used as scratch space for the device VID and PID)
0029+  5193             USB_INIT_STEP: equ PROCNM+4
0030+  5193             ;CH_LAST_STATUS is PROCNM+5 (see ch376.asm)
0031+  5193             USB_INIT_LAST_STATUS: equ PROCNM+6
0032+  5193             USB_PROBE_ADDR1_STATUS: equ PROCNM+7
0033+  5193             USB_PROBE_ADDR0_STATUS: equ PROCNM+8
0034+  5193             ;PROCNM+9 to PROCNM+13 are used by ch376.asm
0035+  5193             USB_INIT_NAK_COUNT: equ PROCNM+14   ;Word
0036+  5193             
0037+  5193             USB_CLASS_MASS: equ 8
0038+  5193             USB_SUBCLASS_CBI: equ 4
0039+  5193             USB_PROTO_WITH_INT_EP: equ 0
0040+  5193             
0041+  5193             USB_CLASS_HUB: equ 9
0042+  5193             
0043+  5193             
0044+  5193             ; -----------------------------------------------------------------------------
0045+  5193             ; USB_CHECK_DEV_CHANGE
0046+  5193             ;
0047+  5193             ; Check if a device connection or disconnection has happened.
0048+  5193             ; On device connection, initialize it.
0049+  5193             ; On device disconnection, clear work area.
0050+  5193             ; -----------------------------------------------------------------------------
0051+  5193             ; Output: Cy = 0 if a properly initialized CBI or storage device is connected
0052+  5193             ;              1 if not
0053+  5193             
0054+  5193             USB_CHECK_DEV_CHANGE:
0055+  5193 CD 69 40        call HW_DEV_CHANGE
0056+  5196 38 2B           jr c,_USB_CHECK_DEV_CHANGE_NO_DEV   ;Device present, but bus reset failed
0057+  5198             
0058+  5198 B7              or a
0059+  5199 20 06           jr nz,_USB_CHECK_DEV_CHANGE_CHANGED
0060+  519B             
0061+  519B                 ;* No device change detected, rely on work area
0062+  519B             
0063+  519B CD 3E 50        call WK_HAS_CONTENTS
0064+  519E D0              ret nc
0065+  519F 37              scf
0066+  51A0 C9              ret
0067+  51A1             
0068+  51A1                 ;* Device change detected, act accordingly
0069+  51A1             
0070+  51A1             _USB_CHECK_DEV_CHANGE_CHANGED:
0071+  51A1 3C              inc a
0072+  51A2 28 1F           jr z,_USB_CHECK_DEV_CHANGE_NO_DEV   ;Disconnected
0073+  51A4             
0074+  51A4 CD C8 51        call USB_INIT_DEV
0075+  51A7 B7              or a
0076+  51A8 C8              ret z   ;Initialization OK
0077+  51A9 3D              dec a
0078+  51AA 20 17           jr nz,_USB_CHECK_DEV_CHANGE_NO_DEV
0079+  51AC             
0080+  51AC                 ;* Device present but it's not a FDD: check if it's a storage device
0081+  51AC             
0082+  51AC CD 1D 51        call WK_GET_STORAGE_DEV_FLAGS   ;No disk mounted for now
0083+  51AF E6 FE           and 0FEh
0084+  51B1 CD 30 51        call WK_SET_STORAGE_DEV_FLAGS
0085+  51B4                 
0086+  51B4 CD 38 42        call HWF_MOUNT_DISK
0087+  51B7 38 0A           jr c,_USB_CHECK_DEV_CHANGE_NO_DEV
0088+  51B9 CD E3 72        call DSK_INIT_WK_FOR_STORAGE_DEV
0089+  51BC 3E 01           ld a,1
0090+  51BE CD 6F 71        call DSK_DO_BOOT_PROC
0091+  51C1 B7              or a
0092+  51C2 C9              ret
0093+  51C3             
0094+  51C3                 ;* No device, or device initialization failed
0095+  51C3             
0096+  51C3             _USB_CHECK_DEV_CHANGE_NO_DEV:
0097+  51C3 CD F6 4F        call WK_ZERO
0098+  51C6 37              scf
0099+  51C7 C9              ret
0100+  51C8             
0101+  51C8             
0102+  51C8             ; -----------------------------------------------------------------------------
0103+  51C8             ; USB_INIT_DEV: Initialize USB device and work area
0104+  51C8             ;
0105+  51C8             ; This routine is invoked after a device connections is detected.
0106+  51C8             ; If checks if the device is a CBI FDD, and if so, configures it
0107+  51C8             ; and initializes the work area; if not, it empties the work area.
0108+  51C8             ; -----------------------------------------------------------------------------
0109+  51C8             ; Output: A = Initialization result
0110+  51C8             ;             0: Ok, device is a CBI FDD
0111+  51C8             ;             1: The device is not a CBI FDD
0112+  51C8             ;             2: Error when querying or initializing the device
0113+  51C8             ;         B = USB error code if A = 2
0114+  51C8             
0115+  51C8             USB_INIT_DEV_STACK_SPACE: equ 64
0116+  51C8             
0117+  51C8             USB_INIT_DEV:
0118+  51C8 DD 21 C0 FF     ld ix,-USB_INIT_DEV_STACK_SPACE
0119+  51CC DD 39           add ix,sp
0120+  51CE DD F9           ld sp,ix
0121+  51D0 DD E5           push ix
0122+  51D2 E1              pop hl
0123+  51D3             
0124+  51D3 E5              push hl
0125+  51D4 CD F6 4F        call WK_ZERO
0126+  51D7             
0127+  51D7                 ;--- Initialize work area: assume max endpoint 0 packet size is 64 bytes,
0128+  51D7                 ;    like Windows does. A device with a smaller size will then send
0129+  51D7                 ;    a short packet and the first request will end after 8 bytes,
0130+  51D7                 ;    which is enough to know the actual endpoint 0 max packet size.
0131+  51D7             
0132+  51D7 3E 40           ld a,64
0133+  51D9 06 02           ld b,2
0134+  51DB CD D2 4F        call WK_SET_EP_SIZE
0135+  51DE             
0136+  51DE                 ;The enumeration sequence mimics the one used by Windows, since some devices
0137+  51DE                 ;(e.g. TEAC FD-05PUB) are known to work with it and misbehave otherwise:
0138+  51DE                 ;
0139+  51DE                 ;1. Get device descriptor at address 0, requesting 64 bytes
0140+  51DE                 ;   (with an assumed endpoint 0 max packet size of 64 bytes)
0141+  51DE                 ;2. Bus reset again
0142+  51DE                 ;3. SET_ADDRESS
0143+  51DE                 ;4. Get the full device descriptor and the configuration descriptor
0144+  51DE                 ;   at the new address
0145+  51DE                 ;5. SET_CONFIGURATION
0146+  51DE                 ;
0147+  51DE                 ;Descriptors are read with our own control transfer routine, which honors the
0148+  51DE                 ;endpoint 0 max packet size and handles multi-packet data stages
0149+  51DE                 ;(it's 8 bytes in some FDDs, e.g. TEAC FD-05PUB).
0150+  51DE                 ;
0151+  51DE                 ;The current step number is stored at USB_INIT_STEP for error reporting.
0152+  51DE             
0153+  51DE D1              pop de
0154+  51DF             _USB_INIT_DEV_RESTART:  ;Jumps here after hub init if hub is detected
0155+  51DF D5              push de
0156+  51E0             
0157+  51E0                 ;--- Step 1: Get device descriptor at address 0, grab max endpoint 0 packet size
0158+  51E0             
0159+  51E0 3E 01           ld a,1
0160+  51E2 32 8D FD        ld (USB_INIT_STEP),a
0161+  51E5 21 9B 55        ld hl,USB_CMD_GET_DEV_DESC_64
0162+  51E8 AF              xor a
0163+  51E9 CD B5 54        call _USB_INIT_CONTROL_TRANSFER
0164+  51EC             
0165+  51EC DD E1           pop ix
0166+  51EE B7              or a
0167+  51EF C2 83 53        jp nz,_USB_INIT_DEV_ERR
0168+  51F2             
0169+  51F2                 ;The endpoint 0 max packet size must be known before any other request
0170+  51F2                 ;with a data stage longer than 8 bytes is issued (also for hubs)
0171+  51F2             
0172+  51F2 DD 7E 07        ld a,(ix+7)
0173+  51F5 DD E5           push ix
0174+  51F7 06 02           ld b,2
0175+  51F9 CD D2 4F        call WK_SET_EP_SIZE
0176+  51FC DD E1           pop ix
0177+  51FE             
0178+  51FE CD FC 50        call WK_GET_MISC_FLAGS
0179+  5201 E6 01           and 1
0180+  5203 20 19           jr nz,_USB_INIT_SET_ADDRESS ;Device behind a hub: don't check hub again, don't reset the bus
0181+  5205 DD 7E 04        ld a,(ix+4)
0182+  5208 FE 09           cp USB_CLASS_HUB
0183+  520A CA C3 54        jp z,_USB_INIT_HUB_FOUND
0184+  520D             
0185+  520D                 ;--- Step 2: Bus reset
0186+  520D             
0187+  520D 3E 02           ld a,2
0188+  520F 32 8D FD        ld (USB_INIT_STEP),a
0189+  5212 DD E5           push ix
0190+  5214 CD 0A 42        call HW_BUS_RESET
0191+  5217 DD E1           pop ix
0192+  5219 3E 07           ld a,USB_ERR_UNEXPECTED_STATUS_FROM_HOST
0193+  521B DA 83 53        jp c,_USB_INIT_DEV_ERR
0194+  521E             
0195+  521E                 ;--- Step 3: Assign an address to the device
0196+  521E             
0197+  521E             _USB_INIT_SET_ADDRESS:
0198+  521E 3E 03           ld a,3
0199+  5220 32 8D FD        ld (USB_INIT_STEP),a
0200+  5223 DD E5           push ix
0201+  5225             
0202+  5225                 if HW_IMPL_SET_ADDRESS = 1
0203+  5225~            
0204+  5225~                ld a,USB_DEVICE_ADDRESS
0205+  5225~                call HW_SET_ADDRESS
0206+  5225~            
0207+  5225                 else
0208+  5225             
0209+  5225 21 BB 55        ld hl,USB_CMD_SET_ADDRESS
0210+  5228 11 00 00        ld de,0 ;No data will be actually transferred
0211+  522B AF              xor a
0212+  522C CD B5 54        call _USB_INIT_CONTROL_TRANSFER
0213+  522F CD 8A 55        call _USB_SET_ADDRESS_RECOVERY
0214+  5232             
0215+  5232                 endif
0216+  5232             
0217+  5232 DD E1           pop ix
0218+  5234 B7              or a
0219+  5235 C2 83 53        jp nz,_USB_INIT_DEV_ERR
0220+  5238             
0221+  5238                 ;--- Step 4: Get the full device descriptor
0222+  5238             
0223+  5238 3E 04           ld a,4
0224+  523A 32 8D FD        ld (USB_INIT_STEP),a
0225+  523D DD E5           push ix
0226+  523F D1              pop de
0227+  5240 D5              push de
0228+  5241 21 A3 55        ld hl,USB_CMD_GET_DEV_DESC_18
0229+  5244 3E 01           ld a,USB_DEVICE_ADDRESS
0230+  5246 CD B5 54        call _USB_INIT_CONTROL_TRANSFER
0231+  5249 DD E1           pop ix
0232+  524B B7              or a
0233+  524C 28 1A           jr z,_USB_INIT_DEV_DESC_OK
0234+  524E             
0235+  524E                 ;Some devices (e.g. TEAC FD-05PUB with endpoint 0 max packet size of 8 bytes)
0236+  524E                 ;never deliver the second packet of a control IN data stage to the CH376
0237+  524E                 ;(they NAK it indefinitely), but they work otherwise. In that case the first
0238+  524E                 ;packet is used, and the device is handled in "single packet mode":
0239+  524E                 ;only the first 8 bytes of the descriptors are read, and a standard
0240+  524E                 ;CBI+UFI interface layout is assumed (see _USB_INIT_FAKE_CONFIG_DESC).
0241+  524E             
0242+  524E FE 01           cp USB_ERR_NAK
0243+  5250 C2 83 53        jp nz,_USB_INIT_DEV_ERR
0244+  5253 79              ld a,c
0245+  5254 FE 08           cp 8
0246+  5256 3E 01           ld a,USB_ERR_NAK
0247+  5258 DA 83 53        jp c,_USB_INIT_DEV_ERR
0248+  525B 21 FF FF        ld hl,0FFFFh    ;VID/PID = FFFFh means "single packet mode"
0249+  525E 22 89 FD        ld (PROCNM),hl
0250+  5261 22 8B FD        ld (PROCNM+2),hl
0251+  5264 DD E5           push ix
0252+  5266 18 14           jr _USB_INIT_GET_CONFIG_DESC
0253+  5268             
0254+  5268             _USB_INIT_DEV_DESC_OK:
0255+  5268 DD E5           push ix
0256+  526A             
0257+  526A                 ;* HACK: Store VID and PID to allow Konamiman's non-standard FDD unit to be used
0258+  526A             
