0708+  6F4D             ; -----------------------------------------------------------------------------
0709+  6F4D             ; DSK_GET_CURDIR: Get (and enter) the current directory
0710+  6F4D             ;
0711+  6F4D             ; - If config file CURDIR exists and the directory it contains exists: return it
0712+  6F4D             ; - Otherwise, return the main directory
0713+  6F4D             ;
0714+  6F4D             ; Doesn't modify the contents of CURFILE.
