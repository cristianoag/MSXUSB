0058+  6AC7             ; -----------------------------------------------------------------------------
0059+  6AC7             ; DSK_READ_CONFIG_FILE: Read config file in current directory
0060+  6AC7             ;
0061+  6AC7             ; The file is read until B bytes have been read, the end of the file
0062+  6AC7             ; is reached, or a CR or LF character is found, whatever happens firts
0063+  6AC7             ; -----------------------------------------------------------------------------
0064+  6AC7             ; Input:  HL = File name
0065+  6AC7             ;         DE = Destination address
0066+  6AC7             ;         B  = Max amount of bytes to read
0067+  6AC7             ; Output: A  = 0: Ok
0068+  6AC7             ;              1: Other error
0069+  6AC7             ;              2: File not found
0070+  6AC7             ;         B  = Amount of bytes read if no error
0071+  6AC7             ;         DE = Pointer after last byte read
0072+  6AC7             
0073+  6AC7             DSK_READ_CONFIG_FILE:
0074+  6AC7 E5              push hl
0075+  6AC8 D5              push de
0076+  6AC9 C5              push bc
