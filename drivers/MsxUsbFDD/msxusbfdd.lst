0429+  6E00 F1              pop af
0430+  6E01 B7              or a
0431+  6E02 20 33           jr nz,_DSK_CHANGE_DIR_U_UPD_CURDIR
0432+  6E04 E5              push hl
0433+  6E05 CD 31 65        call BM_STRLEN
0434+  6E08 78              ld a,b
0435+  6E09 FD 86 00        add (iy)
0436+  6E0C 3C              inc a   ;Account for the extra "/" to add
0437+  6E0D FE 41           cp BM_MAX_DIR_NAME_LENGTH+1
0438+  6E0F 38 04           jr c,_DSK_CHANGE_DIR_U_LENGTH_OK_2
0439+  6E11 E1              pop hl
0440+  6E12 3E 04           ld a,4
0441+  6E14 C9              ret
0442+  6E15             _DSK_CHANGE_DIR_U_LENGTH_OK_2:
0443+  6E15             
0444+  6E15                 ;Also if setting relative dir:
0445+  6E15                 ;append dir to the one we have in memory
0446+  6E15             
