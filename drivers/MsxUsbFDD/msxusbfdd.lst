0082+  4026             CH_CMD_DISK_CONNECT: equ 30h
0083+  4026             CH_CMD_DISK_MOUNT: equ 31h
0084+  4026             CH_CMD_FILE_OPEN: equ 32h
0085+  4026             CH_CMD_FILE_ENUM_GO: equ 33h
0086+  4026             CH_CMD_FILE_CREATE: equ 34h
0087+  4026             CH_CMD_FILE_ERASE: equ 35h
0088+  4026             CH_CMD_FILE_CLOSE: equ 36h
0089+  4026             CH_CMD_DIR_INFO_READ: equ 37h
0090+  4026             CH_CMD_BYTE_LOCATE: equ 39h
