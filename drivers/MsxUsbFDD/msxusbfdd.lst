0504+  5184             ;	Subroutine	get my EXPTBL entry
0505+  5184             ;	Inputs		-
0506+  5184             ;	Outputs		HL = pointer to SLTWRK entry
0507+  5184             
0508+  5184             _WK_GETEXPTBL:
