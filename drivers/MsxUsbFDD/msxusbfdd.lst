0424+  4139 CD 21 45        call CH_READ_DATA
0425+  413C 48              ld c,b
0426+  413D 06 00           ld b,0
0427+  413F DD 09           add ix,bc   ;Update received so far count
0428+  4141             _CH_DATA_IN_NO_MORE_DATA:
0429+  4141             
0430+  4141 D1              pop de
0431+  4142 F1              pop af
0432+  4143 EE 80           xor 80h     ;Update toggle
0433+  4145 F5              push af
0434+  4146 D5              push de
0435+  4147             
0436+  4147 79              ld a,c
0437+  4148 B7              or a
0438+  4149 28 12           jr z,_CH_DATA_IN_DONE    ;DONE if no data received
