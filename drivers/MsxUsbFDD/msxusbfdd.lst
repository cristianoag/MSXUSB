0054   454F                 include "bank1/inihrd_inienv.asm"
0001+  454F             ; MSXUSB USB FDD BIOS
0002+  454F             ; Based on the Rookie Drive USB FDD BIOS created by Konamiman in 2018
0003+  454F             ; This version is adapted to work with the latest version of the MSXUSB project
0004+  454F             ;
0005+  454F             ; This file contains the implementation of the INIHRD and INIENV
0006+  454F             ; driver routines.
0007+  454F             
0008+  454F             
0009+  454F             ; We do the hardware reset in INIENV and not in INIHRD
0010+  454F             ; because we need to setup the work area during reset, but work area
0011+  454F             ; is zeroed by kernel between INIHRD and INIENV.
0012+  454F             
0013+  454F             
0014+  454F             ; -----------------------------------------------------------------------------
0015+  454F             ; INIHRD
0016+  454F             ; -----------------------------------------------------------------------------
0017+  454F             ; Input:	None
0018+  454F             ; Output:	Cy=0 if USB hardware is operational, 1 if not
0019+  454F             ; Changed:	AF,BC,DE,HL,IX,IY may be affected
0020+  454F             ; -----------------------------------------------------------------------------
0021+  454F             
0022+  454F             INIHRD_IMPL:
0023+  454F CD 6C 00        call INITXT
0024+  4552 21 5A 47        ld hl,ROOKIE_S
0025+  4555 CD A2 46        call PRINT
0026+  4558             
0027+  4558 CD 26 40        call HW_TEST
0028+  455B D0              ret nc
0029+  455C             
0030+  455C 21 C1 47        ld hl,NOHARD_S
0031+  455F CD A2 46        call PRINT
0032+  4562 06 3C           ld b,60
0033+  4564 CD 7E 45        call DELAY_B
0034+  4567             
0035+  4567 37              scf
0036+  4568 C9              ret
0037+  4569             
0038+  4569             
0039+  4569             ; -----------------------------------------------------------------------------
0040+  4569             ; INIENV
0041+  4569             ; -----------------------------------------------------------------------------
