0056+  4026~            CH_COMMAND_PORT: equ 23h    
0057+  4026                 else
0058+  4026             CH_DATA_PORT: equ 20h
0059+  4026             CH_COMMAND_PORT: equ 21h
0060+  4026                 endif
0061+  4026             
