0770+  6F8A             ; DSK_REMOUNT: Mount again the current file (per CURDIR and CURFILE)
0771+  6F8A             ; -----------------------------------------------------------------------------
0772+  6F8A             ; Input:  HL = Address of 65 byte buffer for directory name
0773+  6F8A             ; Output: A  = 0: Ok
0774+  6F8A             ;              1: Other error
