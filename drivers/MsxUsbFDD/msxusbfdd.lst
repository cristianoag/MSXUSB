0209+  6B4C             
0210+  6B4C             ; -----------------------------------------------------------------------------
0211+  6B4C             ; DSK_WRITE_MAIN_CONFIG_FILE: Write config file in main directory
0212+  6B4C             ; -----------------------------------------------------------------------------
0213+  6B4C             ; Input:  HL = File name
0214+  6B4C             ;         DE = Source address
0215+  6B4C             ;         B  = Amount of bytes to write
0216+  6B4C             ; Output: A  = 0: Ok
0217+  6B4C             ;              1: Error
0218+  6B4C             
