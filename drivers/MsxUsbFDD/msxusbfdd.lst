1209+  56D1             ; -----------------------------------------------------------------------------
1210+  56D1             ; USB_PROCESS_ERROR
1211+  56D1             ;
1212+  56D1             ; If USB error is "device disconnected", clear work area.
1213+  56D1             ; Otherwise, if it's not STALL, reset device.
1214+  56D1             ; -----------------------------------------------------------------------------
1215+  56D1             ; Does not modify registers
1216+  56D1             
1217+  56D1             USB_PROCESS_ERROR:
1218+  56D1 C5              push bc
1219+  56D2 D5              push de
1220+  56D3 E5              push hl
1221+  56D4 F5              push af
1222+  56D5 21 E3 56        ld hl,_USB_PROCESS_ERROR_END
