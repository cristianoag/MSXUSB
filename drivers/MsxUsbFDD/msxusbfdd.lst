0952+  4CEB~                pop bc
0953+  4CEB~                push bc
0954+  4CEB~                push hl
0955+  4CEB~                push de
0956+  4CEB~            
0957+  4CEB~            BEEPS:
0958+  4CEB~                push bc
0959+  4CEB~                ld ix,BEEP
0960+  4CEB~                call CALBIOS
0961+  4CEB~                pop bc
0962+  4CEB~                djnz BEEPS
0963+  4CEB~            
0964+  4CEB~                pop de
0965+  4CEB~                pop hl
0966+  4CEB~                pop bc
0967+  4CEB~                pop af
0968+  4CEB~            
0969+  4CEB~                ret
0970+  4CEB~            
0971+  4CEB~            
0972+  4CEB~            CALBIOS:
0973+  4CEB~                ld iy,0
0974+  4CEB~                jp CALSLT
0975+  4CEB~            
0976+  4CEB~            PRINTSPACE:
0977+  4CEB~                ld a," "
0978+  4CEB~            PRINTBIOS:
0979+  4CEB~                ld ix,CHPUT
0980+  4CEB~                jp CALBIOS
0981+  4CEB~            
0982+  4CEB~            PRINTHEXBIOS_HL:
0983+  4CEB~                ld a,h
0984+  4CEB~                call PRINTHEXBIOS
0985+  4CEB~                ld a,l
0986+  4CEB~            PRINTHEXBIOS:
0987+  4CEB~                push af
0988+  4CEB~            	call	_PRINTHEXBIOS1
0989+  4CEB~            	pop af
0990+  4CEB~            	jr	_PRINTHEXBIOS2
0991+  4CEB~            
0992+  4CEB~            _PRINTHEXBIOS1:	rra
0993+  4CEB~            	rra
0994+  4CEB~            	rra
0995+  4CEB~            	rra
0996+  4CEB~            _PRINTHEXBIOS2:	or	0F0h
0997+  4CEB~            	daa
0998+  4CEB~            	add	a,0A0h
0999+  4CEB~            	adc	a,40h
1000+  4CEB~            
1001+  4CEB~            	call PRINTBIOS
1002+  4CEB~            	ret
1003+  4CEB~            
1004+  4CEB                 endif
0057   4CEB                 include "bank1/choice_dskfmt.asm"    
0001+  4CEB             ; MSXUSB USB FDD BIOS
0002+  4CEB             ; Based on the Rookie Drive USB FDD BIOS created by Konamiman in 2018
0003+  4CEB             ; This version is adapted to work with the latest version of the MSXUSB project
0004+  4CEB             ;
0005+  4CEB             ; This file contains the implementation of the CHOICE and DSKFMT
0006+  4CEB             ; driver routines.
0007+  4CEB             
0008+  4CEB             
0009+  4CEB             ; Error codes used by DSKFMT:
0010+  4CEB             ;
0011+  4CEB             ; 0	write protect error
0012+  4CEB             ; 2	not ready error
0013+  4CEB             ; 4	data (crc) error
0014+  4CEB             ; 6	seek error
0015+  4CEB             ; 8	record not found error
0016+  4CEB             ; 10 write fault error
0017+  4CEB             ; 12 bad parameter
0018+  4CEB             ; 14 insufficient memory
0019+  4CEB             ; 16 other error
0020+  4CEB             
0021+  4CEB             
0022+  4CEB             ; -----------------------------------------------------------------------------
0023+  4CEB             ; CHOICE
0024+  4CEB             ; -----------------------------------------------------------------------------
0025+  4CEB             ; Input: 	None
0026+  4CEB             ; Output:	HL	pointer to choice string, 0 if no choice
0027+  4CEB             ; Changed:	AF,BC,DE,HL,IX,IY may be affected
0028+  4CEB             ; -----------------------------------------------------------------------------
0029+  4CEB             
0030+  4CEB             CHOICE_IMPL:
0031+  4CEB CD EE 50        call WK_GET_STORAGE_DEV_FLAGS
0032+  4CEE 21 00 00        ld hl,0
0033+  4CF1 C0              ret nz
0034+  4CF2             
0035+  4CF2 21 D9 74        ld hl,CHOICE_S
0036+  4CF5 C9              ret
0037+  4CF6             
0038+  4CF6             
0039+  4CF6             ; -----------------------------------------------------------------------------
0040+  4CF6             ; DSKFMT
0041+  4CF6             ; -----------------------------------------------------------------------------
0042+  4CF6             ; Input: 	A	choicecode (1-9)
0043+  4CF6             ;		D	drivenumber
0044+  4CF6             ;		HL	begin of workarea
0045+  4CF6             ;		BC	length of workarea
0046+  4CF6             ; Output:	F	Cx set for error
0047+  4CF6             ;			Cx reset for ok
0048+  4CF6             ;		A	if error, errorcode
0049+  4CF6             ; Changed:	AF,BC,DE,HL,IX,IY may be affected
0050+  4CF6             ; -----------------------------------------------------------------------------
0051+  4CF6             
0052+  4CF6             DSKFMT_IMPL:
0053+  4CF6 4F              ld c,a
0054+  4CF7 7A              ld a,d
0055+  4CF8 CD 3C 58        call CHECK_SAME_DRIVE
0056+  4CFB             
0057+  4CFB CD EE 50        call WK_GET_STORAGE_DEV_FLAGS
0058+  4CFE 3E 10           ld a,16
0059+  4D00 37              scf
0060+  4D01 C0              ret nz
0061+  4D02             
0062+  4D02 C5              push bc
0063+  4D03 CD F4 4B        call DSKCHG_IMPL    ;To eat a possible "not ready" error reported by
0064+  4D06 C1              pop bc              ;the device on disk change
0065+  4D07             
0066+  4D07 0D              dec c
0067+  4D08             
0068+  4D08                 ;Now C = bit 0: 0 for full format, 1 for quick format
0069+  4D08                 ;        bit 1: 0 for 720K, 1 for 1440K
0070+  4D08             
0071+  4D08 CB 19           rr c
0072+  4D0A 38 09           jr c,_DSKFMT_QUICK
0073+  4D0C             
0074+  4D0C             _DSKFMT_FULL:
0075+  4D0C C5              push bc
0076+  4D0D CB 19           rr c
0077+  4D0F CD 29 4D        call PHYSICAL_FORMAT
0078+  4D12 C1              pop bc
0079+  4D13 38 0C           jr c,_DSKFMT_END_ERR
0080+  4D15             
0081+  4D15             _DSKFMT_QUICK:
0082+  4D15 CB 19           rr c
0083+  4D17 CD 17 4E        call LOGICAL_FORMAT
0084+  4D1A 38 05           jr c,_DSKFMT_END_ERR
0085+  4D1C C9              ret
0086+  4D1D             
0087+  4D1D             _DSKFMT_BAD_PARAM:
0088+  4D1D 3E 0C           ld a,12
0089+  4D1F 37              scf
0090+  4D20 C9              ret
0091+  4D21             
0092+  4D21             _DSKFMT_END_ERR:
0093+  4D21 FE 0C           cp 12
0094+  4D23 20 02           jr nz,_DSKFMT_END_ERR2
0095+  4D25 3E 10           ld a,16
0096+  4D27             _DSKFMT_END_ERR2:
0097+  4D27 37              scf
0098+  4D28 C9              ret
0099+  4D29             
0100+  4D29             
0101+  4D29             ; ----------------------------------------------------------------------------
0102+  4D29             ; PHYSICAL_FORMAT
0103+  4D29             ; ----------------------------------------------------------------------------
0104+  4D29             ; Input:  Cy = 0 for 720K disk, 1 for 1.44M disk
0105+  4D29             ; Output: Cy = 0 if ok
0106+  4D29             ;         Cy = 1 and A=DSKFMT error code on error
0107+  4D29             
0108+  4D29             _PHYSICAL_FORMAT_STACK_SPACE: equ 12
0109+  4D29             _PHYSICAL_FORMAT_TRACKS_PER_SIDE_COUNT: equ 80
0110+  4D29             
0111+  4D29             PHYSICAL_FORMAT:
0112+  4D29                 if HW_IMPL_CONFIGURE_NAK_RETRY=1
0113+  4D29             
0114+  4D29 F5              push af
0115+  4D2A 37              scf
0116+  4D2B CD 4E 44        call HW_CONFIGURE_NAK_RETRY
0117+  4D2E F1              pop af
0118+  4D2F CD 39 4D        call _PHYSICAL_FORMAT
0119+  4D32 F5              push af
0120+  4D33 B7              or a
0121+  4D34 CD 4E 44        call HW_CONFIGURE_NAK_RETRY
0122+  4D37 F1              pop af
0123+  4D38 C9              ret
0124+  4D39             _PHYSICAL_FORMAT:
0125+  4D39             
0126+  4D39                 endif
0127+  4D39             
0128+  4D39 21 CF 4D        ld hl,_UFI_FORMAT_UNIT_DATA_720K_SIDE_0
0129+  4D3C 30 03           jr nc,_PHYSICAL_FORMAT_2
0130+  4D3E 21 F3 4D        ld hl,_UFI_FORMAT_UNIT_DATA_1440K_SIDE_0
0131+  4D41             _PHYSICAL_FORMAT_2:
0132+  4D41             
0133+  4D41 3E 06           ld a,6
0134+  4D43 CD 60 58        call DO_SNSMAT
0135+  4D46 E6 01           and 1
0136+  4D48 20 1C           jr nz,_PHYSICAL_FORMAT_DO_TRACK_BY_TRACK
0137+  4D4A             
0138+  4D4A                 ;Usually devices implement single track formatting only,
0139+  4D4A                 ;so by default we'll format all the tracks one by one in a loop.
0140+  4D4A                 ;However the single all tracks format command will be used
0141+  4D4A                 ;if SHIFT is pressed (together with any other key)
0142+  4D4A                 ;when the "Strike a key when ready" command is presented.
0143+  4D4A             
0144+  4D4A             _PHYSICAL_FORMAT_DO_ALL_TRACKS:
0145+  4D4A 01 18 00        ld bc,24
0146+  4D4D 09              add hl,bc   ;Point to the _ALL_TRACKS command data
0147+  4D4E             
0148+  4D4E EB              ex de,hl
0149+  4D4F 21 C3 4D        ld hl,_UFI_FORMAT_UNIT_CMD
0150+  4D52 01 0C 00        ld bc,12
0151+  4D55 3E 01           ld a,1
0152+  4D57 37              scf
0153+  4D58 CD A4 56        call USB_EXECUTE_CBI_WITH_RETRY
0154+  4D5B             
0155+  4D5B B7              or a
0156+  4D5C 3E 0C           ld a,12
0157+  4D5E 37              scf
0158+  4D5F C0              ret nz
0159+  4D60             
0160+  4D60 7A              ld a,d  ;non-zero ASC?
0161+  4D61 B7              or a
0162+  4D62 C8              ret z
0163+  4D63             
0164+  4D63 C3 CF 57        jp ASC_TO_ERR
0165+  4D66             
0166+  4D66             _PHYSICAL_FORMAT_DO_TRACK_BY_TRACK:
0167+  4D66 DD 21 F4 FF     ld ix,-_PHYSICAL_FORMAT_STACK_SPACE
0168+  4D6A DD 39           add ix,sp
0169+  4D6C DD F9           ld sp,ix
0170+  4D6E             
0171+  4D6E E5              push hl
0172+  4D6F DD E5           push ix
0173+  4D71 D1              pop de
0174+  4D72 21 C3 4D        ld hl,_UFI_FORMAT_UNIT_CMD
0175+  4D75 01 0C 00        ld bc,12
0176+  4D78 ED B0           ldir
0177+  4D7A E1              pop hl
0178+  4D7B             
0179+  4D7B E5              push hl
0180+  4D7C CD 96 4D        call _PHYSICAL_FORMAT_ONE_SIDE
0181+  4D7F E1              pop hl
0182+  4D80 38 07           jr c,_PHYSICAL_FORMAT_END
0183+  4D82 01 0C 00        ld bc,12
0184+  4D85 09              add hl,bc   ;Switch to the _SIDE_1 command
0185+  4D86 CD 96 4D        call _PHYSICAL_FORMAT_ONE_SIDE
0186+  4D89             
0187+  4D89             _PHYSICAL_FORMAT_END:
0188+  4D89 F5              push af
0189+  4D8A E1              pop hl
0190+  4D8B DD 21 0C 00     ld ix,_PHYSICAL_FORMAT_STACK_SPACE
0191+  4D8F DD 39           add ix,sp
0192+  4D91 DD F9           ld sp,ix
0193+  4D93 E5              push hl
0194+  4D94 F1              pop af
0195+  4D95 C9              ret
0196+  4D96             
0197+  4D96                 ;Format all the tracks on one side of the disk
0198+  4D96                 ;Input: IX=Command, HL=Data
0199+  4D96             
0200+  4D96             _PHYSICAL_FORMAT_ONE_SIDE:
0201+  4D96 06 00           ld b,0  ;Track number
0202+  4D98             
0203+  4D98             _PHYSICAL_FORMAT_TRACK_LOOP:
0204+  4D98 DD 70 02        ld (ix+2),b
0205+  4D9B             
0206+  4D9B DD E5           push ix
0207+  4D9D E5              push hl
0208+  4D9E C5              push bc
0209+  4D9F             
0210+  4D9F EB              ex de,hl
0211+  4DA0 DD E5           push ix
0212+  4DA2 E1              pop hl
0213+  4DA3 01 0C 00        ld bc,12
0214+  4DA6 3E 01           ld a,1
0215+  4DA8 37              scf
0216+  4DA9 CD A4 56        call USB_EXECUTE_CBI_WITH_RETRY
0217+  4DAC             
0218+  4DAC C1              pop bc
0219+  4DAD E1              pop hl
0220+  4DAE DD E1           pop ix
0221+  4DB0             
0222+  4DB0 B7              or a
0223+  4DB1 3E 0C           ld a,12
0224+  4DB3 37              scf
0225+  4DB4 C0              ret nz
0226+  4DB5             
0227+  4DB5 7A              ld a,d  ;non-zero ASC?
0228+  4DB6 B7              or a
0229+  4DB7 28 03           jr z,_PHYSICAL_FORMAT_NEXT_TRACK
0230+  4DB9             
0231+  4DB9 C3 CF 57        jp ASC_TO_ERR
0232+  4DBC             
0233+  4DBC             _PHYSICAL_FORMAT_NEXT_TRACK:
0234+  4DBC 04              inc b
0235+  4DBD 78              ld a,b
0236+  4DBE FE 50           cp _PHYSICAL_FORMAT_TRACKS_PER_SIDE_COUNT
0237+  4DC0 38 D6           jr c,_PHYSICAL_FORMAT_TRACK_LOOP
0238+  4DC2 C9              ret
0239+  4DC3             
0240+  4DC3             
0241+  4DC3             _UFI_FORMAT_UNIT_CMD:
0242+  4DC3                 db 4, 17h, 0, 0, 0, 0, 0, 0, 12, 0, 0, 0
0242+  4DC3 04170000000000000C000000
0243+  4DCF             
0244+  4DCF             _UFI_FORMAT_UNIT_DATA_720K_SIDE_0:
0245+  4DCF                 db 0, 0B0h, 0, 8, 0, 0, 05h, 0A0h, 0, 0, 2, 0
0245+  4DCF 00B00008000005A000000200
0246+  4DDB             _UFI_FORMAT_UNIT_DATA_720K_SIDE_1:
0247+  4DDB                 db 0, 0B1h, 0, 8, 0, 0, 05h, 0A0h, 0, 0, 2, 0
0247+  4DDB 00B10008000005A000000200
0248+  4DE7             _UFI_FORMAT_UNIT_DATA_720K_ALL_TRACKS:
0249+  4DE7                 db 0, 0A0h, 0, 8, 0, 0, 05h, 0A0h, 0, 0, 2, 0
0249+  4DE7 00A00008000005A000000200
0250+  4DF3             
0251+  4DF3             _UFI_FORMAT_UNIT_DATA_1440K_SIDE_0:
0252+  4DF3                 db 0, 0B0h, 0, 8, 0, 0, 0Bh, 040h, 0, 0, 2, 0
0252+  4DF3 00B0000800000B4000000200
0253+  4DFF             _UFI_FORMAT_UNIT_DATA_1440K_SIDE_1:
0254+  4DFF                 db 0, 0B1h, 0, 8, 0, 0, 0Bh, 040h, 0, 0, 2, 0
0254+  4DFF 00B1000800000B4000000200
0255+  4E0B             _UFI_FORMAT_UNIT_DATA_1440K_ALL_TRACKS:
0256+  4E0B                 db 0, 0A0h, 0, 8, 0, 0, 0Bh, 040h, 0, 0, 2, 0    
0256+  4E0B 00A0000800000B4000000200
0257+  4E17             
0258+  4E17             
0259+  4E17             ; ----------------------------------------------------------------------------
0260+  4E17             ; LOGICAL_FORMAT
0261+  4E17             ;
0262+  4E17             ; Initializes boot sector, FAT and root directory of the disk.
0263+  4E17             ;
0264+  4E17             ; MSX-DOS 1 doesn't support the standard 1.44MB format because this format
0265+  4E17             ; uses 9 sectors per FAT, but DOS 1 loads the entire FAT in memory after
0266+  4E17             ; having allocated just 1.5K (worth 3 sectors) for it.
0267+  4E17             ; There isn't any validation so the computer just crashes.
0268+  4E17             ;
0269+  4E17             ; As a workaround for the above, this BIOS will apply a custom format
0270+  4E17             ; of 3 sectors/FAT and 4 sectors/cluster when a 1.44MB is formatted
0271+  4E17             ; in DOS 1 mode (I know, the driver shouldn't be aware of the DOS version
0272+  4E17             ; under which it exists, but this is not a perfect world); in DOS2 mode
0273+  4E17             ; the standard 9 sectors/FAT and 1 sector/cluster format will be applied.
0274+  4E17             ; ----------------------------------------------------------------------------
0275+  4E17             ; Input:  Cy = 0 for 720K disk
0276+  4E17             ;              1 for 1.44M disk
0277+  4E17             ; Output: Cy = 0 if ok
0278+  4E17             ;         Cy = 1 and A=DSKFMT error code on error
0279+  4E17             
0280+  4E17             LOGICAL_FORMAT:
0281+  4E17 21 7F 4F        ld hl,BOOT_PARAMETERS_720K
0282+  4E1A 30 0C           jr nc,_LOGICAL_FORMAT_DO
0283+  4E1C 21 97 4F        ld hl,BOOT_PARAMETERS_1440K_DOS1
0284+  4E1F 3A 13 F3        ld a,(DOSVER)   ;We shouldn't do this but :shrug:
0285+  4E22 B7              or a
0286+  4E23 28 03           jr z,_LOGICAL_FORMAT_DO
0287+  4E25 21 8B 4F        ld hl,BOOT_PARAMETERS_1440K
0288+  4E28             
0289+  4E28             _LOGICAL_FORMAT_DO:
0290+  4E28             
0291+  4E28                 ;>>> Step 1: write boot sector
0292+  4E28             
0293+  4E28 E5              push hl
0294+  4E29 CD C6 4E        call _LOGICAL_FORMAT_ZERO_SECBUF
0295+  4E2C 21 D4 4E        ld hl,BOOT_SECTOR
0296+  4E2F ED 5B 4D F3     ld de,(SECBUF)
0297+  4E33 01 AB 00        ld bc,BOOT_SECTOR_END-BOOT_SECTOR
0298+  4E36 ED B0           ldir
0299+  4E38             
0300+  4E38 2A 4D F3        ld hl,(SECBUF)
0301+  4E3B 01 0D 00        ld bc,BOOT_DISK_PARAMETERS-BOOT_SECTOR
0302+  4E3E 09              add hl,bc
0303+  4E3F EB              ex de,hl    ;DE = Position of variable disk parameters in SECBUF
0304+  4E40 E1              pop hl
0305+  4E41 E5              push hl
0306+  4E42 01 0C 00        ld bc,BOOT_DISK_PARAMETERS_END-BOOT_DISK_PARAMETERS
0307+  4E45 ED B0           ldir
0308+  4E47             
0309+  4E47 11 00 00        ld de,0
0310+  4E4A 06 01           ld b,1
0311+  4E4C CD A4 4E        call _LOGICAL_FORMAT_WR_SECTORS
0312+  4E4F DD E1           pop ix
0313+  4E51 D8              ret c
0314+  4E52             
0315+  4E52                 ;>>> Step 2: write first sector of both copies of FAT
0316+  4E52             
0317+  4E52 CD C6 4E        call _LOGICAL_FORMAT_ZERO_SECBUF
0318+  4E55             
0319+  4E55 2A 4D F3        ld hl,(SECBUF)
0320+  4E58 DD 7E 08        ld a,(ix+8) ;Media ID
0321+  4E5B 77              ld (hl),a
0322+  4E5C 23              inc hl
0323+  4E5D 3E FF           ld a,0FFh
0324+  4E5F 77              ld (hl),a
0325+  4E60 23              inc hl
0326+  4E61 77              ld (hl),a   ;SECBUF contains now the initialized first FAT sector
0327+  4E62             
0328+  4E62 11 01 00        ld de,1
0329+  4E65 06 01           ld b,1
0330+  4E67 CD A4 4E        call _LOGICAL_FORMAT_WR_SECTORS  ;Write first sector of first FAT
0331+  4E6A D8              ret c
0332+  4E6B             
0333+  4E6B DD 5E 09        ld e,(ix+9) ;Sectors per FAT
0334+  4E6E 1C              inc e  ;DE = First sector of second FAT (skip boot sector + 1st FAT)
0335+  4E6F 16 00           ld d,0
0336+  4E71 06 01           ld b,1
0337+  4E73 CD A4 4E        call _LOGICAL_FORMAT_WR_SECTORS
0338+  4E76 D8              ret c
0339+  4E77             
0340+  4E77                 ;>>> Step 3: clear the rest of the first FAT
0341+  4E77             
0342+  4E77 CD C6 4E        call _LOGICAL_FORMAT_ZERO_SECBUF
0343+  4E7A             
0344+  4E7A DD 46 09        ld b,(ix+9) ;Sectors per FAT
0345+  4E7D 05              dec b   ;First sector is already initialized
0346+  4E7E 11 02 00        ld de,2 ;Skip boot sector + 1st sector of first FAT
0347+  4E81 CD A4 4E        call _LOGICAL_FORMAT_WR_SECTORS
0348+  4E84 D8              ret c
0349+  4E85             
0350+  4E85                 ;>>> Step 4: clear the rest of the second FAT and the root directory
0351+  4E85             
0352+  4E85 06 00           ld b,0
0353+  4E87 DD 4E 04        ld c,(ix+4)   ;Root directory entries
0354+  4E8A CB 39           srl c
0355+  4E8C CB 39           srl c
0356+  4E8E CB 39           srl c
0357+  4E90 CB 39           srl c   ;BC = sectors for the root directory
0358+  4E92             
0359+  4E92 26 00           ld h,0
0360+  4E94 DD 6E 09        ld l,(ix+9) ;Sectors per FAT
0361+  4E97 2B              dec hl  ;First sector is already initialized
0362+  4E98 09              add hl,bc
0363+  4E99 45              ld b,l  ;B = How many sectors to clear (second FAT except 1st sector + root directory)
0364+  4E9A             
0365+  4E9A 16 00           ld d,0
0366+  4E9C DD 5E 09        ld e,(ix+9)
0367+  4E9F 1C              inc e
0368+  4EA0 1C              inc e   ;DE = First sector to clear (skip 1st FAT + boot sector + 1st sector of second FAT)
0369+  4EA1             
0370+  4EA1 C3 A4 4E        jp _LOGICAL_FORMAT_WR_SECTORS
0371+  4EA4             
0372+  4EA4             
0373+  4EA4                 ;--- Write the contents of SECBUF repeatedly in a range of sectors
0374+  4EA4                 ;    Input: DE = first sector, B = how many sectors
0375+  4EA4             
0376+  4EA4             _LOGICAL_FORMAT_WR_SECTORS:
0377+  4EA4 DD E5           push ix
0378+  4EA6 D5              push de
0379+  4EA7 C5              push bc
0380+  4EA8 CD A5 50        call WK_GET_LAST_REL_DRIVE
0381+  4EAB C1              pop bc
0382+  4EAC D1              pop de
0383+  4EAD 67              ld h,a
0384+  4EAE             _LOGICAL_FORMAT_WR_SECTORS_LOOP:    
0385+  4EAE C5              push bc
0386+  4EAF D5              push de
0387+  4EB0 E5              push hl
0388+  4EB1 7C              ld a,h
0389+  4EB2 2A 4D F3        ld hl,(SECBUF)
0390+  4EB5 06 01           ld b,1
0391+  4EB7 37              scf
0392+  4EB8 CD F5 48        call DSKIO_IMPL
0393+  4EBB E1              pop hl
0394+  4EBC D1              pop de
0395+  4EBD C1              pop bc
0396+  4EBE 38 03           jr c,_LOGICAL_FORMAT_WR_SECTORS_LOOP_END
