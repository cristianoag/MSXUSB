0455+  6E22 19              add hl,de
0456+  6E23 36 2F           ld (hl),'/'
0457+  6E25 23              inc hl
0458+  6E26             _DSK_CHANGE_DIR_U_APPEND_OK: 
0459+  6E26 EB              ex de,hl
0460+  6E27             
0461+  6E27 E1              pop hl
0462+  6E28 E5              push hl
