0159+  5A6B             ; SNSMAT: Read the keyboard matrix
0160+  5A6B             ;
0161+  5A6B             ; This is the same SNSMAT provided by BIOS, it's copied here to avoid
0162+  5A6B             ; having to do an interslot call every time it's used
0163+  5A6B             ; -----------------------------------------------------------------------------
0164+  5A6B             
0165+  5A6B             DO_SNSMAT:
0166+  5A6B 4F              ld c,a
0167+  5A6C F3              di
0168+  5A6D DB AA           in a,(0AAh)
0169+  5A6F E6 F0           and 0F0h
0170+  5A71 81              add c
0171+  5A72 D3 AA           out (0AAh),a
0172+  5A74 FB              ei
0173+  5A75 DB A9           in a,(0A9h)
0174+  5A77 C9              ret
0175+  5A78             
0176+  5A78                 ;row 6:  F3     F2       F1  CODE    CAPS  GRAPH  CTRL   SHIFT
0177+  5A78                 ;row 7:  RET    SELECT   BS  STOP    TAB   ESC    F5     F4
0178+  5A78                 ;row 8:	 right  down     up  left    DEL   INS    HOME  SPACE
0179+  5A78             
0180+  5A78             
0181+  5A78             ; -----------------------------------------------------------------------------
0182+  5A78             ; BYTE2ASC: Convert a byte to ASCII
0183+  5A78             ; -----------------------------------------------------------------------------
0184+  5A78             ; Input: 	A  = Number to convert
0185+  5A78             ;           IX = Destination address for the string
0186+  5A78             ; Output:   IX points after the string
0187+  5A78             ; Modifies: AF, C
0188+  5A78             ; -----------------------------------------------------------------------------
0189+  5A78             
0190+  5A78             ;--- Convert a 1-byte number to an unterminated ASCII string
0191+  5A78             ;    Input:  A  = Number to convert
0192+  5A78             ;            IX = Destination address for the string
0193+  5A78             ;    Output: IX points after the string
0194+  5A78             ;    Modifies: AF, C
0195+  5A78             
0196+  5A78 FE 0A       BYTE2ASC:  cp  10
0197+  5A7A 38 0A         jr  c,B2A_1D
0198+  5A7C FE 64         cp  100
0199+  5A7E 38 0E         jr  c,B2A_2D
0200+  5A80 FE C8         cp  200
0201+  5A82 38 1A         jr  c,B2A_1XX
0202+  5A84 18 2C         jr  B2A_2XX
0203+  5A86             
0204+  5A86               ; One digit
0205+  5A86             
0206+  5A86 C6 30       B2A_1D:  add  "0"
0207+  5A88 DD 77 00      ld  (ix),a
0208+  5A8B DD 23         inc  ix
0209+  5A8D C9            ret
0210+  5A8E             
0211+  5A8E               ; Two digits
0212+  5A8E             
0213+  5A8E 0E 30       B2A_2D:  ld  c,"0"
0214+  5A90 0C          B2A_2D2:  inc  c
0215+  5A91 D6 0A         sub  10
0216+  5A93 FE 0A         cp  10
0217+  5A95 30 F9         jr  nc,B2A_2D2
0218+  5A97             
0219+  5A97 DD 71 00      ld  (ix),c
0220+  5A9A DD 23         inc  ix
0221+  5A9C 18 E8         jr  B2A_1D
0222+  5A9E             
0223+  5A9E               ; Between 100 and 199
0224+  5A9E             
0225+  5A9E DD 36 00 31 B2A_1XX:  ld  (ix),"1"
0226+  5AA2 D6 64         sub  100
0227+  5AA4 DD 23       B2A_XXX:  inc  ix
0228+  5AA6 FE 0A         cp  10
0229+  5AA8 30 E4         jr  nc,B2A_2D  ;If 1XY with X>0
0230+  5AAA DD 36 00 30   ld  (ix),"0"  ;If 10Y
0231+  5AAE DD 23         inc  ix
0232+  5AB0 18 D4         jr  B2A_1D
0233+  5AB2             
0234+  5AB2               ;--- Between 200 and 255
0235+  5AB2             
0236+  5AB2 DD 36 00 32 B2A_2XX:  ld  (ix),"2"
0237+  5AB6 D6 C8         sub  200
0238+  5AB8 18 EA         jr  B2A_XXX
0239+  5ABA             
0240+  5ABA             
0241+  5ABA             ;
0242+  5ABA             ; Divide 16-bit values (with 16-bit result)
0243+  5ABA             ; In: Divide BC by divider DE
0244+  5ABA             ; Out: BC = result, HL = rest
0245+  5ABA             ;
0246+  5ABA             DIVIDE_16:
