0451+  4159             
0452+  4159 C1              pop bc
0453+  415A F1              pop af  ;We need this to pass the next toggle to CH_ISSUE_TOKEN
0454+  415B             
0455+  415B 18 D2           jr _CH_DATA_IN_LOOP
0456+  415D             
0457+  415D             ;Input: A=Error code (if ERR), in stack: remaining length, new toggle
0458+  415D             _CH_DATA_IN_DONE:
0459+  415D AF              xor a
