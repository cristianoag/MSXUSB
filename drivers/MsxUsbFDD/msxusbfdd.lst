0120+  463E 21 C2 48        ld hl,DEVERR_PROBE1_S
0121+  4641 CD A2 46        call PRINT
0122+  4644 3A 90 FD        ld a,(USB_PROBE_ADDR1_STATUS)
0123+  4647 CD AB 46        call PRINT_HEX
0124+  464A 21 CF 48        ld hl,DEVERR_PROBE0_S
0125+  464D CD A2 46        call PRINT
0126+  4650 3A 91 FD        ld a,(USB_PROBE_ADDR0_STATUS)
0127+  4653 CD AB 46        call PRINT_HEX
0128+  4656             
0129+  4656                 if EP0_DIAGNOSTICS = 1
0130+  4656 21 DD 47        ld hl,CRLF_S
0131+  4659 CD A2 46        call PRINT
0132+  465C CD 1D 58        call DIAG_EP0
0133+  465F                 endif
0134+  465F             
0135+  465F             _VERBOSE_RESET_DIAG_END:
0136+  465F 21 DD 47        ld hl,CRLF_S
0137+  4662 C3 A2 46        jp PRINT
