0056   4924                 include "bank1/dskio_dskchg.asm"
0001+  4924             ; MSXUSB USB FDD BIOS
0002+  4924             ; Based on the Rookie Drive USB FDD BIOS created by Konamiman in 2018
0003+  4924             ; This version is adapted to work with the latest version of the MSXUSB project
0004+  4924             ;
0005+  4924             ; This file contains the implementation of the DSKIO, DSKCHG and GETDPB
0006+  4924             ; driver routines.
0007+  4924             
0008+  4924             
0009+  4924             ; Error codes used by DSKIO, DSKCHG and GETDPB:
0010+  4924             ;
0011+  4924             ; 0	write protect error
0012+  4924             ; 2	not ready error
0013+  4924             ; 4	data (crc) error
0014+  4924             ; 6	seek error
0015+  4924             ; 8	record not found error
0016+  4924             ; 10 write fault error
0017+  4924             ; 12 other error
0018+  4924             
0019+  4924             
0020+  4924             ; -----------------------------------------------------------------------------
0021+  4924             ; DSKIO
0022+  4924             ; -----------------------------------------------------------------------------
0023+  4924             ; Input: 	A	Drivenumber
0024+  4924             ;		F	Cx reset for read
0025+  4924             ;			Cx set for write
0026+  4924             ; 		B	number of sectors
0027+  4924             ; 		C	Media descriptor
