1483+  444E~                ld a,CH_CMD_SET_CONFIG
1484+  444E~                out (CH_COMMAND_PORT),a
1485+  444E~                ld a,b
1486+  444E~                out (CH_DATA_PORT),a
1487+  444E~            
1488+  444E~                call CH_WAIT_INT_AND_GET_RESULT
1489+  444E~                ret
1490+  444E~            
1491+  444E                 endif
1492+  444E             
1493+  444E             
1494+  444E             ; -----------------------------------------------------------------------------
1495+  444E             ; HW_SET_ADDRESS
1496+  444E             ;
1497+  444E             ; Exectute the standard SET_ADDRESS USB request.
1498+  444E             ; -----------------------------------------------------------------------------
1499+  444E             ; Input: A = Adress to assign
1500+  444E             
1501+  444E                 if HW_IMPL_SET_ADDRESS = 1
1502+  444E~            
