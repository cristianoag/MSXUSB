1863+  4556 28 04           jr z,_CH_WRITE_STRING_BAR
1864+  4558 ED 79           out (c),a
1865+  455A 18 F4           jr _CH_WRITE_STRING_LOOP
1866+  455C             
1867+  455C             _CH_WRITE_STRING_BAR:
1868+  455C AF              xor a
1869+  455D ED 79           out (c),a
1870+  455F C9              ret
0054   4560                 include "bank1/inihrd_inienv.asm"
0001+  4560             ; MSXUSB USB FDD BIOS
0002+  4560             ; Based on the Rookie Drive USB FDD BIOS created by Konamiman in 2018
0003+  4560             ; This version is adapted to work with the latest version of the MSXUSB project
0004+  4560             ;
0005+  4560             ; This file contains the implementation of the INIHRD and INIENV
0006+  4560             ; driver routines.
0007+  4560             
0008+  4560             
0009+  4560             ; We do the hardware reset in INIENV and not in INIHRD
0010+  4560             ; because we need to setup the work area during reset, but work area
0011+  4560             ; is zeroed by kernel between INIHRD and INIENV.
0012+  4560             
0013+  4560             
0014+  4560             ; -----------------------------------------------------------------------------
0015+  4560             ; INIHRD
0016+  4560             ; -----------------------------------------------------------------------------
0017+  4560             ; Input:	None
