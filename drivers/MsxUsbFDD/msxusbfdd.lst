0001+  59DA             ; MSXUSB USB FDD BIOS
0002+  59DA             ; Based on the Rookie Drive USB FDD BIOS created by Konamiman in 2018
0003+  59DA             ; This version is adapted to work with the latest version of the MSXUSB project
0004+  59DA             ;
0005+  59DA             ; This file contains miscellaneous routines used by other modules.
0006+  59DA             
0007+  59DA             
0008+  59DA             ; -----------------------------------------------------------------------------
0009+  59DA             ; ASC_TO_ERR: Convert UFI ASC to DSKIO error
0010+  59DA             ; -----------------------------------------------------------------------------
0011+  59DA             ; Input:  A = ASC
0012+  59DA             ; Output: A = Error
0013+  59DA             ;         Cy = 1
0014+  59DA             
0015+  59DA             ASC_TO_ERR:
0016+  59DA CD E0 59        call _ASC_TO_ERR
0017+  59DD 7C              ld a,h
0018+  59DE 37              scf
0019+  59DF C9              ret
0020+  59E0             
0021+  59E0             _ASC_TO_ERR:
0022+  59E0 FE 27           cp 27h      ;Write protected
0023+  59E2 26 00           ld h,0
0024+  59E4 C8              ret z
0025+  59E5 FE 3A           cp 3Ah      ;Not ready
0026+  59E7 26 02           ld h,2
0027+  59E9 C8              ret z
0028+  59EA FE 10           cp 10h      ;CRC error
0029+  59EC 26 04           ld h,4
0030+  59EE C8              ret z
0031+  59EF FE 21           cp 21h      ;Invalid logical block
0032+  59F1 26 06           ld h,6
0033+  59F3 C8              ret z
0034+  59F4 FE 02           cp 02h      ;Seek error
0035+  59F6 C8              ret z
0036+  59F7 FE 03           cp 03h
0037+  59F9 26 0A           ld h,10
0038+  59FB C8              ret z
0039+  59FC 26 0C           ld h,12     ;Other error
0040+  59FE C9              ret
