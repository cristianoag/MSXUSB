0407+  4125             ; This entry point is used when target device address is already set
0408+  4125             CH_DATA_IN_TRANSFER:
0409+  4125 3E 00           ld a,0
0410+  4127 1F              rra     ;Toggle to bit 7 of A
0411+  4128 DD 21 00 00     ld ix,0 ;IX = Received so far count
0412+  412C D5              push de
0413+  412D FD E1           pop iy  ;IY = EP size + EP number
0414+  412F             
