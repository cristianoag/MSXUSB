1514+  443D             ; HW_CONFIGURE_NAK_RETRY
1515+  443D             ; -----------------------------------------------------------------------------
1516+  443D             ; Input: Cy = 0 to retry for a limited time when the device returns NAK
1517+  443D             ;               (this is the default)
