0148+  4679             
0149+  4679                 ;--- Reset the USB hardware and try to initialize the device as a FDD
0150+  4679                 ;    Output: A = 0: Ok, device is a FDD
0151+  4679                 ;                1: Device is not a FDD
0152+  4679                 ;                2: Error when initializing the device, H = USB error code
0153+  4679                 ;                3: Error when resetting the USB hardware
0154+  4679                 ;                4: No device connected
0155+  4679             
0156+  4679             _VERBOSE_RESET_INIT_FDD:
0157+  4679 06 05           ld b,5
0158+  467B             _HW_RESET_TRY:
0159+  467B C5              push bc
0160+  467C CD 44 40        call HW_RESET
0161+  467F C1              pop bc
0162+  4680 30 05           jr nc,_HW_RESET_TRY_OK
0163+  4682 10 F7           djnz _HW_RESET_TRY
0164+  4684 3E 03           ld a,3
0165+  4686 C9              ret
0166+  4687             _HW_RESET_TRY_OK:
0167+  4687 3C              inc a
0168+  4688 3E 04           ld a,4
0169+  468A C8              ret z
0170+  468B             
0171+  468B 06 05           ld b,5
0172+  468D             _TRY_USB_INIT_DEV:
0173+  468D C5              push bc
0174+  468E CD C8 51        call USB_INIT_DEV
0175+  4691 60              ld h,b
0176+  4692 C1              pop bc
0177+  4693 FE 02           cp 2
0178+  4695 D8              ret c
0179+  4696 E5              push hl
0180+  4697 C5              push bc
0181+  4698 CD 0A 42        call HW_BUS_RESET   ;Get the device back to the default state before retrying
0182+  469B C1              pop bc
0183+  469C E1              pop hl
0184+  469D 10 EE           djnz _TRY_USB_INIT_DEV
0185+  469F 3E 02           ld a,2
0186+  46A1 C9              ret
0187+  46A2             
0188+  46A2                 if WAIT_KEY_ON_INIT = 1
0189+  46A2~            INIHRD_NEXT:
