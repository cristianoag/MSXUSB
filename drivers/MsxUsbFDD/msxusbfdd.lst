0463+  4052 C0          	ret	nz			; yep, return it (flag NZ)
0464+  4053 DD E5       	push	ix
0465+  4055 DD 21 9C 00 	ld	ix,CHSNS
0466+  4059 CD AB 40    	call	A40AB			; CHSNS BIOS call
