0256+  407E             ; HW_CONTROL_TRANSFER: Perform a USB control transfer on endpoint 0
0257+  407E             ;
0258+  407E             ; The size and direction of the transfer are taken from the contents
0259+  407E             ; of the setup packet.
0260+  407E             ; -----------------------------------------------------------------------------
0261+  407E             ; Input:  HL = Address of a 8 byte buffer with the setup packet
0262+  407E             ;         DE = Address of the input or output data buffer
0263+  407E             ;         A  = Device address
0264+  407E             ;         B  = Maximum packet size for endpoint 0
0265+  407E             ; Output: A  = USB error code
