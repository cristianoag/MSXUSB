0515+  5161             _WK_ADDHLA:
0516+  5161 4F          	ld c,a
0517+  5162 09          	add hl,bc
0518+  5163 C9          	ret    
0059   5164                 include "bank1/usb.asm"
0001+  5164             ; MSXUSB USB FDD BIOS
0002+  5164             ; Based on the Rookie Drive USB FDD BIOS created by Konamiman in 2018
0003+  5164             ; This version is adapted to work with the latest version of the MSXUSB project
0004+  5164             ;
0005+  5164             ; This file contains the "high level" (hardware independent)
0006+  5164             ; USB operation routines, including the ones related to the CBI protocol.
0007+  5164             ; It also contains the code that detects if the connected device is a proper FDD
0008+  5164             ; and initializes the work area accordingly.
0009+  5164             ;
0010+  5164             ; Connecting a FDD via a hub is allowed since v2.1, useful when the MSX itself
0011+  5164             ; can't provide enough power for it. A simplified approach to hub initializttion
0012+  5164             ; and handling is taken:
0013+  5164             ;
0014+  5164             ; - Number of ports isn't checked, max 7 ports are assumed. If powering a port results
0015+  5164             ;   in error, it is assumed that there are no more ports remaining.
0016+  5164             ; - No actual check is done for a device being a attached to a given port.
0017+  5164             ;   If resetting the port fails, it is assumed that there is no device in that port.
0018+  5164             ; - Ports are powered one by one until one is found having an attached device,
0019+  5164             ;   even if that device isn't an FDD.
0020+  5164             ; - The change notification endpoint isn't used. If trying to accessing the device 
0021+  5164             ;   (via hub or not) throws an error, a full reset and initialization is done again.
0022+  5164             
0023+  5164             
0024+  5164             USB_DEVICE_ADDRESS: equ 1
0025+  5164             HUB_DEVICE_ADDRESS: equ 2
0026+  5164             
0027+  5164             ;Scratch byte holding the current USB_INIT_DEV step, for error reporting
0028+  5164             ;(PROCNM is also used as scratch space for the device VID and PID)
0029+  5164             USB_INIT_STEP: equ PROCNM+4
0030+  5164             ;CH_LAST_STATUS is PROCNM+5 (see ch376.asm)
0031+  5164             USB_INIT_LAST_STATUS: equ PROCNM+6
0032+  5164             USB_PROBE_ADDR1_STATUS: equ PROCNM+7
0033+  5164             USB_PROBE_ADDR0_STATUS: equ PROCNM+8
0034+  5164             ;PROCNM+9 to PROCNM+13 are used by ch376.asm
0035+  5164             USB_INIT_NAK_COUNT: equ PROCNM+14   ;Word
0036+  5164             
0037+  5164             USB_CLASS_MASS: equ 8
0038+  5164             USB_SUBCLASS_CBI: equ 4
0039+  5164             USB_PROTO_WITH_INT_EP: equ 0
0040+  5164             
0041+  5164             USB_CLASS_HUB: equ 9
0042+  5164             
0043+  5164             
0044+  5164             ; -----------------------------------------------------------------------------
0045+  5164             ; USB_CHECK_DEV_CHANGE
0046+  5164             ;
0047+  5164             ; Check if a device connection or disconnection has happened.
0048+  5164             ; On device connection, initialize it.
0049+  5164             ; On device disconnection, clear work area.
0050+  5164             ; -----------------------------------------------------------------------------
0051+  5164             ; Output: Cy = 0 if a properly initialized CBI or storage device is connected
0052+  5164             ;              1 if not
0053+  5164             
0054+  5164             USB_CHECK_DEV_CHANGE:
0055+  5164 CD 69 40        call HW_DEV_CHANGE
0056+  5167 38 2B           jr c,_USB_CHECK_DEV_CHANGE_NO_DEV   ;Device present, but bus reset failed
0057+  5169             
0058+  5169 B7              or a
0059+  516A 20 06           jr nz,_USB_CHECK_DEV_CHANGE_CHANGED
0060+  516C             
0061+  516C                 ;* No device change detected, rely on work area
0062+  516C             
0063+  516C CD 0F 50        call WK_HAS_CONTENTS
0064+  516F D0              ret nc
0065+  5170 37              scf
0066+  5171 C9              ret
0067+  5172             
0068+  5172                 ;* Device change detected, act accordingly
0069+  5172             
0070+  5172             _USB_CHECK_DEV_CHANGE_CHANGED:
0071+  5172 3C              inc a
0072+  5173 28 1F           jr z,_USB_CHECK_DEV_CHANGE_NO_DEV   ;Disconnected
0073+  5175             
0074+  5175 CD 99 51        call USB_INIT_DEV
0075+  5178 B7              or a
0076+  5179 C8              ret z   ;Initialization OK
0077+  517A 3D              dec a
0078+  517B 20 17           jr nz,_USB_CHECK_DEV_CHANGE_NO_DEV
0079+  517D             
0080+  517D                 ;* Device present but it's not a FDD: check if it's a storage device
0081+  517D             
0082+  517D CD EE 50        call WK_GET_STORAGE_DEV_FLAGS   ;No disk mounted for now
0083+  5180 E6 FE           and 0FEh
0084+  5182 CD 01 51        call WK_SET_STORAGE_DEV_FLAGS
0085+  5185                 
0086+  5185 CD 49 42        call HWF_MOUNT_DISK
0087+  5188 38 0A           jr c,_USB_CHECK_DEV_CHANGE_NO_DEV
0088+  518A CD D8 70        call DSK_INIT_WK_FOR_STORAGE_DEV
0089+  518D 3E 01           ld a,1
0090+  518F CD 64 6F        call DSK_DO_BOOT_PROC
0091+  5192 B7              or a
0092+  5193 C9              ret
0093+  5194             
0094+  5194                 ;* No device, or device initialization failed
0095+  5194             
0096+  5194             _USB_CHECK_DEV_CHANGE_NO_DEV:
0097+  5194 CD C7 4F        call WK_ZERO
0098+  5197 37              scf
0099+  5198 C9              ret
0100+  5199             
0101+  5199             
0102+  5199             ; -----------------------------------------------------------------------------
0103+  5199             ; USB_INIT_DEV: Initialize USB device and work area
0104+  5199             ;
0105+  5199             ; This routine is invoked after a device connections is detected.
0106+  5199             ; If checks if the device is a CBI FDD, and if so, configures it
0107+  5199             ; and initializes the work area; if not, it empties the work area.
0108+  5199             ; -----------------------------------------------------------------------------
0109+  5199             ; Output: A = Initialization result
0110+  5199             ;             0: Ok, device is a CBI FDD
0111+  5199             ;             1: The device is not a CBI FDD
0112+  5199             ;             2: Error when querying or initializing the device
0113+  5199             ;         B = USB error code if A = 2
0114+  5199             
0115+  5199             USB_INIT_DEV_STACK_SPACE: equ 64
0116+  5199             
0117+  5199             USB_INIT_DEV:
0118+  5199 DD 21 C0 FF     ld ix,-USB_INIT_DEV_STACK_SPACE
0119+  519D DD 39           add ix,sp
0120+  519F DD F9           ld sp,ix
0121+  51A1 DD E5           push ix
0122+  51A3 E1              pop hl
0123+  51A4             
0124+  51A4 E5              push hl
0125+  51A5 CD C7 4F        call WK_ZERO
0126+  51A8             
0127+  51A8                 ;--- Initialize work area: assume max endpoint 0 packet size is 64 bytes,
0128+  51A8                 ;    like Windows does. A device with a smaller size will then send
0129+  51A8                 ;    a short packet and the first request will end after 8 bytes,
0130+  51A8                 ;    which is enough to know the actual endpoint 0 max packet size.
0131+  51A8             
0132+  51A8 3E 40           ld a,64
0133+  51AA 06 02           ld b,2
0134+  51AC CD A3 4F        call WK_SET_EP_SIZE
0135+  51AF             
0136+  51AF                 ;The enumeration sequence mimics the one used by Windows, since some devices
0137+  51AF                 ;(e.g. TEAC FD-05PUB) are known to work with it and misbehave otherwise:
0138+  51AF                 ;
0139+  51AF                 ;1. Get device descriptor at address 0, requesting 64 bytes
0140+  51AF                 ;   (with an assumed endpoint 0 max packet size of 64 bytes)
0141+  51AF                 ;2. Bus reset again
0142+  51AF                 ;3. SET_ADDRESS
0143+  51AF                 ;4. Get the full device descriptor and the configuration descriptor
0144+  51AF                 ;   at the new address
0145+  51AF                 ;5. SET_CONFIGURATION
0146+  51AF                 ;
0147+  51AF                 ;Descriptors are read with our own control transfer routine, which honors the
0148+  51AF                 ;endpoint 0 max packet size and handles multi-packet data stages
0149+  51AF                 ;(it's 8 bytes in some FDDs, e.g. TEAC FD-05PUB).
0150+  51AF                 ;
0151+  51AF                 ;The current step number is stored at USB_INIT_STEP for error reporting.
0152+  51AF             
0153+  51AF D1              pop de
0154+  51B0             _USB_INIT_DEV_RESTART:  ;Jumps here after hub init if hub is detected
0155+  51B0 D5              push de
0156+  51B1             
0157+  51B1                 ;--- Step 1: Get device descriptor at address 0, grab max endpoint 0 packet size
0158+  51B1             
0159+  51B1 3E 01           ld a,1
0160+  51B3 32 8D FD        ld (USB_INIT_STEP),a
0161+  51B6 21 4D 55        ld hl,USB_CMD_GET_DEV_DESC_64
0162+  51B9 AF              xor a
0163+  51BA CD 67 54        call _USB_INIT_CONTROL_TRANSFER
0164+  51BD             
0165+  51BD DD E1           pop ix
0166+  51BF B7              or a
0167+  51C0 C2 54 53        jp nz,_USB_INIT_DEV_ERR
0168+  51C3             
0169+  51C3                 ;The endpoint 0 max packet size must be known before any other request
0170+  51C3                 ;with a data stage longer than 8 bytes is issued (also for hubs)
0171+  51C3             
0172+  51C3 DD 7E 07        ld a,(ix+7)
0173+  51C6 DD E5           push ix
0174+  51C8 06 02           ld b,2
0175+  51CA CD A3 4F        call WK_SET_EP_SIZE
0176+  51CD DD E1           pop ix
0177+  51CF             
0178+  51CF CD CD 50        call WK_GET_MISC_FLAGS
0179+  51D2 E6 01           and 1
0180+  51D4 20 19           jr nz,_USB_INIT_SET_ADDRESS ;Device behind a hub: don't check hub again, don't reset the bus
0181+  51D6 DD 7E 04        ld a,(ix+4)
0182+  51D9 FE 09           cp USB_CLASS_HUB
0183+  51DB CA 75 54        jp z,_USB_INIT_HUB_FOUND
0184+  51DE             
0185+  51DE                 ;--- Step 2: Bus reset
0186+  51DE             
0187+  51DE 3E 02           ld a,2
0188+  51E0 32 8D FD        ld (USB_INIT_STEP),a
0189+  51E3 DD E5           push ix
0190+  51E5 CD 1B 42        call HW_BUS_RESET
0191+  51E8 DD E1           pop ix
0192+  51EA 3E 07           ld a,USB_ERR_UNEXPECTED_STATUS_FROM_HOST
0193+  51EC DA 54 53        jp c,_USB_INIT_DEV_ERR
0194+  51EF             
0195+  51EF                 ;--- Step 3: Assign an address to the device
0196+  51EF             
0197+  51EF             _USB_INIT_SET_ADDRESS:
0198+  51EF 3E 03           ld a,3
0199+  51F1 32 8D FD        ld (USB_INIT_STEP),a
0200+  51F4 DD E5           push ix
0201+  51F6             
0202+  51F6                 if HW_IMPL_SET_ADDRESS = 1
0203+  51F6~            
0204+  51F6~                ld a,USB_DEVICE_ADDRESS
0205+  51F6~                call HW_SET_ADDRESS
0206+  51F6~            
0207+  51F6                 else
0208+  51F6             
0209+  51F6 21 6D 55        ld hl,USB_CMD_SET_ADDRESS
0210+  51F9 11 00 00        ld de,0 ;No data will be actually transferred
0211+  51FC AF              xor a
0212+  51FD CD 67 54        call _USB_INIT_CONTROL_TRANSFER
0213+  5200 CD 3C 55        call _USB_SET_ADDRESS_RECOVERY
0214+  5203             
0215+  5203                 endif
0216+  5203             
0217+  5203 DD E1           pop ix
0218+  5205 B7              or a
0219+  5206 C2 54 53        jp nz,_USB_INIT_DEV_ERR
0220+  5209             
0221+  5209                 ;--- Step 4: Get the full device descriptor
0222+  5209             
0223+  5209 3E 04           ld a,4
0224+  520B 32 8D FD        ld (USB_INIT_STEP),a
0225+  520E DD E5           push ix
0226+  5210 D1              pop de
0227+  5211 D5              push de
0228+  5212 21 55 55        ld hl,USB_CMD_GET_DEV_DESC_18
0229+  5215 3E 01           ld a,USB_DEVICE_ADDRESS
0230+  5217 CD 67 54        call _USB_INIT_CONTROL_TRANSFER
0231+  521A DD E1           pop ix
0232+  521C B7              or a
0233+  521D 28 1A           jr z,_USB_INIT_DEV_DESC_OK
0234+  521F             
0235+  521F                 ;Some devices (e.g. TEAC FD-05PUB with endpoint 0 max packet size of 8 bytes)
0236+  521F                 ;never deliver the second packet of a control IN data stage to the CH376
0237+  521F                 ;(they NAK it indefinitely), but they work otherwise. In that case the first
0238+  521F                 ;packet is used, and the device is handled in "single packet mode":
0239+  521F                 ;only the first 8 bytes of the descriptors are read, and a standard
0240+  521F                 ;CBI+UFI interface layout is assumed (see _USB_INIT_FAKE_CONFIG_DESC).
0241+  521F             
0242+  521F FE 01           cp USB_ERR_NAK
0243+  5221 C2 54 53        jp nz,_USB_INIT_DEV_ERR
0244+  5224 79              ld a,c
0245+  5225 FE 08           cp 8
