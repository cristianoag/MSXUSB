0280+  5AE0             ; SCANKEYS: Scan all the numeric and alphabetic keys,
0281+  5AE0             ;           including the numeric keyboard.
0282+  5AE0             ; -----------------------------------------------------------------------------
0283+  5AE0             ; Input: 	A = 0 for international keyboard, 1 for Russian keyboard
0284+  5AE0             ; Output:   Keys in HLDEB (1 bit each, set if pressed):
0285+  5AE0             ;           B: 76543210
0286+  5AE0             ;           E: FEDCBA98
0287+  5AE0             ;           D: NMLKJIHG
0288+  5AE0             ;           L: VUTSRQPO
0289+  5AE0             ;           H: ....ZYXW
0290+  5AE0             ;
0291+  5AE0             ;           H holds also the status of CODE/KANA, GRAPH, CTRL and SHIFT
0292+  5AE0             ;           on bits 7,6,5,4 respectively.
0293+  5AE0             ; Mofifies: AF, C
0294+  5AE0             ; -----------------------------------------------------------------------------
0295+  5AE0             
0296+  5AE0             SK_ROW_0: equ 0
0297+  5AE0             SK_ROW_1: equ 1
0298+  5AE0             SK_ROW_2: equ 2
0299+  5AE0             SK_ROW_3: equ 3
0300+  5AE0             SK_ROW_4: equ 4
0301+  5AE0             SK_ROW_5: equ 5
0302+  5AE0             SK_ROW_6: equ 6
0303+  5AE0             SK_ROW_9: equ 7
0304+  5AE0             SK_ROW_10: equ 8
0305+  5AE0             SK_B: equ 9
0306+  5AE0             SK_E: equ 10
0307+  5AE0             SK_D: equ 11
0308+  5AE0             SK_L: equ 12
0309+  5AE0             SK_H: equ 13
0310+  5AE0             
0311+  5AE0             SK_SIZE: equ 14
0312+  5AE0             
0313+  5AE0             SCANKEYS:
0314+  5AE0 FD E5           push iy
0315+  5AE2 FD 21 F2 FF     ld iy,-SK_SIZE
0316+  5AE6 FD 39           add iy,sp
0317+  5AE8 FD F9           ld sp,iy
0318+  5AEA             
0319+  5AEA F5              push af
0320+  5AEB 01 00 07        ld bc,0700h
0321+  5AEE FD E5           push iy
0322+  5AF0 E1              pop hl
0323+  5AF1 CD D8 5B        call SK_GET_ROWS
0324+  5AF4             
0325+  5AF4 01 09 02        ld bc,0209h
