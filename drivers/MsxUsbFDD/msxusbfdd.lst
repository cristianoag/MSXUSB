1279+  570E                 ;Report success if the error is one of the "recovered data" (17h or 18h)
1280+  570E             
1281+  570E FE 17           cp 17h
1282+  5710 28 27           jr z,_USB_ECBIR_POPALL_END
1283+  5712 FE 18           cp 18h
1284+  5714 28 23           jr z,_USB_ECBIR_POPALL_END
1285+  5716             
1286+  5716                 ;Retry if ASC=4 and ASCQ=1 (unit becoming ready) or FFh (unit busy)
1287+  5716             
