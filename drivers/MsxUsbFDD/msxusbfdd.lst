0499+  4176 78              ld a,b 
0500+  4177 B7              or a
0501+  4178 FD 7C           ld a,iyh
0502+  417A 20 07           jr nz,_CH_DATA_OUT_DO
0503+  417C 79              ld a,c
0504+  417D FD BC           cp iyh
0505+  417F 38 02           jr c,_CH_DATA_OUT_DO
