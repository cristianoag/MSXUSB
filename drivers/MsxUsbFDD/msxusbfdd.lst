0080+  6CDC D1              pop de
0081+  6CDD E1              pop hl
0082+  6CDE C0              ret nz
0083+  6CDF 3E 01           ld a,1
0084+  6CE1 D0              ret nc
0085+  6CE2             
0086+  6CE2 D5              push de
0087+  6CE3 C5              push bc
0088+  6CE4 CD 66 42        call HWF_OPEN_FILE_DIR
0089+  6CE7 C1              pop bc
0090+  6CE8 D1              pop de
0091+  6CE9 C0              ret nz
0092+  6CEA 3E 01           ld a,1
0093+  6CEC D8              ret c
0094+  6CED             
0095+  6CED EB              ex de,hl
0096+  6CEE 48              ld c,b
0097+  6CEF 06 00           ld b,0
0098+  6CF1 E5              push hl
0099+  6CF2 CD A6 43        call HWF_READ_FILE
0100+  6CF5 EB              ex de,hl
0101+  6CF6 E1              pop hl
0102+  6CF7 06 00           ld b,0
0103+  6CF9 B7              or a
0104+  6CFA C0              ret nz
0105+  6CFB             
0106+  6CFB                 ;Search for CR or LF
0107+  6CFB             
0108+  6CFB 79              ld a,c
0109+  6CFC B7              or a
0110+  6CFD 28 10           jr z,_DSK_READ_CONFIG_FILE_END
0111+  6CFF             
0112+  6CFF 41              ld b,c
