0682+  421B             ; HW_BUS_RESET: Performs a USB bus reset.
0683+  421B             ;
0684+  421B             ; This needs to run when a device connection is detected.
0685+  421B             ; -----------------------------------------------------------------------------
0686+  421B             ; Output: A  = 1
0687+  421B             ;         Cy = 1 on error
0688+  421B             
0689+  421B             HW_BUS_RESET:
0690+  421B 3E 07           ld a,7
0691+  421D CD E6 44        call CH_SET_USB_MODE
