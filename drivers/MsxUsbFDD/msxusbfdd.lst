0558+  6E8E FD 39           add iy,sp
0559+  6E90 FD F9           ld sp,iy
0560+  6E92 FD E1           pop iy
0561+  6E94 C9              ret
0562+  6E95             
0563+  6E95             _DSK_MOUNT:
