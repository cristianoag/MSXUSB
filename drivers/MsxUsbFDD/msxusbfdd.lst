0121+  6D0C 0C              inc c
0122+  6D0D 10 F3           djnz _DSK_READ_CONFIG_FILE_LOOP
0123+  6D0F             
0124+  6D0F             _DSK_READ_CONFIG_FILE_END:
0125+  6D0F EB              ex de,hl
0126+  6D10 AF              xor a
