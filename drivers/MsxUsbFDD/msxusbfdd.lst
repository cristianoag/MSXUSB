0139+  4665             _VERBOSE_RESET_FDD_OK:
0140+  4665 CD FC 50        call WK_GET_MISC_FLAGS
0141+  4668 E6 01           and 1
0142+  466A 21 12 49        ld hl,HUB_FOUND_S
