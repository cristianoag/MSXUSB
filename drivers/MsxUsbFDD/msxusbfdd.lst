0451+  4FA3             
0452+  4FA3             
0453+  4FA3                 if 0
0454+  4FA3~            
0455+  4FA3~            ; -----------------------------------------------------------------------------
0456+  4FA3~            ; Get information about the disk currently in the drive
0457+  4FA3~            ; -----------------------------------------------------------------------------
0458+  4FA3~            ; Input:  A = 1 to retry "disk changed" error
0459+  4FA3~            ; Output: A = DSKIO error code (if Cy=1)
0460+  4FA3~            ;         Cy = 1 on error
0461+  4FA3~            ;         B = FFh if disk changed
0462+  4FA3~            ;              1 if disk unchanged
0463+  4FA3~            ;              (only if A=0 at input)
0464+  4FA3~            ;         C = bit 0: 1 if disk is already formatted
0465+  4FA3~            ;             bit 1: 0 if disk is 720k, 1 if disk is 1.44M
0466+  4FA3~            ;             (only if Cy=0 and B=1)
0467+  4FA3~            
0468+  4FA3~            _GET_DISK_INFO_STACK_SPACE: equ 12
0469+  4FA3~            
0470+  4FA3~            GET_DISK_INFO:
0471+  4FA3~            
0472+  4FA3~                if HW_IMPL_CONFIGURE_NAK_RETRY=1
0473+  4FA3~            
0474+  4FA3~                push af
0475+  4FA3~                scf
0476+  4FA3~                call HW_CONFIGURE_NAK_RETRY
0477+  4FA3~                pop af
0478+  4FA3~                call _GET_DISK_INFO
0479+  4FA3~                push af
0480+  4FA3~                or a
0481+  4FA3~                call HW_CONFIGURE_NAK_RETRY
0482+  4FA3~                pop af
0483+  4FA3~                ret
0484+  4FA3~            _GET_DISK_INFO:
0485+  4FA3~            
0486+  4FA3~                endif
0487+  4FA3~            
0488+  4FA3~                ld ix,-_GET_DISK_INFO_STACK_SPACE
0489+  4FA3~                add ix,sp
0490+  4FA3~                ld sp,ix
0491+  4FA3~            
0492+  4FA3~                push ix
0493+  4FA3~                pop de
0494+  4FA3~                ld hl,_UFI_READ_FORMAT_CAPACITIES_CMD
0495+  4FA3~                ld bc,12
0496+  4FA3~                or a
0497+  4FA3~                ld a,1
0498+  4FA3~                push ix
0499+  4FA3~                call USB_EXECUTE_CBI_WITH_RETRY
0500+  4FA3~                pop ix
0501+  4FA3~            
0502+  4FA3~                or a
0503+  4FA3~                ld a,12
0504+  4FA3~                scf
0505+  4FA3~                jr nz,_GET_DISK_INFO_END   ;Return "other error" on USB error
0506+  4FA3~            
0507+  4FA3~                ld a,d
0508+  4FA3~                or a
0509+  4FA3~                jr z,_GET_DISK_INFO_NO_ERR
0510+  4FA3~                cp 28h  ;"Disk changed" error
0511+  4FA3~                ld b,0FFh
0512+  4FA3~                jr z,_GET_DISK_INFO_OK
0513+  4FA3~                jr _GET_DISK_INFO_ASC_ERR
0514+  4FA3~            
0515+  4FA3~            _GET_DISK_INFO_NO_ERR:
0516+  4FA3~            
0517+  4FA3~                ;Useful information returned by the Read Format Capacities command:
0518+  4FA3~                ;+6: High byte of disk capacity in sectors:
0519+  4FA3~                ;    5h: 720K
0520+  4FA3~                ;    4h: 1.25M
0521+  4FA3~                ;    Bh: 1.44M 
0522+  4FA3~                ;+8: Disk format status:
0523+  4FA3~                ;    01b: unformatted
0524+  4FA3~                ;    10b: formatted
0525+  4FA3~                ;    11b: no disk in drive
0526+  4FA3~            
0527+  4FA3~                ld a,(ix+8)
0528+  4FA3~                and 11b
0529+  4FA3~                cp 3
0530+  4FA3~                ld a,2
0531+  4FA3~                scf
0532+  4FA3~                jr z,_GET_DISK_INFO_END     ;Return "not ready" if no disk present
0533+  4FA3~            
0534+  4FA3~                ld a,(ix+8)
0535+  4FA3~                and 1
0536+  4FA3~                xor 1
0537+  4FA3~                ld c,a  ;Now C = 0 for unformatted disk, 1 for formatted disk
0538+  4FA3~            
0539+  4FA3~                ld b,1  ;Disk not changed
0540+  4FA3~                ld a,(ix+6)
0541+  4FA3~                cp 05h
0542+  4FA3~                jr z,_GET_DISK_INFO_OK
0543+  4FA3~                set 1,c
0544+  4FA3~                cp 0Bh
0545+  4FA3~                jr z,_GET_DISK_INFO_OK
0546+  4FA3~            
0547+  4FA3~                ld c,10b    ;If the disk is 1.25M, report it as unformatted 1.44M
0548+  4FA3~                jr _GET_DISK_INFO_END
0549+  4FA3~            
0550+  4FA3~            _GET_DISK_INFO_ASC_ERR:
0551+  4FA3~                call ASC_TO_ERR
0552+  4FA3~                scf
0553+  4FA3~                jr _GET_DISK_INFO_END
0554+  4FA3~            _GET_DISK_INFO_OK:
0555+  4FA3~                xor a
0556+  4FA3~            _GET_DISK_INFO_END:
0557+  4FA3~                push af
0558+  4FA3~                pop hl
0559+  4FA3~                ld ix,_GET_DISK_INFO_STACK_SPACE
0560+  4FA3~                add ix,sp
0561+  4FA3~                ld sp,ix
0562+  4FA3~                push hl
0563+  4FA3~                pop af
0564+  4FA3~                ret
0565+  4FA3~            
0566+  4FA3~            _UFI_READ_FORMAT_CAPACITIES_CMD:
0567+  4FA3~                db 23h, 0, 0, 0, 0, 0, 0, 0, 12, 0, 0, 0
0568+  4FA3~            
0569+  4FA3                 endif
0058   4FA3                 include "bank1/work_area.asm"
0001+  4FA3             ; MSXUSB USB FDD BIOS
0002+  4FA3             ; Based on the Rookie Drive USB FDD BIOS created by Konamiman in 2018
0003+  4FA3             ; This version is adapted to work with the latest version of the MSXUSB project
0004+  4FA3             ;
0005+  4FA3             ; This file contains the work area handling cod.
0006+  4FA3             ; We use the 8 bytes available for our slot at SLTWRK.
0007+  4FA3             
0008+  4FA3             
0009+  4FA3             ; Work area definition when a FDD is connected:
0010+  4FA3             ;
0011+  4FA3             ; +0: Bulk OUT endpoint parameters
0012+  4FA3             ; +1: Bulk IN endpoint parameters
0013+  4FA3             ; +2: Interrupt IN endpoint parameters
0014+  4FA3             ; +3: Interface number for the ADSC setup packet
0015+  4FA3             ; +4: Bits 0-3: Last relative drive accessed
0016+  4FA3             ;     Bits 4-7: Misc flags
0017+  4FA3             ;               0: set if USB hub found
0018+  4FA3             ; +5: Last USB error (for CALL USBERROR)
0019+  4FA3             ; +6: Last ASC (for CALL USBERROR)
0020+  4FA3             ; +7: Last ASCQ (for CALL USBERROR)
0021+  4FA3             ;
0022+  4FA3             ; Endpoint parameters are:
0023+  4FA3             ;   bits 7 and 3-0: Endpoint number
0024+  4FA3             ;   bit 4: Toggle bit state
0025+  4FA3             ;   bits 6-5: Endpoint max packet size
0026+  4FA3             ;
0027+  4FA3             ; For +2 what 6-5 actually stores is the endpoint 0 max packet size,
0028+  4FA3             ; the max packet size of the interrupt IN endpoint is assumed to be 2.
0029+  4FA3             ;
0030+  4FA3             ; Max packet size is stored encoded as follows:
0031+  4FA3             ;  00 = 8 bytes
0032+  4FA3             ;  01 = 16 bytes
0033+  4FA3             ;  10 = 32 bytes
0034+  4FA3             ;  11 = 64 bytes
0035+  4FA3             ;
0036+  4FA3             ; Work area definition when a storage device is connected:
0037+  4FA3             ;
0038+  4FA3             ; +0: flags:
0039+  4FA3             ;     bit 7: set to 1, indicates a storage device is connected
0040+  4FA3             ;            (if a floppy is connected it'll be 0 since the byte holds
0041+  4FA3             ;             the OUT endpoint number)
0042+  4FA3             ;     bit 0: set to 1 if there's a file mounted
0043+  4FA3             ;     bit 1: set if mounted in read only mode
0044+  4FA3             ;     bit 2: set if file has changed
0045+  4FA3             ;     bit 3: set to enable CAPS lit on disk access
0046+  4FA3             ; +1: Current directory depth:
0047+  4FA3             ;     0: no directory currently open
0048+  4FA3             ;     1: root directory, etc
0049+  4FA3             ; 
0050+  4FA3             ; If no device is connected or the connected device is not a CBI FDD,
0051+  4FA3             ; or if some error occurred during USB hardware or device initialization,
0052+  4FA3             ; the work area contents is all zero 
0053+  4FA3             ; (the last relative drive accessed is always preserved)
0054+  4FA3             
0055+  4FA3             
0056+  4FA3             ; -----------------------------------------------------------------------------
0057+  4FA3             ; Store the size of an endpoint.
0058+  4FA3             ;
0059+  4FA3             ; Input: A = Size
0060+  4FA3             ;        B = work area byte (0-2)
0061+  4FA3             
0062+  4FA3             WK_SET_EP_SIZE:
0063+  4FA3 DD E5           push ix
0064+  4FA5 CD 26 51        call _WK_GET_POINTER
0065+  4FA8             
0066+  4FA8 0E 00           ld c,0
0067+  4FAA FE 08           cp 8
0068+  4FAC 28 0B           jr z,_WK_SET_EP_SIZE_DO
0069+  4FAE 0C              inc c
0070+  4FAF FE 10           cp 16
0071+  4FB1 28 06           jr z,_WK_SET_EP_SIZE_DO
0072+  4FB3 0C              inc c
0073+  4FB4 FE 20           cp 32
0074+  4FB6 28 01           jr z,_WK_SET_EP_SIZE_DO
0075+  4FB8 0C              inc c
0076+  4FB9             
0077+  4FB9             _WK_SET_EP_SIZE_DO:
0078+  4FB9 CB 09           rrc c
0079+  4FBB CB 09           rrc c
0080+  4FBD CB 09           rrc c
0081+  4FBF 7E              ld a,(hl)
0082+  4FC0 E6 9F           and 10011111b   ;Clear the old size (bits 6-5)
0083+  4FC2 B1              or c
0084+  4FC3 77              ld (hl),a
0085+  4FC4 DD E1           pop ix
0086+  4FC6 C9              ret
0087+  4FC7             
0088+  4FC7             
0089+  4FC7             ; -----------------------------------------------------------------------------
0090+  4FC7             ; Zero the entire work area except the last relative drive accessed
0091+  4FC7             
0092+  4FC7             WK_ZERO:
0093+  4FC7 DD E5           push ix
0094+  4FC9 CD 32 51        call _WK_GETWRK
0095+  4FCC DD 36 00 00     ld (ix),0
0096+  4FD0 DD 36 01 00     ld (ix+1),0
0097+  4FD4 DD 36 02 00     ld (ix+2),0
0098+  4FD8 DD 36 03 00     ld (ix+3),0
0099+  4FDC DD 36 05 00     ld (ix+5),0
0100+  4FE0 DD 36 06 00     ld (ix+6),0
0101+  4FE4 DD 36 07 00     ld (ix+7),0
0102+  4FE8 DD 7E 04        ld a,(ix+4)
0103+  4FEB E6 0F           and 0Fh
0104+  4FED DD 77 04        ld (ix+4),a
0105+  4FF0 DD E1           pop ix
0106+  4FF2 C9              ret
0107+  4FF3             
0108+  4FF3             
0109+  4FF3             ; -----------------------------------------------------------------------------
0110+  4FF3             ; Retrieve the stored size of an endpoint.
0111+  4FF3             ;
0112+  4FF3             ; Input:  B = work area byte (0-2)
0113+  4FF3             ; Output: B = size
0114+  4FF3             
0115+  4FF3             WK_GET_EP_SIZE:
0116+  4FF3 DD E5           push ix
0117+  4FF5 CD 26 51        call _WK_GET_POINTER
0118+  4FF8 DD E1           pop ix
0119+  4FFA 7E              ld a,(hl)
0120+  4FFB 07              rlca
0121+  4FFC 07              rlca
0122+  4FFD 07              rlca
0123+  4FFE E6 03           and 11b
0124+  5000             
0125+  5000 06 08           ld b,8
0126+  5002 B7              or a
0127+  5003 C8              ret z
0128+  5004 CB 20           sla b
0129+  5006 3D              dec a
0130+  5007 C8              ret z
0131+  5008 CB 20           sla b
0132+  500A 3D              dec a
0133+  500B C8              ret z
0134+  500C CB 20           sla b
0135+  500E             
0136+  500E C9              ret
0137+  500F             
0138+  500F             
0139+  500F             ; -----------------------------------------------------------------------------
0140+  500F             ; Check if the work area has content 
0141+  500F             ; (meaning that a proper device is initialized and ready to use)
0142+  500F             ;
0143+  500F             ; Output: Z and NC if work area is zeroed
0144+  500F             ;         NZ if work area has contents
0145+  500F             
0146+  500F             WK_HAS_CONTENTS:
0147+  500F DD E5           push ix
0148+  5011 CD 32 51        call _WK_GETWRK
0149+  5014 7E              ld a,(hl)
0150+  5015 B7              or a
0151+  5016 DD E1           pop ix
0152+  5018 C9              ret
0153+  5019             
0154+  5019             
0155+  5019             ; -----------------------------------------------------------------------------
0156+  5019             ; Store the number of an endpoint
0157+  5019             ;
0158+  5019             ; Input: A = endpoint number
0159+  5019             ;        B = work area byte (0-2)
0160+  5019             
0161+  5019             WK_SET_EP_NUMBER:
0162+  5019 DD E5           push ix
0163+  501B CD 26 51        call _WK_GET_POINTER
0164+  501E E6 8F           and 10001111b
0165+  5020 4F              ld c,a
0166+  5021 7E              ld a,(hl)
0167+  5022 E6 F0           and 11110000b
0168+  5024 B1              or c
0169+  5025 77              ld (hl),a
0170+  5026 DD E1           pop ix
0171+  5028 C9              ret
0172+  5029             
0173+  5029             
0174+  5029             ; -----------------------------------------------------------------------------
0175+  5029             ; Retrieve the stored number of an endpoint
0176+  5029             ;
0177+  5029             ; Input:  B = work area byte (0-2)
0178+  5029             ; Output: A = endpoint number
0179+  5029             
0180+  5029             WK_GET_EP_NUMBER:
0181+  5029 DD E5           push ix
0182+  502B CD 26 51        call _WK_GET_POINTER
0183+  502E 7E              ld a,(hl)
0184+  502F E6 8F           and 10001111b
0185+  5031 DD E1           pop ix
0186+  5033 C9              ret
0187+  5034             
0188+  5034             
0189+  5034             ; -----------------------------------------------------------------------------
0190+  5034             ; Store the toggle bit status for an endpoint
0191+  5034             ;
0192+  5034             ; Input: Cy = toggle bit status
0193+  5034             ;        B  = work area byte (0-2)
0194+  5034             
0195+  5034             WK_SET_TOGGLE_BIT:
0196+  5034 DD E5           push ix
0197+  5036 CD 26 51        call _WK_GET_POINTER
0198+  5039 38 05           jr c,_WK_SET_TOGGLE_BIT_1
0199+  503B CB A6           res 4,(hl)
0200+  503D DD E1           pop ix
0201+  503F C9              ret
0202+  5040             _WK_SET_TOGGLE_BIT_1:
0203+  5040 CB E6           set 4,(hl)
0204+  5042 DD E1           pop ix
0205+  5044 C9              ret
0206+  5045             
0207+  5045             
0208+  5045             ; -----------------------------------------------------------------------------
0209+  5045             ; Retrieve the stored toggle bit status for an endpoint
0210+  5045             ;
0211+  5045             ; Input: B  = work area byte (0-2)
0212+  5045             ; Output: Cy = toggle bit status
0213+  5045             
0214+  5045             WK_GET_TOGGLE_BIT:
0215+  5045 DD E5           push ix
0216+  5047 CD 26 51        call _WK_GET_POINTER
0217+  504A CB 66           bit 4,(hl)
0218+  504C DD E1           pop ix
0219+  504E 37              scf
0220+  504F C0              ret nz
0221+  5050 3F              ccf
0222+  5051 C9              ret
0223+  5052             
0224+  5052             
0225+  5052             ; -----------------------------------------------------------------------------
0226+  5052             ; Store the interface number for the ADSC command
0227+  5052             ;
0228+  5052             ; Input: A = interface number
0229+  5052             
0230+  5052             WK_SET_IFACE_NUMBER:
0231+  5052 DD E5           push ix
0232+  5054 F5              push af
0233+  5055 CD 32 51        call _WK_GETWRK
0234+  5058 F1              pop af
0235+  5059 DD 77 03        ld (ix+3),a
0236+  505C DD E1           pop ix
0237+  505E C9              ret
0238+  505F             
0239+  505F             
0240+  505F             ; -----------------------------------------------------------------------------
0241+  505F             ; Retrieve the stored interface number for the ADSC command
0242+  505F             ;
0243+  505F             ; Output: A = interface number
0244+  505F             
0245+  505F             WK_GET_IFACE_NUMBER:
0246+  505F DD E5           push ix
0247+  5061 CD 32 51        call _WK_GETWRK
0248+  5064 DD 7E 03        ld a,(ix+3)
0249+  5067 DD E1           pop ix
0250+  5069 C9              ret
0251+  506A             
0252+  506A             
0253+  506A             ; -----------------------------------------------------------------------------
0254+  506A             ; Store information about the last USB error
0255+  506A             ; Input: A = USB error
0256+  506A             ;        D = ASC
0257+  506A             ;        E = ASCQ
0258+  506A             
0259+  506A             WK_SET_ERROR:
0260+  506A DD E5           push ix
0261+  506C F5              push af
0262+  506D D5              push de
0263+  506E CD 32 51        call _WK_GETWRK
0264+  5071 D1              pop de
0265+  5072 F1              pop af
0266+  5073 DD 77 05        ld (ix+5),a
0267+  5076 DD 72 06        ld (ix+6),d
0268+  5079 DD 73 07        ld (ix+7),e
0269+  507C DD E1           pop ix
0270+  507E C9              ret
0271+  507F             
0272+  507F             
0273+  507F             ; -----------------------------------------------------------------------------
0274+  507F             ; Retrieve the stored information about the last USB error
0275+  507F             ; Output: A = USB error
0276+  507F             ;         D = ASC
0277+  507F             ;         E = ASCQ
0278+  507F             
0279+  507F             WK_GET_ERROR:
0280+  507F DD E5           push ix
0281+  5081 CD 32 51        call _WK_GETWRK
0282+  5084 DD 7E 05        ld a,(ix+5)
0283+  5087 DD 56 06        ld d,(ix+6)
0284+  508A DD 5E 07        ld e,(ix+7)
0285+  508D DD E1           pop ix
0286+  508F C9              ret
0287+  5090             
0288+  5090             
0289+  5090             ; -----------------------------------------------------------------------------
0290+  5090             ; Store the last accessed relative drive
0291+  5090             ;
0292+  5090             ; Input: A = relative drive number
0293+  5090             
0294+  5090             WK_SET_LAST_REL_DRIVE:
0295+  5090 C5              push bc
0296+  5091 DD E5           push ix
0297+  5093 F5              push af
0298+  5094 CD 32 51        call _WK_GETWRK
0299+  5097 DD 7E 04        ld a,(ix+4)
0300+  509A E6 F0           and 11110000b
0301+  509C C1              pop bc
0302+  509D B0              or b
0303+  509E DD 77 04        ld (ix+4),a
0304+  50A1 DD E1           pop ix
0305+  50A3 C1              pop bc
0306+  50A4 C9              ret
0307+  50A5             
0308+  50A5             
0309+  50A5             ; -----------------------------------------------------------------------------
0310+  50A5             ; Retrieve the stored last accessed relative drive
0311+  50A5             ;
0312+  50A5             ; Output: A = relative drive number
0313+  50A5             
0314+  50A5             WK_GET_LAST_REL_DRIVE:
0315+  50A5 DD E5           push ix
0316+  50A7 CD 32 51        call _WK_GETWRK
