0078+  6ACD CD 77 42        call HWF_OPEN_FILE_DIR
0079+  6AD0 C1              pop bc
0080+  6AD1 D1              pop de
0081+  6AD2 E1              pop hl
0082+  6AD3 C0              ret nz
0083+  6AD4 3E 01           ld a,1
0084+  6AD6 D0              ret nc
0085+  6AD7             
0086+  6AD7 D5              push de
0087+  6AD8 C5              push bc
0088+  6AD9 CD 77 42        call HWF_OPEN_FILE_DIR
0089+  6ADC C1              pop bc
0090+  6ADD D1              pop de
0091+  6ADE C0              ret nz
0092+  6ADF 3E 01           ld a,1
0093+  6AE1 D8              ret c
0094+  6AE2             
0095+  6AE2 EB              ex de,hl
0096+  6AE3 48              ld c,b
0097+  6AE4 06 00           ld b,0
0098+  6AE6 E5              push hl
0099+  6AE7 CD B7 43        call HWF_READ_FILE
0100+  6AEA EB              ex de,hl
0101+  6AEB E1              pop hl
0102+  6AEC 06 00           ld b,0
0103+  6AEE B7              or a
0104+  6AEF C0              ret nz
0105+  6AF0             
0106+  6AF0                 ;Search for CR or LF
0107+  6AF0             
0108+  6AF0 79              ld a,c
0109+  6AF1 B7              or a
0110+  6AF2 28 10           jr z,_DSK_READ_CONFIG_FILE_END
0111+  6AF4             
0112+  6AF4 41              ld b,c
0113+  6AF5 0E 00           ld c,0
0114+  6AF7             _DSK_READ_CONFIG_FILE_LOOP:
0115+  6AF7 7E              ld a,(hl)
0116+  6AF8 FE 0D           cp 13
0117+  6AFA 28 08           jr z,_DSK_READ_CONFIG_FILE_END
0118+  6AFC FE 0A           cp 10
0119+  6AFE 28 04           jr z,_DSK_READ_CONFIG_FILE_END
0120+  6B00 23              inc hl
0121+  6B01 0C              inc c
0122+  6B02 10 F3           djnz _DSK_READ_CONFIG_FILE_LOOP
0123+  6B04             
0124+  6B04             _DSK_READ_CONFIG_FILE_END:
0125+  6B04 EB              ex de,hl
0126+  6B05 AF              xor a
0127+  6B06 41              ld b,c
0128+  6B07 C9              ret
0129+  6B08             
0130+  6B08             DSK_CONFIG_DIR_S:
0131+  6B08 5F55534200      db "_USB",0
0132+  6B0D             
0133+  6B0D             
0134+  6B0D             ; -----------------------------------------------------------------------------
0135+  6B0D             ; DSK_READ_MAIN_CONFIG_FILE: Read config file in main directory
0136+  6B0D             ; -----------------------------------------------------------------------------
0137+  6B0D             ; Input:  HL = File name
0138+  6B0D             ;         DE = Destination address
0139+  6B0D             ;         B  = Max amount of bytes to read
0140+  6B0D             ; Output: A  = 0: Ok
0141+  6B0D             ;              1: Other error
0142+  6B0D             ;              2: File not found
0143+  6B0D             ;         B  = Amount of bytes read if no error, 0 on error
0144+  6B0D             ;         DE = Pointer after last byte read
0145+  6B0D             
0146+  6B0D             DSK_READ_MAIN_CONFIG_FILE:
0147+  6B0D CD 9B 6A        call DSK_OPEN_MAIN_DIR
0148+  6B10 B7              or a
0149+  6B11 3E 01           ld a,1
0150+  6B13 48              ld c,b
0151+  6B14 06 00           ld b,0
0152+  6B16 C0              ret nz
0153+  6B17 41              ld b,c
0154+  6B18             
0155+  6B18 CD C7 6A        call DSK_READ_CONFIG_FILE
0156+  6B1B B7              or a
0157+  6B1C C8              ret z
0158+  6B1D 06 00           ld b,0
0159+  6B1F C9              ret
0160+  6B20             
0161+  6B20             
0162+  6B20             ; -----------------------------------------------------------------------------
0163+  6B20             ; DSK_WRITE_CONFIG_FILE: Write config file in current directory
0164+  6B20             ; -----------------------------------------------------------------------------
0165+  6B20             ; Input:  HL = File name
0166+  6B20             ;         DE = Source address
0167+  6B20             ;         B  = Amount of bytes to write, if 0 delete the file
0168+  6B20             ; Output: A  = 0: Ok
0169+  6B20             ;              1: Error
0170+  6B20             
0171+  6B20             DSK_WRITE_CONFIG_FILE:
