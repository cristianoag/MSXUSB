0001+  4582             ; MSXUSB USB FDD BIOS
0002+  4582             ; Based on the Rookie Drive USB FDD BIOS created by Konamiman in 2018
0003+  4582             ; This version is adapted to work with the latest version of the MSXUSB project
0004+  4582             ;
0005+  4582             ; This routine resets the USB hardware, resets and initializes the device,
0006+  4582             ; and prints the device name or the appropriate error message.
0007+  4582             ; It is executed at boot time and by CALL USBRESET.
0008+  4582             
0009+  4582             VERBOSE_RESET:
0010+  4582 FD E5           push iy
0011+  4584 FD 21 DC FF     ld iy,-36
0012+  4588 FD 39           add iy,sp
0013+  458A FD F9           ld sp,iy
0014+  458C CD 9A 45        call _VERBOSE_RESET
0015+  458F FD 21 24 00     ld iy,36
0016+  4593 FD 39           add iy,sp
0017+  4595 FD F9           ld sp,iy
0018+  4597 FD E1           pop iy
0019+  4599 C9              ret
0020+  459A             
0021+  459A             _VERBOSE_RESET:
0022+  459A AF              xor a
0023+  459B CD 30 51        call WK_SET_STORAGE_DEV_FLAGS
0024+  459E CD E1 50        call WK_SET_MISC_FLAGS
0025+  45A1             
0026+  45A1 CD 26 40        call HW_TEST
0027+  45A4 21 C1 47        ld hl,NOHARD_S
0028+  45A7 DA A2 46        jp c,PRINT
0029+  45AA             
0030+  45AA                 ;Check for a FDD first. HWF_MOUNT_DISK makes the CH376 send mass storage
0031+  45AA                 ;(Bulk-Only) commands to the device, and some FDDs don't handle these well.
0032+  45AA             
0033+  45AA FD E5           push iy ;Buffer for the device name, USB_INIT_DEV modifies IY
0034+  45AC CD 79 46        call _VERBOSE_RESET_INIT_FDD
0035+  45AF FD E1           pop iy
0036+  45B1 44              ld b,h  ;B = USB error code (must be saved before HL is modified)
0037+  45B2 B7              or a
0038+  45B3 CA 65 46        jp z,_VERBOSE_RESET_FDD_OK
0039+  45B6 FE 04           cp 4
0040+  45B8 21 E0 47        ld hl,NODEV_S
0041+  45BB CA A2 46        jp z,PRINT
0042+  45BE             
0043+  45BE                 ;* Not a FDD, or error when initializing it: check if it's a storage device
0044+  45BE             
0045+  45BE C5              push bc ;B = USB error code
0046+  45BF F5              push af ;A = FDD init result
0047+  45C0 CD 44 40        call HW_RESET   ;Let the CH376 enumerate the device from scratch
0048+  45C3 FD E5           push iy
0049+  45C5 E1              pop hl
0050+  45C6 E5              push hl
0051+  45C7 CD 38 42        call HWF_MOUNT_DISK
0052+  45CA E1              pop hl
0053+  45CB 38 22           jr c,_VERBOSE_RESET_NO_STOR
0054+  45CD F1              pop af
0055+  45CE C1              pop bc
0056+  45CF             
0057+  45CF E5              push hl
0058+  45D0 21 F7 48        ld hl,STOR_FOUND_S
0059+  45D3 CD A2 46        call PRINT
0060+  45D6 E1              pop hl
0061+  45D7 06 00           ld b,0
0062+  45D9                 ;Print the device name, collapsing multiple spaces to a single one
0063+  45D9             _HW_RESET_PRINT:
0064+  45D9 7E              ld a,(hl)
0065+  45DA 23              inc hl
0066+  45DB B7              or a
0067+  45DC 28 0D           jr z,_HW_RESET_PRINT_END
0068+  45DE FE 20           cp ' '
0069+  45E0 20 03           jr nz,_HW_RESET_PRINT_GO
0070+  45E2 B8              cp b
0071+  45E3 28 F4           jr z,_HW_RESET_PRINT
0072+  45E5             _HW_RESET_PRINT_GO:
0073+  45E5 47              ld b,a
0074+  45E6 CD A2 00        call CHPUT
0075+  45E9 18 EE           jr _HW_RESET_PRINT
0076+  45EB             _HW_RESET_PRINT_END:
0077+  45EB CD E3 72        call DSK_INIT_WK_FOR_STORAGE_DEV
0078+  45EE C9              ret
0079+  45EF             
0080+  45EF                 ;* Neither a FDD nor a storage device: print the appropriate error
0081+  45EF             
0082+  45EF             _VERBOSE_RESET_NO_STOR:
0083+  45EF F1              pop af
0084+  45F0 C1              pop bc
0085+  45F1 3D              dec a
0086+  45F2 21 F8 47        ld hl,NO_CBI_DEV_S
0087+  45F5 CA A2 46        jp z,PRINT
0088+  45F8 3D              dec a
0089+  45F9 21 36 48        ld hl,RESERR_S
0090+  45FC C2 A2 46        jp nz,PRINT
0091+  45FF             
0092+  45FF C5              push bc
0093+  4600 21 75 48        ld hl,DEVERR_S
0094+  4603 CD A2 46        call PRINT
0095+  4606 3A 8D FD        ld a,(USB_INIT_STEP)
0096+  4609 C6 30           add "0"
0097+  460B CD A2 00        call CHPUT
0098+  460E F1              pop af  ;A = USB error code
0099+  460F 21 A6 48        ld hl,DEVERR_STEP_S
0100+  4612 CD 44 47        call PRINT_ERROR
0101+  4615             
0102+  4615                 ;Diagnostics: raw CH376 status of the failed operation, and for steps 4 and 5,
0103+  4615                 ;status of single packet GET_DESCRIPTOR requests at address 1 and at address 0
0104+  4615             
0105+  4615 21 AA 48        ld hl,DEVERR_STATUS_S
0106+  4618 CD A2 46        call PRINT
0107+  461B 3A 8F FD        ld a,(USB_INIT_LAST_STATUS)
0108+  461E CD AB 46        call PRINT_HEX
0109+  4621 21 B9 48        ld hl,DEVERR_NAKS_S
0110+  4624 CD A2 46        call PRINT
0111+  4627 3A 98 FD        ld a,(USB_INIT_NAK_COUNT+1)
0112+  462A CD AB 46        call PRINT_HEX
0113+  462D 3A 97 FD        ld a,(USB_INIT_NAK_COUNT)
0114+  4630 CD AB 46        call PRINT_HEX
0115+  4633 3A 8D FD        ld a,(USB_INIT_STEP)
0116+  4636 FE 04           cp 4
