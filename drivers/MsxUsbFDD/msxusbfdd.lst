1822+  453D             ;
1823+  453D             ; Write data to the CH data buffer
1824+  453D             ;
1825+  453D             ; Input:  HL = Source address of the data
1826+  453D             ;         B  = Length of the data
1827+  453D             ; Output: HL = HL + B
1828+  453D             
1829+  453D             CH_WRITE_DATA:
1830+  453D 3E 2C           ld a,CH_CMD_WR_HOST_DATA
1831+  453F D3 21           out (CH_COMMAND_PORT),a
