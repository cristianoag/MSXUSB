0257+  407E             ; -----------------------------------------------------------------------------
0258+  407E             ; HW_CONTROL_TRANSFER: Perform a USB control transfer on endpoint 0
0259+  407E             ;
0260+  407E             ; The size and direction of the transfer are taken from the contents
