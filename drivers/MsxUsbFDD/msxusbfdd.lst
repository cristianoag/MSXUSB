1353+  56F1             ; -----------------------------------------------------------------------------
1354+  56F1             ; USB_EXECUTE_CBI: Execute a command using CBI transport
1355+  56F1             ; -----------------------------------------------------------------------------
1356+  56F1             ; Input:  HL = Address of the 12 byte command to execute
1357+  56F1             ;         DE = Address of the input or output data buffer
1358+  56F1             ;         BC = Length of data to send or receive
1359+  56F1             ;         Cy = 0 to receive data, 1 to send data
1360+  56F1             ; Output: A  = USB error code
1361+  56F1             ;         BC = Amount of data actually transferred (if IN transfer)
1362+  56F1             ;         D  = ASC (if no error)
1363+  56F1             ;         E  = ASCQ (if no error)
1364+  56F1             
1365+  56F1             USB_EXECUTE_CBI_STACK_SPACE: equ 8+18
1366+  56F1             
1367+  56F1             USB_EXECUTE_CBI:
1368+  56F1 F5              push af
1369+  56F2 FD E1           pop iy
1370+  56F4 DD 21 E6 FF     ld ix,-USB_EXECUTE_CBI_STACK_SPACE
