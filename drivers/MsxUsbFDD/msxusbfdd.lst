0060   57CF                 include "bank1/diag_ep0.asm"
0001+  57CF             ; MSXUSB USB FDD BIOS
0002+  57CF             ; Based on the Rookie Drive USB FDD BIOS created by Konamiman in 2018
0003+  57CF             ; This version is adapted to work with the latest version of the MSXUSB project
0004+  57CF             ;
0005+  57CF             ; This file contains endpoint 0 transfer experiments, used to find out
0006+  57CF             ; why some devices (e.g. TEAC FD-05PUB, which has an endpoint 0 max packet size
0007+  57CF             ; of 8 bytes) don't deliver the second packet of a control transfer data stage.
0008+  57CF             ; They run when the device initialization fails when getting descriptors
0009+  57CF             ; (only if EP0_DIAGNOSTICS=1), and print one result line per experiment:
0010+  57CF             ;
0011+  57CF             ; DD: First 8 bytes of the device descriptor, at address 0
0012+  57CF             ; T0: GET_DESCRIPTOR(18): SETUP, IN DATA1, IN DATA0 (the normal sequence)
0013+  57CF             ; T1: Same, but expecting DATA1 again in the second IN
0014+  57CF             ; D5: Same as T0, with a 5ms delay before the second IN
0015+  57CF             ; BI: CH376 built-in GET_DESCR for the device descriptor (B2: configuration descriptor)
0016+  57CF             ; SC: SET_CONFIGURATION(1): SETUP, status IN
0017+  57CF             ; AD: CBI ADSC with a 12 byte TEST UNIT READY command:
0018+  57CF             ;     SETUP, OUT 8 bytes, OUT 4 bytes, status IN
0019+  57CF             ;
0020+  57CF             ; For each stage the raw CH376 status is printed, and for IN stages
0021+  57CF             ; also the number of bytes received ("status/count"). 14 means success,
0022+  57CF             ; 2A is NAK, 2E is STALL, 20 is timeout.
0023+  57CF             
0024+  57CF                 if EP0_DIAGNOSTICS = 1
0025+  57CF~            
0026+  57CF~            DIAG_EP0_BUF_SIZE: equ 72
0027+  57CF~            
0028+  57CF~            DIAG_EP0:
0029+  57CF~                ld ix,-DIAG_EP0_BUF_SIZE
0030+  57CF~                add ix,sp
0031+  57CF~                ld sp,ix
0032+  57CF~            
0033+  57CF~                ;--- Enumerate the device again until SET_ADDRESS,
0034+  57CF~                ;    it's the same sequence that USB_INIT_DEV follows
0035+  57CF~            
0036+  57CF~                call HW_BUS_RESET
0037+  57CF~                push ix
0038+  57CF~                push ix
0039+  57CF~                pop de
0040+  57CF~                ld hl,USB_CMD_GET_DEV_DESC_64
0041+  57CF~                xor a
0042+  57CF~                ld b,64
0043+  57CF~                call HW_CONTROL_TRANSFER
0044+  57CF~                pop ix
0045+  57CF~            
0046+  57CF~                ld hl,DG_DD_S
0047+  57CF~                call PRINT
0048+  57CF~                push ix
0049+  57CF~                pop hl
0050+  57CF~                ld b,8
0051+  57CF~            _DIAG_EP0_DD_LOOP:
0052+  57CF~                ld a,(hl)
0053+  57CF~                call PRINT_HEX
0054+  57CF~                ld a,' '
0055+  57CF~                call CHPUT
0056+  57CF~                inc hl
0057+  57CF~                djnz _DIAG_EP0_DD_LOOP
0058+  57CF~                ld hl,CRLF_S
0059+  57CF~                call PRINT
0060+  57CF~            
0061+  57CF~                call HW_BUS_RESET
0062+  57CF~                push ix
0063+  57CF~                ld hl,USB_CMD_SET_ADDRESS
0064+  57CF~                ld de,0
0065+  57CF~                xor a
0066+  57CF~                ld b,8
0067+  57CF~                call HW_CONTROL_TRANSFER
0068+  57CF~                pop ix
0069+  57CF~                ld bc,100
0070+  57CF~                call CH_DELAY
0071+  57CF~            
0072+  57CF~                ld a,3Fh    ;Don't retry NAKs (retries are done by software, max 300ms)
0073+  57CF~                call CH_SET_RETRY_VALUE
0074+  57CF~                ld a,USB_DEVICE_ADDRESS
0075+  57CF~                call CH_SET_TARGET_DEVICE_ADDRESS
0076+  57CF~            
0077+  57CF~                ;--- Get device descriptor experiments
0078+  57CF~            
0079+  57CF~                ld hl,DG_T0_S
0080+  57CF~                xor a
0081+  57CF~                ld c,0
0082+  57CF~                call _DG_GET18
0083+  57CF~            
0084+  57CF~                ld hl,DG_T1_S
0085+  57CF~                ld a,80h
0086+  57CF~                ld c,0
0087+  57CF~                call _DG_GET18
0088+  57CF~            
0089+  57CF~                ld hl,DG_D5_S
0090+  57CF~                xor a
0091+  57CF~                ld c,50
0092+  57CF~                call _DG_GET18
0093+  57CF~            
0094+  57CF~                ;--- CH376 built-in commands
0095+  57CF~            
0096+  57CF~                ld hl,DG_BI_S
0097+  57CF~                ld a,1
0098+  57CF~                call _DG_BUILTIN
0099+  57CF~                ld hl,DG_B2_S
0100+  57CF~                ld a,2
0101+  57CF~                call _DG_BUILTIN
0102+  57CF~                ld hl,CRLF_S
0103+  57CF~                call PRINT
0104+  57CF~            
0105+  57CF~                ;--- SET_CONFIGURATION, then a CBI command
0106+  57CF~            
0107+  57CF~                ld hl,DG_SC_S
0108+  57CF~                call PRINT
0109+  57CF~                ld hl,DG_CMD_SET_CONFIG
0110+  57CF~                call _DG_SETUP
0111+  57CF~                ld a,80h
0112+  57CF~                call _DG_IN
0113+  57CF~            
0114+  57CF~                ld hl,DG_AD_S
0115+  57CF~                call PRINT
0116+  57CF~                ld hl,DG_CMD_ADSC
0117+  57CF~                call _DG_SETUP
0118+  57CF~                ld a,40h
0119+  57CF~                ld b,8
0120+  57CF~                call _DG_OUT
0121+  57CF~                xor a
0122+  57CF~                ld b,4
0123+  57CF~                call _DG_OUT
0124+  57CF~                ld a,80h
0125+  57CF~                call _DG_IN
0126+  57CF~                ld hl,CRLF_S
0127+  57CF~                call PRINT
0128+  57CF~            
0129+  57CF~                ;--- Done, restore the NAK retry mode
0130+  57CF~            
0131+  57CF~                or a
0132+  57CF~                call HW_CONFIGURE_NAK_RETRY
0133+  57CF~            
0134+  57CF~                ld ix,DIAG_EP0_BUF_SIZE
0135+  57CF~                add ix,sp
0136+  57CF~                ld sp,ix
0137+  57CF~                ret
0138+  57CF~            
0139+  57CF~            
0140+  57CF~                ;--- GET_DESCRIPTOR(18) experiment
0141+  57CF~                ;    Input: HL = Label, A = toggle for the second IN, C = delay before the second IN
0142+  57CF~                ;           (in units of 0.1ms, 0 = no delay)
0143+  57CF~            
0144+  57CF~            _DG_GET18:
0145+  57CF~                push af
0146+  57CF~                push bc
0147+  57CF~                call PRINT
0148+  57CF~                ld hl,USB_CMD_GET_DEV_DESC_18
0149+  57CF~                call _DG_SETUP
0150+  57CF~                ld a,80h
0151+  57CF~                call _DG_IN
0152+  57CF~                pop bc
0153+  57CF~                ld a,c
0154+  57CF~                or a
0155+  57CF~                jr z,_DG_GET18_2
0156+  57CF~                ld b,0
0157+  57CF~                call CH_DELAY
0158+  57CF~            _DG_GET18_2:
0159+  57CF~                pop af
0160+  57CF~                call _DG_IN
0161+  57CF~                ld hl,CRLF_S
0162+  57CF~                jp PRINT
0163+  57CF~            
0164+  57CF~            
0165+  57CF~                ;--- Execute a SETUP transaction and print the status
0166+  57CF~                ;    Input: HL = Setup packet
0167+  57CF~            
0168+  57CF~            _DG_SETUP:
0169+  57CF~                ld b,8
0170+  57CF~                call CH_WRITE_DATA
0171+  57CF~                xor a
0172+  57CF~                ld e,0
0173+  57CF~                ld b,CH_PID_SETUP
0174+  57CF~                call CH_ISSUE_TOKEN
0175+  57CF~                call CH_WAIT_INT_AND_GET_RESULT
0176+  57CF~                jr _DG_PRINT_STATUS_SPACE
0177+  57CF~            
0178+  57CF~            
0179+  57CF~                ;--- Execute an IN transaction on endpoint 0, print "status/count"
0180+  57CF~                ;    Input: A = Toggle in bit 7
0181+  57CF~            
0182+  57CF~            _DG_IN:
0183+  57CF~                ld hl,300
0184+  57CF~                ld (CH_SW_NAK_LEFT),hl
0185+  57CF~                ld e,0
0186+  57CF~                call _CH_IN_TOKEN
0187+  57CF~                push af
0188+  57CF~                ld a,(CH_LAST_STATUS)
0189+  57CF~                call PRINT_HEX
0190+  57CF~                ld a,'/'
0191+  57CF~                call CHPUT
0192+  57CF~                pop af
0193+  57CF~                ld b,0
0194+  57CF~                or a
0195+  57CF~                jr nz,_DG_IN_2
0196+  57CF~                push ix
0197+  57CF~                pop hl
0198+  57CF~                call CH_READ_DATA
0199+  57CF~            _DG_IN_2:
0200+  57CF~                ld a,b
0201+  57CF~                call PRINT_HEX
0202+  57CF~                ld a,' '
0203+  57CF~                jp CHPUT
0204+  57CF~            
0205+  57CF~            
0206+  57CF~                ;--- Execute an OUT transaction on endpoint 0 with zeros as data, print the status
0207+  57CF~                ;    Input: A = Toggle in bit 6, B = Length
0208+  57CF~            
0209+  57CF~            _DG_OUT:
0210+  57CF~                ld hl,300
0211+  57CF~                ld (CH_SW_NAK_LEFT),hl
0212+  57CF~                ld hl,DG_ZEROS
0213+  57CF~                ld e,0
0214+  57CF~                call _CH_OUT_PACKET
0215+  57CF~            _DG_PRINT_STATUS_SPACE:
0216+  57CF~                ld a,(CH_LAST_STATUS)
0217+  57CF~                call PRINT_HEX
0218+  57CF~                ld a,' '
0219+  57CF~                jp CHPUT
0220+  57CF~            
0221+  57CF~            
0222+  57CF~                ;--- Execute a CH376 built-in GET_DESCR, print "status/count"
0223+  57CF~                ;    Input: HL = Label, A = Descriptor type
0224+  57CF~            
0225+  57CF~            _DG_BUILTIN:
0226+  57CF~                push af
0227+  57CF~                call PRINT
0228+  57CF~                ld a,0FFh   ;The CH376 handles NAKs by itself here
0229+  57CF~                call CH_SET_RETRY_VALUE
0230+  57CF~                pop bc
0231+  57CF~                ld a,CH_CMD_GET_DESCR
0232+  57CF~                out (CH_COMMAND_PORT),a
0233+  57CF~                ld a,b
0234+  57CF~                out (CH_DATA_PORT),a
0235+  57CF~                call CH_WAIT_INT_AND_GET_RESULT
0236+  57CF~                push af
0237+  57CF~                ld a,(CH_LAST_STATUS)
0238+  57CF~                call PRINT_HEX
0239+  57CF~                ld a,'/'
0240+  57CF~                call CHPUT
0241+  57CF~                pop af
0242+  57CF~                ld b,0
0243+  57CF~                or a
0244+  57CF~                jr nz,_DG_BUILTIN_2
0245+  57CF~                push ix
0246+  57CF~                pop hl
0247+  57CF~                call CH_READ_DATA
0248+  57CF~            _DG_BUILTIN_2:
0249+  57CF~                ld a,b
0250+  57CF~                call PRINT_HEX
0251+  57CF~                ld a,' '
0252+  57CF~                call CHPUT
0253+  57CF~                ld a,3Fh
0254+  57CF~                jp CH_SET_RETRY_VALUE
0255+  57CF~            
0256+  57CF~            
0257+  57CF~            DG_CMD_SET_CONFIG:
0258+  57CF~                db 0, 9, 1, 0, 0, 0, 0, 0
0259+  57CF~            
0260+  57CF~            DG_CMD_ADSC:
0261+  57CF~                db 21h, 0, 0, 0, 0, 0, 12, 0
0262+  57CF~            
0263+  57CF~            DG_ZEROS:
0264+  57CF~                db 0, 0, 0, 0, 0, 0, 0, 0
0265+  57CF~            
0266+  57CF~            DG_DD_S: db "DD:",0
0267+  57CF~            DG_T0_S: db "T0:",0
0268+  57CF~            DG_T1_S: db "T1:",0
0269+  57CF~            DG_D5_S: db "D5:",0
0270+  57CF~            DG_BI_S: db "BI:",0
0271+  57CF~            DG_B2_S: db "B2:",0
0272+  57CF~            DG_SC_S: db "SC:",0
0273+  57CF~            DG_AD_S: db " AD:",0
0274+  57CF~            
0275+  57CF                 endif
