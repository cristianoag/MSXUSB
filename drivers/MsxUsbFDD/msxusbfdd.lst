0419+  6DF2 D1              pop de
0420+  6DF3 13              inc de
0421+  6DF4 21 5A 6E        ld hl,DSK_CURDIR_S
0422+  6DF7 06 40           ld b,64
0423+  6DF9 CD 18 6D        call DSK_READ_MAIN_CONFIG_FILE
0424+  6DFC FD 70 00        ld (iy),b
0425+  6DFF             
0426+  6DFF                 ;If setting relative dir check length now
0427+  6DFF             
