0001+  4593             ; MSXUSB USB FDD BIOS
0002+  4593             ; Based on the Rookie Drive USB FDD BIOS created by Konamiman in 2018
0003+  4593             ; This version is adapted to work with the latest version of the MSXUSB project
0004+  4593             ;
0005+  4593             ; This routine resets the USB hardware, resets and initializes the device,
0006+  4593             ; and prints the device name or the appropriate error message.
0007+  4593             ; It is executed at boot time and by CALL USBRESET.
0008+  4593             
0009+  4593             VERBOSE_RESET:
0010+  4593 FD E5           push iy
0011+  4595 FD 21 DC FF     ld iy,-36
0012+  4599 FD 39           add iy,sp
0013+  459B FD F9           ld sp,iy
0014+  459D CD AB 45        call _VERBOSE_RESET
0015+  45A0 FD 21 24 00     ld iy,36
0016+  45A4 FD 39           add iy,sp
0017+  45A6 FD F9           ld sp,iy
0018+  45A8 FD E1           pop iy
0019+  45AA C9              ret
0020+  45AB             
0021+  45AB             _VERBOSE_RESET:
0022+  45AB AF              xor a
0023+  45AC CD 01 51        call WK_SET_STORAGE_DEV_FLAGS
0024+  45AF CD B2 50        call WK_SET_MISC_FLAGS
0025+  45B2             
0026+  45B2 CD 26 40        call HW_TEST
0027+  45B5 21 A6 47        ld hl,NOHARD_S
0028+  45B8 DA 87 46        jp c,PRINT
0029+  45BB             
0030+  45BB                 ;Check for a FDD first. HWF_MOUNT_DISK makes the CH376 send mass storage
0031+  45BB                 ;(Bulk-Only) commands to the device, and some FDDs don't handle these well.
0032+  45BB             
0033+  45BB FD E5           push iy ;Buffer for the device name, USB_INIT_DEV modifies IY
0034+  45BD CD 5E 46        call _VERBOSE_RESET_INIT_FDD
0035+  45C0 FD E1           pop iy
0036+  45C2 44              ld b,h  ;B = USB error code (must be saved before HL is modified)
0037+  45C3 B7              or a
0038+  45C4 CA 4A 46        jp z,_VERBOSE_RESET_FDD_OK
0039+  45C7 FE 04           cp 4
0040+  45C9 21 C5 47        ld hl,NODEV_S
0041+  45CC CA 87 46        jp z,PRINT
0042+  45CF             
0043+  45CF                 ;* Not a FDD, or error when initializing it: check if it's a storage device
0044+  45CF             
0045+  45CF C5              push bc ;B = USB error code
0046+  45D0 F5              push af ;A = FDD init result
0047+  45D1 CD 44 40        call HW_RESET   ;Let the CH376 enumerate the device from scratch
0048+  45D4 FD E5           push iy
0049+  45D6 E1              pop hl
0050+  45D7 E5              push hl
0051+  45D8 CD 49 42        call HWF_MOUNT_DISK
0052+  45DB E1              pop hl
0053+  45DC 38 22           jr c,_VERBOSE_RESET_NO_STOR
0054+  45DE F1              pop af
0055+  45DF C1              pop bc
0056+  45E0             
0057+  45E0 E5              push hl
0058+  45E1 21 C8 48        ld hl,STOR_FOUND_S
0059+  45E4 CD 87 46        call PRINT
0060+  45E7 E1              pop hl
0061+  45E8 06 00           ld b,0
