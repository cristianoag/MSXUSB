1243+  56F2             ; -----------------------------------------------------------------------------
1244+  56F2             ; USB_EXECUTE_CBI_WITH_RETRY: Execute a command using CBI transport with error retry
1245+  56F2             ;
1246+  56F2             ; Retried errors are those of type "device powered" or "not ready to
1247+  56F2             ; ready transition", plus optionally "media changed"
1248+  56F2             ; -----------------------------------------------------------------------------
1249+  56F2             ; Input:  Same as USB_EXECUTE_CBI, plus:
1250+  56F2             ;         A = 1 to retry "media changed" errors, 0 to no retry them
1251+  56F2             ; Output: Same as USB_EXECUTE_CBI
1252+  56F2             
1253+  56F2             USB_EXECUTE_CBI_WITH_RETRY:
1254+  56F2 CD 00 57        call _USB_EXECUTE_CBI_WITH_RETRY
