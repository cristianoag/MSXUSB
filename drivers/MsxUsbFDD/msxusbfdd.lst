0102+  4626                 ;Diagnostics: raw CH376 status of the failed operation, and NAKs retried.
0103+  4626                 ;If EP0_DIAGNOSTICS=1, for steps 4 and 5 also the status of single packet
0104+  4626                 ;GET_DESCRIPTOR requests at address 1 and at address 0, and the endpoint 0 experiments.
0105+  4626             
0106+  4626 21 8F 48        ld hl,DEVERR_STATUS_S
