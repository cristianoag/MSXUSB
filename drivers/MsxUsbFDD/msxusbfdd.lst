1256+  56F6 C0              ret nz  ;USB error will already have been logged by USB_PROCESS_ERROR
1257+  56F7 C5              push bc
1258+  56F8 D5              push de
1259+  56F9 CD 99 50        call WK_SET_ERROR
1260+  56FC D1              pop de
1261+  56FD C1              pop bc
1262+  56FE AF              xor a
1263+  56FF C9              ret
1264+  5700             
1265+  5700             _USB_EXECUTE_CBI_WITH_RETRY:
1266+  5700 E5              push hl
1267+  5701 D5              push de
1268+  5702 C5              push bc
1269+  5703 F5              push af
1270+  5704             
1271+  5704 CD 3F 57        call USB_EXECUTE_CBI
1272+  5707 B7              or a
1273+  5708 20 30           jr nz,_USB_ECBIR_POPALL_END_NZ   ;USB level error: do not retry
1274+  570A             
1275+  570A 7A              ld a,d
1276+  570B B7              or a    ;No error at all
1277+  570C 28 2C           jr z,_USB_ECBIR_POPALL_END_NZ
