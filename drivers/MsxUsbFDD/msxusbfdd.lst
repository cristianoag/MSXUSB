0469+  5161             
0470+  5161             _WK_GETWRK:
0471+  5161 CD 6A 51    	call _WK_GETSLTWRK			; get my SLTWRK entry
0472+  5164 2B              dec hl
0473+  5165 2B              dec hl
0474+  5166 E5          	push hl
0475+  5167 DD E1       	pop	ix
0476+  5169 C9          	ret
0477+  516A             
0478+  516A             ;	Subroutine	get my SLTWRK entry
0479+  516A             ;	Inputs		-
0480+  516A             ;	Outputs		HL = pointer to SLTWRK entry
0481+  516A             
0482+  516A             _WK_GETSLTWRK:
0483+  516A CD 84 51    	call _WK_GETEXPTBL			; get my primairy slot
0484+  516D 87          	add	a,a
0485+  516E 87          	add	a,a
0486+  516F 87          	add	a,a
0487+  5170 37          	scf
0488+  5171 8F          	adc	a,a			; primary slot*4 + 1
0489+  5172 4F          	ld c,a
0490+  5173 7E          	ld a,(hl)
0491+  5174 87          	add	a,a
0492+  5175 9F          	sbc	a,a
