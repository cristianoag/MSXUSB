0248+  5ABD 78              ld a,b
0249+  5ABE 06 08           ld b,8
0250+  5AC0             Div16_Loop1:
0251+  5AC0 17              rla
0252+  5AC1 ED 6A           adc hl,hl
0253+  5AC3 ED 52           sbc hl,de
0254+  5AC5 30 01           jr nc,Div16_NoAdd1
0255+  5AC7 19              add hl,de
0256+  5AC8             Div16_NoAdd1:
0257+  5AC8 10 F6           djnz Div16_Loop1
0258+  5ACA 17              rla
0259+  5ACB 2F              cpl
0260+  5ACC 47              ld b,a
0261+  5ACD 79              ld a,c
0262+  5ACE 48              ld c,b
0263+  5ACF 06 08           ld b,8
0264+  5AD1             Div16_Loop2:
0265+  5AD1 17              rla
0266+  5AD2 ED 6A           adc hl,hl
0267+  5AD4 ED 52           sbc hl,de
0268+  5AD6 30 01           jr nc,Div16_NoAdd2
0269+  5AD8 19              add hl,de
0270+  5AD9             Div16_NoAdd2:
0271+  5AD9 10 F6           djnz Div16_Loop2
0272+  5ADB 17              rla
0273+  5ADC 2F              cpl
0274+  5ADD 41              ld b,c
0275+  5ADE 4F              ld c,a
0276+  5ADF C9              ret
