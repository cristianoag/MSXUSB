1418+  444E             
1419+  444E             ; -----------------------------------------------------------------------------
1420+  444E             ; HW_GET_DEV_DESCR and HW_GET_CONFIG_DESCR
1421+  444E             ;
1422+  444E             ; Exectute the standard GET_DESCRIPTOR USB request
1423+  444E             ; to obtain the device descriptor or the configuration descriptor.
1424+  444E             ; -----------------------------------------------------------------------------
1425+  444E             ; Input:  DE = Address where the descriptor is to be read
1426+  444E             ;         A  = Device address
1427+  444E             ; Output: A  = USB error code
1428+  444E             
1429+  444E                 if HW_IMPL_GET_DEV_DESCR = 1
1430+  444E~                
1431+  444E~            HW_GET_DEV_DESCR:
1432+  444E~                ld b,1
1433+  444E~                jr CH_GET_DESCR
1434+  444E~            
1435+  444E                 endif
1436+  444E             
1437+  444E                 if HW_IMPL_GET_CONFIG_DESCR = 1
1438+  444E~            
1439+  444E~            HW_GET_CONFIG_DESCR:
1440+  444E~                ld b,2
1441+  444E~                jr CH_GET_DESCR
1442+  444E~            
1443+  444E                 endif
1444+  444E             
1445+  444E                 if HW_IMPL_GET_DEV_DESCR = 1 or HW_IMPL_GET_CONFIG_DESCR = 1
1446+  444E~            
1447+  444E~            CH_GET_DESCR:
1448+  444E~                push bc
1449+  444E~                call CH_SET_TARGET_DEVICE_ADDRESS
1450+  444E~                
1451+  444E~                ld a,CH_CMD_GET_DESCR
1452+  444E~                out (CH_COMMAND_PORT),a
1453+  444E~                pop af
1454+  444E~                out (CH_DATA_PORT),a
1455+  444E~            
1456+  444E~                push de
1457+  444E~                call CH_WAIT_INT_AND_GET_RESULT
1458+  444E~                pop hl
1459+  444E~                or a
1460+  444E~                ret nz
1461+  444E~            
1462+  444E~                call CH_READ_DATA
1463+  444E~                ld b,0
1464+  444E~                xor a
1465+  444E~                ret
1466+  444E~            
1467+  444E                 endif
1468+  444E             
1469+  444E             
1470+  444E             ; -----------------------------------------------------------------------------
1471+  444E             ; HW_SET_CONFIG
1472+  444E             ;
1473+  444E             ; Exectute the standard SET_CONFIGURATION USB request.
1474+  444E             ; -----------------------------------------------------------------------------
1475+  444E             ; Input: A = Device address
