1505+  444E~                xor a
1506+  444E~                call CH_SET_TARGET_DEVICE_ADDRESS
1507+  444E~                ld a,CH_CMD_SET_ADDRESS
1508+  444E~                out (CH_COMMAND_PORT),a
1509+  444E~                pop af
1510+  444E~                out (CH_DATA_PORT),a
1511+  444E~            
1512+  444E~                call CH_WAIT_INT_AND_GET_RESULT
1513+  444E~            
1514+  444E~                ;SET_ADDRESS recovery time: 2ms minimum, give it some more
1515+  444E~            
1516+  444E~                if USING_ARDUINO_BOARD = 0
1517+  444E~                push af
1518+  444E~                ld bc,100
1519+  444E~                call CH_DELAY
1520+  444E~                pop af
1521+  444E~                endif
1522+  444E~            
1523+  444E~                ret
1524+  444E~            
1525+  444E                 endif    
