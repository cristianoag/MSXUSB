0068+  45EF FE 20           cp ' '
0069+  45F1 20 03           jr nz,_HW_RESET_PRINT_GO
0070+  45F3 B8              cp b
0071+  45F4 28 F4           jr z,_HW_RESET_PRINT
0072+  45F6             _HW_RESET_PRINT_GO:
0073+  45F6 47              ld b,a
0074+  45F7 CD A2 00        call CHPUT
0075+  45FA 18 EE           jr _HW_RESET_PRINT
0076+  45FC             _HW_RESET_PRINT_END:
0077+  45FC CD D8 70        call DSK_INIT_WK_FOR_STORAGE_DEV
0078+  45FF C9              ret
