1295+  56BD B7              or a    ;No error at all
1296+  56BE 28 2C           jr z,_USB_ECBIR_POPALL_END_NZ
1297+  56C0             
1298+  56C0                 ;Report success if the error is one of the "recovered data" (17h or 18h)
1299+  56C0             
1300+  56C0 FE 17           cp 17h
1301+  56C2 28 27           jr z,_USB_ECBIR_POPALL_END
