1484+  57E0 C9              ret
1485+  57E1             
1486+  57E1             _USB_EXE_CBI_DATA_OUT:
1487+  57E1 CD 55 56        call USB_DATA_OUT_TRANSFER
1488+  57E4             
1489+  57E4 B7              or a
1490+  57E5 28 03           jr z,_USB_EXE_CBI_STEP_3
1491+  57E7 16 00           ld d,0
1492+  57E9 C9              ret
1493+  57EA             
1494+  57EA                 ;>>> STEP 3: Get status from INT endpoint
1495+  57EA             
1496+  57EA             _USB_EXE_CBI_STEP_3:
1497+  57EA C5              push bc ;We need to save the amount of data received
1498+  57EB C5              push bc ;Allocate 2 bytes on stack
