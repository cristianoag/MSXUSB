0454+  4041 3E 03       	ld	a,003H
0455+  4043 32 36 F3    	ld	(YF336),a		; saved input available
0456+  4046 32 37 F3    	ld	(YF337),a		; CTRL-C
0457+  4049 A7          	and	a			; flag NZ
0458+  404A C9          	ret
0459+  404B             
0460+  404B 3A 36 F3    A404B:	ld	a,(YF336)
